<span class="join-message-icon @IconClassNames">
    @if (Icon is not null)
    {
        <JoinIcon Icon="@Icon.Value" />
    }
</span>
@code {

    /// <summary>
    /// Message dialog type.
    /// </summary>
    [Parameter]
    public MessageDialogType Type { get; set; }

    private JoinIconType? Icon { get; set; }
    private string? IconClassNames { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        Icon = Type switch
        {
            MessageDialogType.None => null,
            MessageDialogType.Confirmation => JoinIconType.DialogQuestion,
            MessageDialogType.Information => JoinIconType.DialogInfo,
            MessageDialogType.Success => JoinIconType.DialogSuccess,
            MessageDialogType.Alert => JoinIconType.DialogAlert,
            MessageDialogType.Fail => JoinIconType.DialogFail,
            _ => throw new ArgumentOutOfRangeException(nameof(Type)),
        };

        IconClassNames = Type switch
        {
            MessageDialogType.None => null,
            MessageDialogType.Confirmation => "btn-info",
            MessageDialogType.Information => "btn-info",
            MessageDialogType.Success => "btn-success",
            MessageDialogType.Alert => "btn-warning",
            MessageDialogType.Fail => "btn-danger",
            _ => throw new ArgumentOutOfRangeException()
        };
    }
}
