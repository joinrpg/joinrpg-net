@using JoinRpg.Web.CharacterGroups.GroupEditMenu
@using JoinRpg.Web.ProjectCommon
@using JoinRpg.Common.WebComponents

@* Один узел дерева групп сетки ролей: заголовок группы, её собственные персонажи и
   рекурсивно — дочерние группы. Siblings — список детей родителя (включая этот узел),
   тот же список объектов, что хранится в GroupNode.Children родителя: JoinMoveControl
   переставляет соседей внутри groupSiblings (свежепроизведённого List<Header>), а
   OnGroupMoveCompleted переносит новый порядок обратно в Siblings — без похода на сервер
   за всей сеткой. *@

<div style="margin-left: @(Node.Header.Depth)em">
    @if (Node.Header.Depth > 0)
    {
        <span class="@HeaderClass(Node.Header.Depth)" title="@Node.Header.Path">
            <CharacterGroupLink Model="Node.Header.Group" />
        </span>
        <GroupEditMenu GroupId="Node.Header.Group.CharacterGroupId"
                       GroupType="Node.Header.GroupType"
                       HasMasterAccess="Model.HasMasterAccess"
                       ShowEditControls="Model.CanEditSettings" />
        @if (Model.CanEditSettings && !Node.Header.IsSpecial && GetGroupSiblings() is { Count: > 1 } groupSiblings)
        {
            <JoinMoveControl TItem="ProjectRoleGridGroupHeaderRowViewModel"
                             Items="groupSiblings"
                             Self="Node.Header"
                             SkipGroup="true"
                             Size="SizeStyleEnum.ExtraSmall"
                             OnMoveCompleted="() => ApplyGroupOrderAsync(groupSiblings)" />
        }
        @if (Node.Header.IsSpecial)
        {
            string title = "Эта группа автоматически заполняется в зависимости от полей персонажа." + Node.Header.BoundExpression;
            <JoinBadge Title="title">Спецгруппа</JoinBadge>
        }
        @if (!Node.Header.FirstCopy)
        {
            <span>см. выше</span>
        }
    }
    @if (Node.Header.Description is { } description)
    {
        <div>@description</div>
    }
</div>
@if (Node.Children.OfType<CharBlockNode>().FirstOrDefault() is { } charBlockNode)
{
    var charBlock = charBlockNode.Characters;
    <div style="margin-left: @(Node.Header.Depth)em">
        <ul>
            @foreach (var charRow in charBlock)
            {
                <li>
                    <CharacterLinkWithEdit Model="charRow.Character" />
                    @if (charRow.Character.CanEdit && charBlock.Count > 1)
                    {
                        <JoinMoveControl TItem="ProjectRoleGridCharacterRowViewModel"
                                         Items="charBlock"
                                         Self="charRow"
                                         SkipGroup="true"
                                         Size="SizeStyleEnum.ExtraSmall"
                                         OnMoveCompleted="StateHasChanged" />
                    }
                    <text> </text>
                    <ProjectRoleGridPlayerCell Row="charRow" />
                    @if (charRow.Groups is { } groups && groups.Groups.Count > 0)
                    {
                        <div>
                            Группы:
                            @for (var i = 0; i < groups.Groups.Count; i++)
                            {
                                if (i > 0)
                                {
                                    <text>, </text>
                                }
                                <CharacterGroupLink Model="groups.Groups[i]" />
                            }
                        </div>
                    }
                    @if (!charRow.FirstCopy)
                    {
                        @if (Model.FieldColumnNames.Count > 0)
                        {
                            <div>(см. выше)</div>
                        }
                    }
                    else
                    {
                        @for (var i = 0; i < charRow.FieldValues.Count; i++)
                        {
                            @if (!string.IsNullOrWhiteSpace(charRow.FieldValuesHtml[i]))
                            {
                                @if (Model.SuppressFieldLabels)
                                {
                                    <div>@charRow.FieldValues[i]</div>
                                }
                                else
                                {
                                    <div><strong>@Model.FieldColumnNames[i]</strong>: @charRow.FieldValues[i]</div>
                                }
                            }
                        }
                    }
                </li>
            }
        </ul>
    </div>
}
@foreach (var child in Node.Children.OfType<GroupNode>())
{
    <ProjectRoleGridTreeNode Node="child" Siblings="Node.Children" Model="Model" OnSiblingsChanged="StateHasChanged" />
}

@code {
    [Parameter, EditorRequired] public GroupNode Node { get; set; } = null!;

    // Список детей РОДИТЕЛЯ (включает этот узел) — реальные соседи для JoinMoveControl.
    [Parameter, EditorRequired] public List<RenderNode> Siblings { get; set; } = null!;

    [Parameter, EditorRequired] public ProjectRoleGridViewModel Model { get; set; } = null!;

    // Siblings принадлежит родительскому узлу (это его Node.Children) — после мутации
    // перерисовать нужно родителя (это его @foreach определяет видимый порядок), а не себя.
    [Parameter] public EventCallback OnSiblingsChanged { get; set; }

    // Заголовки уровней как в классической сетке ролей: 1 → h2, 2 → h3, глубже → h4.
    private static string HeaderClass(int depth) => depth switch
    {
        1 => "h2",
        2 => "h3",
        _ => "h4",
    };

    // Спецгруппы (заполняются автоматически по значению поля) двигать друг относительно
    // друга или относительно обычных групп нельзя — сервер всегда сортирует их последними
    // среди сиблингов, поэтому они не участвуют в переупорядочивании.
    private List<ProjectRoleGridGroupHeaderRowViewModel> GetGroupSiblings() =>
        Siblings.OfType<GroupNode>().Where(n => !n.Header.IsSpecial).Select(n => n.Header).ToList();

    private async Task ApplyGroupOrderAsync(List<ProjectRoleGridGroupHeaderRowViewModel> newGroupOrder)
    {
        var byHeader = Siblings.OfType<GroupNode>().Where(n => !n.Header.IsSpecial).ToDictionary(n => n.Header);
        var nonGroupNodes = Siblings.Where(n => n is not GroupNode).ToList();
        var specialGroupNodes = Siblings.OfType<GroupNode>().Where(n => n.Header.IsSpecial).ToList();

        Siblings.Clear();
        Siblings.AddRange(nonGroupNodes);
        Siblings.AddRange(newGroupOrder.Select(h => byHeader[h]));
        Siblings.AddRange(specialGroupNodes);

        if (OnSiblingsChanged.HasDelegate)
        {
            await OnSiblingsChanged.InvokeAsync();
        }
    }
}
