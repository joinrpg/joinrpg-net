@using JoinRpg.Web.ProjectCommon
@using JoinRpg.Web.ProjectCommon.Characters

@* Содержимое ячейки «Игрок»: статус/ссылка на игрока, счётчик активных заявок,
   контакты и кнопка «Заявиться». Общее для табличного и древовидного режимов. *@

@if (Player.ApplyStatus.BusyStatus == CharacterBusyStatusView.Npc)
{
    <text>NPC</text>
}
else if (Player.ApplyStatus.IsSlot)
{
    <text>шаблон</text>
    @if (Row.ActiveClaimsCount > 0)
    {
        <text> (@ClaimsCountText)</text>
    }
}
else if (Player.Link is { } link)
{
    <UserLink Model="link" />
}
else if (Row.ActiveClaimsCount > 0)
{
    <text>@ClaimsCountText</text>
}
else if (Player.ApplyStatus.BusyStatus is not (CharacterBusyStatusView.Vacancy or CharacterBusyStatusView.HotVacancy))
{
    @* Сейчас недостижимо: BusyStatus здесь всегда Vacancy/HotVacancy — нет заявок и нет игрока
       не даёт других значений. Статус проекта в него сознательно не заложен: BusyStatus
       описывает состояние персонажа, а «заявиться нельзя» живёт в ApplyStatus.IsAvailable,
       который считают доменные правила (ClaimValidator.IsAvailableForPlayer). *@
    <text>нет&nbsp;игрока</text>
}
@if (Player.Contacts is not null)
{
    <text> (</text><UserContactsView Contacts="Player.Contacts" /><text>)</text>
}
@Space
<ApplyForCharacterButton Model="Player.ApplyStatus" />

@code {
    [Parameter, EditorRequired] public ProjectRoleGridCharacterRowViewModel Row { get; set; } = null!;
    [Parameter, EditorRequired] public PlayerCellViewModel Player { get; set; } = null!;

    // Статическую разметку из одних пробелов (включая <text> </text>) Blazor вырезает.
    private const string Space = " ";

    private string ClaimsCountText => CountHelper.DisplayCount(Row.ActiveClaimsCount, "заявка", "заявки", "заявок");
}
