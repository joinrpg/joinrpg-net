@*
    Оверлей деталей мероприятия в полноэкранном режиме расписания. Рендерит его сама сетка
    (Scheduler с FullScreen), потому что оверлей накрывает именно её.

    Разметка статична: содержимое по id подставляет JS из data-атрибутов карточки
    (см. appointmentClickHandler в FullScreen.cshtml), он же навешивает классы
    details-no-* и атрибуты all-rooms/no-users/error-mode на #scheduler-details, чтобы спрятать
    пустые секции. Поэтому id здесь — контракт со скриптом, а не деталь разметки.
*@
<div id="scheduler-overlay" onclick="overlayClickHandler(event)" onwheel="overlayWheelHandler(event)">
    <div id="scheduler-details" all-rooms="false" no-users="false" error-mode="false">
        <div class="appointment-details-interior">

            <div class="appointment-details-header">
                <h4 id="details-title"></h4>
                <button class="btn btn-link" onclick="closeDetailsClickHandler()"><JoinIcon Icon="JoinIconType.Remove" /></button>
            </div>

            <div class="appointment-details-content">
                <div class="appointment-details appointment-details-errors">
                    <h4>Проблемы</h4>
                    <div id="details-problems"></div>
                </div>

                <div class="appointment-details appointment-details-users">
                    <h4>Мастера</h4>
                    <div id="details-users"></div>
                </div>

                <div class="appointment-details appointment-details-rooms">
                    <h4>Комнаты</h4>
                    <div id="details-rooms"></div>
                </div>

                <div class="appointment-details appointment-details-slots">
                    <h4>Слоты времени</h4>
                    <div id="details-slots"></div>
                </div>

                <div class="appointment-details appointment-details-info">
                    <h4>Описание</h4>
                    <div id="details-info"></div>
                </div>
            </div>

            <div class="appointment-details-footer">
                <a id="details-link" class="btn btn-link" href="#" target="_blank">Открыть на сайте&hellip;</a>
            </div>
        </div>
    </div>
</div>
