@using Microsoft.AspNetCore.Components.Web
@using JoinRpg.Common.WebComponents
@using JoinRpg.DomainTypes
@using JoinRpg.Helpers
@using JoinRpg.Web.ProjectCommon
@using JoinRpg.Web.Schedule

@*
    По умолчанию Blazor вырезает текстовые узлы из одних пробелов, стоящие рядом с
    блоками кода, — в cshtml такого не было. Из-за этого в разметке расписания склеивались
    название мероприятия со ссылкой «(ред.)», подпись «Комнаты:» со списком комнат и имена
    ведущих друг с другом (последнее видно в оверлее деталей: там innerHTML копируется
    в обычный div, а не во flex-контейнер). Сохраняем пробелы, чтобы вывод совпадал
    с прежним; результат зафиксирован в AppointmentWhitespaceTest.
*@
@preservewhitespace true
