@inject ICharacterUriLocator characterUriLocator
@*
    Карточка мероприятия в сетке расписания. Data-атрибуты (display-name, rooms, slots,
    no-users, all-rooms, error-mode, errors, details-url) читает JS полноэкранного режима,
    чтобы заполнить оверлей деталей, — их состав и формат значений менять нельзя.
*@
<div id="appointment@(Model.CharacterId.CharacterId)"
     class="@ClassNames"
     display-name="@Model.DisplayName"
     details-url="@characterUriLocator.GetDetailsUri(Model.CharacterId)"
     no-users="@HasNoUsers.ToString()"
     rooms="@Rooms"
     slots="@Slots"
     all-rooms="@Model.AllRooms.ToString()"
     error-mode="@((Model.ErrorType == AppointmentErrorType.Intersection).ToString())"
     errors="@Errors">
    <div class="appointment-interior" title="@Title">
        <div class="appointment-header">
            <a href="@characterUriLocator.GetDetailsUri(Model.CharacterId)" target="@Target">@Model.DisplayName</a>
            @if (Model.HasMasterAccess)
            {
                @* Пробел задан выражением, а не разметкой: Blazor, в отличие от cshtml,
                   вырезает текстовые узлы из одних пробелов — и <text> </text> тоже. *@
                @Space<a href="@characterUriLocator.GetEditUri(Model.CharacterId)">(ред.)</a>
            }
        </div>

        @if (Model.ErrorType == AppointmentErrorType.NotLocated)
        {
            <div class="appointment-rooms">
                <b>Комнаты: </b>
                @if (Model.Rooms.Count > 0)
                {
                    @(Model.AllRooms ? "все" : Rooms)
                }
                else
                {
                    <b class="text-danger">нет</b>
                }
            </div>
            <div class="appointment-slots">
                <b>Слоты: </b>
                @if (Model.Slots.Count > 0)
                {
                    @Slots
                }
                else
                {
                    <b class="text-danger">нет</b>
                }
            </div>
        }
        <div id="appointment@(Model.CharacterId.CharacterId)-users" class="appointment-users">
            @foreach (var user in Model.Users)
            {
                @* Разделитель между именами: в самой карточке .appointment-users — flex,
                   и склейки не видно, но JS копирует этот innerHTML в #details-users,
                   а там обычный div. *@
                <UserLink Model="user" />@Space
            }
        </div>
    </div>
    <div class="appointment-click-overlay" onclick="appointmentClickHandler(@Model.CharacterId.CharacterId)"></div>
    <div id="appointment@(Model.CharacterId.CharacterId)-description" style="display: none;">@Model.Description</div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public AppointmentViewModel Model { get; set; } = null!;

    /// <summary>
    /// Пробел-разделитель. Статическую разметку из одних пробелов Blazor вырезает
    /// (в отличие от cshtml), а вывод выражения — нет.
    /// </summary>
    private const string Space = " ";

    private bool HasNoUsers => Model.Users.Count == 0;

    private bool IsIntersection => Model.ErrorType == AppointmentErrorType.Intersection;

    private string Title => IsIntersection
        ? Model.DisplayName + " (имеются пересечения)"
        : Model.DisplayName;

    /// <summary>
    /// Ошибки размещения ведут на страницу персонажа в новой вкладке: с ними работают,
    /// не теряя из вида саму сетку.
    /// </summary>
    private string Target => Model.ErrorType.HasValue ? "_blank" : "_self";

    private string Rooms => string.Join(", ", Model.Rooms.Select(r => r.Name));

    private string Slots => string.Join(", ", Model.Slots.Select(s => s.Name));

    private string Errors => Model.ErrorType?.GetDisplayName() ?? "";

    private string ClassNames
    {
        get
        {
            var classNames = "scheduler-appointment";
            if (IsIntersection)
            {
                classNames += " appointment-intersection";
            }
            if (Model.AllRooms)
            {
                classNames += " appointment-all-rooms";
            }
            classNames += HasNoUsers ? " appointment-no-users" : " appointment-has-users";
            return classNames;
        }
    }
}
