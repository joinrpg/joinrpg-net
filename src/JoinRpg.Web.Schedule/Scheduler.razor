@*
    Сетка расписания: шапка с комнатами, левая колонка с тайм-слотами и поле карточек.

    Всё это — ячейки одного CSS grid внутри одного блока прокрутки. Шапка и левая колонка
    прилипают к краям (position: sticky), поэтому при прокрутке поля остаются на месте сами,
    без скрипта. Линии сетки рисует фон подложки, а не пустые ячейки таблицы.
*@
<div id="scheduler" class="scheduler @(FullScreen ? "scheduler-fullscreen" : "scheduler-embedded")">

    <div class="scheduler-scrollable" style="@GridStyle">
        <div class="scheduler-left-top"></div>

        @foreach (var (col, index) in Model.Columns.Select((col, index) => (col, index)))
        {
            <div id="project-room@(col.Id.ProjectFieldVariantId)" class="scheduler-header-column" style="grid-column: @(index + 2)" title="@col.Description.Value" data-toggle="tooltip" data-placement="bottom">@col.Name</div>
        }

        @for (var index = 0; index < Model.Rows.Count; index++)
        {
            var row = Model.Rows[index];
            <div id="project-slot@(row.Id.ProjectFieldVariantId)" class="scheduler-header-row" style="grid-row: @(index + 2)" title="@row.Description.Value" data-toggle="tooltip" data-placement="right">@row.Name</div>
        }

        <div class="scheduler-grid"></div>

        @foreach (var appointment in Model.Appointments)
        {
            <div class="scheduler-cell" style="@Placement(appointment)">
                <Appointment Model="appointment" />
            </div>
        }
    </div>

    @if (FullScreen)
    {
        <AppointmentDetails />
    }
</div>

<script type="text/javascript">
    let appointmentClickHandler = () => {};
    $(document).ready(function(){
        $('[data-toggle="tooltip"]').tooltip({
            html: true,
            container: 'body'
        });
    });
</script>

@code {
    [Parameter]
    [EditorRequired]
    public SchedulePageViewModel Model { get; set; } = null!;

    /// <summary>
    /// Полноэкранный режим: сетка занимает всю вкладку, а клик по карточке открывает оверлей
    /// деталей. На обычной странице сетка фиксированной высоты, и деталей нет.
    /// </summary>
    [Parameter]
    public bool FullScreen { get; set; }

    /// <summary>
    /// Размеры колонок и строк живут в Scheduler.razor.css, отсюда приходит только их число.
    /// </summary>
    private string GridStyle => $"--scheduler-columns: {Model.Columns.Count}; --scheduler-rows: {Model.Rows.Count}";

    /// <summary>
    /// Первая строка и первая колонка сетки заняты шапкой, поэтому сдвиг на 2, а не на 1.
    /// </summary>
    private static string Placement(AppointmentViewModel appointment)
        => $"grid-column: {appointment.RoomIndex + 2} / span {appointment.RoomCount}; grid-row: {appointment.TimeSlotIndex + 2} / span {appointment.TimeSlotsCount}";
}
