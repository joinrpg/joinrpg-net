@using JoinRpg.Markdown
@using JoinRpg.Web.Accommodation
@using JoinRpg.Web.Models.Accommodation
@model ClaimAccommodationViewModel

<div class="panel panel-default" id="accommodationRequests">
    <div class="panel-heading">
        <h5>Проживание</h5>
    </div>
    <div class="panel-body">
        @if (Model.AccommodationType == null)
        {
            <div style="display: flex; flex-direction: row; align-items: center;">
                <span style="margin-right: 1em;">Проживание не выбрано.</span>
                <component type="typeof(AccommodationTypeSelector)"
                           render-mode="WebAssemblyPrerendered"
                           param-ClaimId="Model.ClaimIdentification" />
            </div>
        }
        else
        {
          <div style="display: flex; flex-direction: row; align-items: center;">
            <span style="margin-right: 1em;">
              <strong>@Model.AccommodationType.Name</strong>
              <text>
                        (@CountHelper.DisplayCount(Model.AccommodationType.Capacity, "место",
                   "места", "мест") в номере, @Model.AccommodationType.Cost &#8381;)
              </text>
            </span>
            <component type="typeof(AccommodationTypeSelector)"
                       render-mode="WebAssemblyPrerendered"
                       param-ClaimId="Model.ClaimIdentification" />
          </div>
            <div class="help-block">
                @Html.Raw(Model.AccommodationType.Description.ToHtmlString())
            </div>
            if (Model.RoomName != null)
            {
                <div>
                    <strong>Назначена комната:</strong> @Model.RoomName
                </div>
            }

          <div style="margin-top: 1em;">
            @if (Model.RoomFreeSpace > 0 || Model.Neighbours.Any())
            {
                  <div><strong>Соседи по комнате
                    @if (Model.RoomFreeSpace == 0)
                    {
                      <text> (полностью заполнена)</text>
                    }:
                  </strong></div>
              <div style="display: flex; flex-direction: row; align-items: center">
                <ul style="margin-bottom: 0;">
                  @foreach (var neighbor in Model.Neighbours)
                  {
                    <li>@Html.DisplayFor(model => neighbor)</li>
                  }
                  @if (Model.RoomFreeSpace > 0)
                  {
                    <li>@CountHelper.DisplayCount(Model.RoomFreeSpace, " свободное место", "свободных места", "свободных мест")</li>
                  }
                </ul>

                @if (Model.Neighbours.Count > 0)
                {
                  <form method="post" asp-controller="Claim" asp-action="LeaveGroup" asp-route-projectId="@Model.ProjectId" asp-route-claimId="@Model.ClaimId" style="margin-left: 2em; padding-left: 2em; border-left: 1px solid silver;">
                    <button type="submit" class="btn btn-sm btn-warning">Отселиться от соседей</button>
                      @if (Model.RoomName != null)
                      {
                        <span style="margin-left: 1em;">Вы будете выселены из комнаты @(Model.RoomName).</span>
                      }
                  </form>
                }
              </div>
            }

            <component type="typeof(AccommodationInviteControl)"
                       render-mode="WebAssemblyPrerendered"
                       param-ClaimId="Model.ClaimIdentification" />
          </div>
        }
    </div>
</div>
<component type="typeof(ClaimAccommodationInvites)"
           render-mode="WebAssemblyPrerendered"
           param-ClaimId="Model.ClaimIdentification"
           param-Direction="InviteDirection.Incoming" />
<component type="typeof(ClaimAccommodationInvites)"
           render-mode="WebAssemblyPrerendered"
           param-ClaimId="Model.ClaimIdentification"
           param-Direction="InviteDirection.Outgoing" />
