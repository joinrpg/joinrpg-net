@model JoinRpg.Domain.ClaimCheckInValidator
@using JoinRpg.Web.CheckIn

@if (Model.CanCheckInNow)
{
<div class="alert alert-success">
  Регистрация на полигоне пройдет максимально быстро — все данные заполнены и взнос сдан.
</div>
}
else if (Model.CanCheckInInPrinciple)
{
<div class="alert alert-success">
  Заявка готова к регистрации, все данные заполнены. Просим вас сдать взнос заранее, чтобы ускорить прохождение регистрации.
</div>
} else if (Model.IsApproved)
{
  <div class="alert alert-warning">
    Не хватает данных для регистрации. <b>Регистрация на полигоне в ручном режиме и только после игроков с заполненными заявками.</b>
    @if (Model.Problems.Any(p => p.PlayerCanFix))
    {
      <br/>
      <text> Заполните сами (поля заявки — на этой странице, данные профиля — в своём профиле):</text>
      <ul>
        @foreach (var problem in Model.Problems.Where(p => p.PlayerCanFix))
        {
          <li>@(new CheckInProblemViewModel(problem).Title)</li>
        }
      </ul>
    }
    @if (Model.Problems.Any(p => !p.PlayerCanFix))
    {
      <br/>
      <text> Не заполнены скрытые мастерские поля. Обратитесь к ответственному мастеру за дозаполнением заявки. </text>
    }
  </div>
}
else
{
  <div class="alert alert-danger">
    Ваша заявка не принята мастерами, вы не можете пройти регистрацию на игре.
  </div>
}
