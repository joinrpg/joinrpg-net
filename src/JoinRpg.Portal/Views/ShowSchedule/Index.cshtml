@using JoinRpg.Web.Schedule
@model SchedulePageViewModel

@{
    ViewBag.Title = "Расписание";
}

@(await Html.RenderComponentAsync<ScheduleHeader>(RenderMode.Static, new { Model.ProjectId }))

<section>
    @(await Html.RenderComponentAsync<Scheduler>(RenderMode.Static, new { Model }))
</section>

@if (Model.Intersections.Count > 0)
{
    <h3>Мероприятия, пересекающиеся друг с другом</h3>
    <section>
        @(await Html.RenderComponentAsync<Intersections>(RenderMode.Static, new { Model }))
    </section>
}
@if (Model.NotAllocated.Count > 0)
{
    <h3>Мероприятия, не размещенные в сетке</h3>
    <section>
        @(await Html.RenderComponentAsync<NotAllocated>(RenderMode.Static, new { Model }))
    </section>
}
