@using JoinRpg.Web.Schedule
@{
    // Layout используется только из FullScreen.cshtml, он и кладёт модель в ViewData.
    var schedule = ViewData["Schedule"] as SchedulePageViewModel
        ?? throw new InvalidOperationException("Layout расписания ждёт SchedulePageViewModel в ViewData[\"Schedule\"]");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/twitter-bootstrap/css/bootstrap.css" />
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/3.4.0/css/bootstrap.min.css"
              asp-fallback-href="~/lib/twitter-bootstrap/css/bootstrap.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>

    <link rel="stylesheet" href="~/_content/JoinRpg.Common.WebComponents/css/roboto.css" />

    <link rel="stylesheet" href="~/_content/JoinRpg.Common.WebComponents/css/join-icons.css" />
    @* Scoped CSS razor-библиотек — см. комментарий в Views/Shared/_Layout.cshtml. *@
    <link rel="stylesheet" href="~/JoinRpg.Portal.styles.css" />
    <link rel="stylesheet" href="~/css/FullScreen.css" />
    @RenderSection("styles", required: false)

</head>
<body>
    <nav>
        @(await Html.RenderComponentAsync<FullScreenHeader>(RenderMode.Static, new { schedule.ProjectId }))
    </nav>
    <article>
        @RenderBody()
    </article>
    <footer>
        @(await Html.RenderComponentAsync<FullScreenFooter>(RenderMode.Static))
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/jquery.js"></script>
        <script src="~/lib/twitter-bootstrap/js/bootstrap.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/jquery.min.js"></script>
        <script src="~/lib/twitter-bootstrap/js/bootstrap.min.js"></script>
    </environment>

    @RenderSection("Scripts", required: false)

    @await Html.PartialAsync("Layout/_WebComponentsScriptPartial")
    @await Html.PartialAsync("Layout/_YandexPartial")
</body>
</html>
