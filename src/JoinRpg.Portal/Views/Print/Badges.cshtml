@using JoinRpg.Common.WebComponents.Badges
@using JoinRpg.DomainTypes.ProjectMetadata.Badges
@using JoinRpg.Web.ProjectMasterTools.Print
@model BadgesPrintViewModel

@{
    Layout = null;
    // Бейджи раскладываются по листам здесь, а не браузером: отступ от края нужен на каждом листе,
    // а поля страницы нулевые (иначе браузер печатает в них колонтитулы).
    // Ряды — тоже здесь: при ширине ряда ровно 190 мм перенос flex из-за дробных пикселей мог бы унести
    // последний бейдж в лишний ряд, и лист перелез бы на следующую страницу.
    var perRow = BadgeLayoutRules.BadgesPerRow(Model.WidthMm);
    var rowsPerSheet = BadgeLayoutRules.RowsPerSheet(Model.HeightMm);
    var sheets = Model.Badges.Chunk(perRow).Chunk(rowsPerSheet).ToList();
}

<!DOCTYPE html>

<html moznomarginboxes mozdisallowselectionprint>
<head>
    <title>Бейджи: @Model.TemplateName</title>
    <link rel="stylesheet" href="~/_content/JoinRpg.Common.WebComponents/css/roboto.css" />
    @* Бандл scoped CSS: без него у строк бейджа нет позиционирования, и подгонка шрифта меряет не то *@
    <link rel="stylesheet" href="~/JoinRpg.Portal.styles.css" />
    @* Подгонка шрифта строк — только на этой странице, в общий скрипт компонентов она не входит *@
    <script src="~/_content/JoinRpg.Common.WebComponents/printable-badge.js" type="module"></script>
    <style>
        /* Нулевые поля: браузеру негде печатать колонтитулы (дату, адрес, номер страницы) */
        @@page {
            size: A4;
            margin: 0;
        }

        body {
            margin: 0;
            font-family: Roboto, Arial, sans-serif;
        }

        /* Лист A4: отступ от края даёт он сам (BadgeLayoutRules.SheetMarginMm), каждый — с новой страницы.
           Снизу отступа нет: следующий лист и так с новой страницы, а лист ровно в 297 мм из-за дробных
           пикселей мог бы перелезть на долю пикселя и оставить пустую страницу. */
        .badges-sheet {
            box-sizing: border-box;
            width: @(BadgeLayoutRules.SheetWidthMm)mm;
            padding: @(BadgeLayoutRules.SheetMarginMm)mm @(BadgeLayoutRules.SheetMarginMm)mm 0;
            break-after: page;
        }

        .badges-row {
            display: flex;
            flex-wrap: nowrap;
        }

        .badges-sheet:last-child {
            break-after: auto;
        }

        /* Бейдж не сжимается под ширину листа — печатается своим размером */
        .badges-row > * {
            flex: none;
        }

        /* Пунктир по границе бейджа — линия разреза. Псевдоэлементом поверх содержимого: outline самого
           бейджа закрывала фоновая картинка. Каждый бейдж рисует половину толщины внутри себя, так что
           у соседних бейджей половинки складываются в одну линию. */
        .badges-row > *::after {
            content: "";
            position: absolute;
            inset: 0;
            border: 0.2mm dashed #000;
            pointer-events: none;
        }

        .badges-warnings {
            margin: 1em;
            padding: 0.5em 1em;
            border: 1px solid #e0b252;
            background-color: #fcf8e3;
        }

        @@media print {
            .badges-warnings {
                display: none;
            }
        }
    </style>
</head>

<body>
    @if (Model.Warnings.Count > 0)
    {
        <div class="badges-warnings">
            <b>Проверьте шаблон «@Model.TemplateName»</b> (это предупреждение не печатается):
            <ul>
                @foreach (var warning in Model.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }

    @foreach (var sheet in sheets)
    {
        <div class="badges-sheet">
            @foreach (var row in sheet)
            {
                <div class="badges-row">
                    @foreach (var lines in row)
                    {
                        <component type="typeof(PrintableBadge)"
                                   render-mode="Static"
                                   param-WidthMm="@Model.WidthMm"
                                   param-HeightMm="@Model.HeightMm"
                                   param-BackgroundUrl="@Model.BackgroundUrl?.AbsoluteUri"
                                   param-Lines="@lines" />
                    }
                </div>
            }
        </div>
    }
</body>
</html>
