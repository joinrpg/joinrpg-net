@using JoinRpg.Web.Plots
@model JoinRpg.Web.Models.Plot.PlotElementListItemViewModel

@{
    ViewBag.Title = "Сюжет «" + Model.PlotFolderMasterTitle + "» — история";
}

@if (!Model.PrintMode){

  <h2>@ViewBag.Title</h2>

  @Html.ActionLink("Назад к сюжету", "Edit", new {Model.ProjectId, Model.PlotFolderId}, null)
}
@if (!Model.HasMasterAccess && Model.Status != PlotStatus.Completed)
{
    return;
}
@if (Model.PrintMode)
{
    @Model.Content
    @if (Model.Content.IsNullOrWhiteSpace())
    {
        <i>Вводная пуста</i>
    }
}
else
{
    <component type="typeof(JoinRpg.Web.Plots.Elements.PlotElementPanel)"
               render-mode="Static"
               param-Model="@Model.ToPanel()"
               param-Open="true" />
}
