@using JoinRpg.WebPortal.Models.Masters
@using JoinRpg.Web.ProjectMasterTools.Acl
@model AclViewModel

@{
    ViewBag.Title = "Добавление мастера в проект " + Model.ProjectName;
}

<h2>@ViewBag.Title</h2>

<partial name="_UserDetailsPanel" model="@Model.UserDetails" />
<hr class="col-md-12" />
@* Карточка пользователя и линия — плавающие колонки: без clearfix панели острова обтекают карточку. *@
<div class="clearfix"></div>

<component type="typeof(AddMasterPanel)" render-mode="WebAssembly"
           param-ProjectId="@(new ProjectIdentification(Model.ProjectId))"
           param-UserId="@(new UserIdentification(Model.UserId))"
           param-MastersUrl="@Url.Action("Index", new { Model.ProjectId })"
           param-UserProfileUrl="@Url.Action("Details", "User", new { userId = Model.UserId })" />
