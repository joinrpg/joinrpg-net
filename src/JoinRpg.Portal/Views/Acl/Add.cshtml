@using JoinRpg.WebPortal.Models.Masters
@using JoinRpg.Web.ProjectMasterTools.Acl
@model AclViewModel

@{
    ViewBag.Title = "Добавление мастера в проект " + Model.ProjectName;
    var form = new AddMasterFormViewModel
    {
        Endpoint = Url.Action("Add", new { Model.ProjectId, userId = Model.UserId })!,
        UserProfileUrl = Url.Action("Details", "User", new { userId = Model.UserId })!,
        UserId = Model.UserId,
        Role = Model.Role,
        Description = Model.Description ?? "",
        IsPublic = Model.IsPublic,
        Permissions = Model.Badges,
        Errors = [.. ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage)],
    };
}

<h2>@ViewBag.Title</h2>

<partial name="_UserDetailsPanel" model="@Model.UserDetails" />
<hr class="col-md-12" />

<component type="typeof(AddMasterForm)" render-mode="Static" param-Model="@form" />
