@using JoinRpg.Web.Games.Projects
@model ProjectMastersViewModel
@{
    ViewBag.Title = "Мастера";
}

<component type="typeof(ProjectMastersPanel)" render-mode="Static" param-Model="@Model" />

@if (Model.ViewerIsMaster)
{
    @* Мастер видит здесь то же, что игроки; права, заявки и свой профиль мастера — на мастерской странице (ADR019, §7). *@
    <div class="alert alert-info">
        <a asp-action="Manage" asp-route-projectId="@Model.ProjectId.Value">Редактировать мастеров</a>
    </div>
}
