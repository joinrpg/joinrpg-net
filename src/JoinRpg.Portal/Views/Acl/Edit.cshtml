@using JoinRpg.WebPortal.Models.Masters
@using JoinRpg.Web.ProjectMasterTools.Acl

@model AclViewModel

@{
    ViewBag.Title = "Мастер в игре " + Model.ProjectName;
}

<h2>@ViewBag.Title</h2>

<component type="typeof(UserProfilePanel)" render-mode="Static" param-Model="@Model.UserDetails" />
<hr />

@if (Model.IsFormerMaster)
{
    @* Бывшего мастера возвращают правкой прав; профиль у снятого не правится и вернётся прежним (ADR019, §1). *@
    <p>
        @(Model.CanEditPermissions
            ? "Мастер снят с проекта. Отметьте права и нажмите «Вернуть в мастера» — роль и описание вернутся прежними."
            : "Мастер снят с проекта. Вернуть его можно, только пока проект не в архиве.")
    </p>
}
else
{
    @* Профиль (роль, описание, публичность) — остров: свой мастер правит сам, чужой — с правом выдавать доступ. *@
    <component type="typeof(MasterProfilePanel)" render-mode="WebAssembly"
               param-ProjectId="@(new ProjectIdentification(Model.ProjectId))"
               param-UserId="@(new UserIdentification(Model.UserId))" />
}

@if (Model.CanEditPermissions)
{
    <component type="typeof(MasterPermissionsPanel)" render-mode="WebAssembly"
               param-ProjectId="@(new ProjectIdentification(Model.ProjectId))"
               param-UserId="@(new UserIdentification(Model.UserId))" />
}

@Html.ActionLink("Назад к списку", "Manage", new { Model.ProjectId })
