@using JoinRpg.WebPortal.Models.Masters
@using JoinRpg.Web.ProjectMasterTools.Acl

@model AclViewModel

@{
    ViewBag.Title = "Мастер в игре " + Model.ProjectName;
}

<h2>@ViewBag.Title</h2>

<partial name="_UserDetailsPanel" model="@Model.UserDetails" />
<hr class="col-md-12" />

@* Профиль (роль, описание, публичность) — остров: свой мастер правит сам, чужой — с правом выдавать доступ. *@
<component type="typeof(MasterProfilePanel)" render-mode="WebAssembly"
           param-ProjectId="@(new ProjectIdentification(Model.ProjectId))"
           param-UserId="@(new UserIdentification(Model.UserId))" />

@if (Model.CanEditPermissions)
{
    <component type="typeof(EditMasterPermissionsForm)" render-mode="Static"
               param-Endpoint="@Url.Action("Edit", new { Model.ProjectId })"
               param-UserId="@Model.UserId"
               param-Permissions="@Model.Badges"
               param-Errors="@(ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToArray())" />
}

@Html.ActionLink("Назад к списку", "Index", new { Model.ProjectId })
