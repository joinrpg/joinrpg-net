@using JoinRpg.DomainTypes.Characters.Claims
@using JoinRpg.Web.ProjectCommon.Claims
@using JoinRpg.Web.ProjectCommon
@using JoinRpg.Common.WebComponents
@model JoinRpg.Web.Models.CheckIn.CheckInIndexViewModel

@{
  ViewBag.Title = "Регистрация";
}

<h2>Регистрация</h2>

@if (Model.JustCheckedIn is { } checkedIn)
{
  <div class="alert alert-success">
    Зарегистрирован(а) <b>@checkedIn.PlayerName</b> — @checkedIn.CharacterName.
    @if (checkedIn.CanPrintBadge)
    {
      <component type="typeof(JoinButton)"
                 render-mode="Static"
                 param-Link="@Url.Action("Badges", "Print", new { ProjectId = Model.ProjectId.Value, CharacterIds = new CompressedIntList([checkedIn.CharacterId]).ToString() })"
                 param-Preset="@ButtonPreset.Print"
                 param-Label="@("Напечатать бейдж")" />
    }
  </div>
}

@using (Html.BeginForm())
{
  @Html.HiddenFor(model => model.ProjectId)
  @Html.AntiForgeryToken()

  <component type="typeof(ClaimSelector)"
             render-mode="Static"
             param-Name="@nameof(Model.ClaimId)"
             param-ProjectId="@Model.ProjectId"
             param-Spec="@(ClaimStatusSpec.ReadyForCheckIn)" />
  @Html.ValidationMessageFor(model => model.ClaimId, "", new { @class = "text-danger" })

  <input type="submit" class="btn btn-success" value="Зарегистрировать"/>
}

<hr/>
@Html.ActionLink("Статистика по регистрации", "Stat", new {ProjectId = Model.ProjectId.Value})
