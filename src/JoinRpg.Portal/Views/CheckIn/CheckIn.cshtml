@model JoinRpg.Portal.Models.CheckInClaimPageModel
@{
  var checkIn = Model.CheckIn;
}

@{
  ViewBag.Title = "Регистрация игрока";
}

<h2>Регистрация игрока</h2>
@await Html.PartialAsync("CharacterNavigation", Model.Navigation)
<component type="typeof(UserProfilePanel)" render-mode="Static" param-Model="@checkIn.PlayerDetails" />
<dl>
  <dt>@Html.LabelFor(model => model.CheckIn.Master)</dt>
  <dd>@Html.DisplayFor(model => model.CheckIn.Master)</dd>
</dl>
@if (checkIn.CheckedInAlready)
{
  <div class="alert alert-danger">
    Игрок уже прошел регистрацию @Html.DisplayFor(model => model.CheckIn.CheckInTime).
  </div>
}

@if (!checkIn.IsApproved && !checkIn.CheckedInAlready)
{
  <div class="alert alert-danger">
    Заявка находится в статусе @Html.DisplayFor(model => model.CheckIn.ClaimStatus). Регистрация невозможна.
    <br/>Обратитесь к ответственному мастеру.
  </div>
}

<form asp-action="DoCheckIn" asp-route-projectId="@checkIn.ProjectId" asp-route-claimId="@checkIn.ClaimId" method="post">
  <input type="hidden" name="money" id="money" value="@checkIn.FeeDue" />

  @Html.ValidationSummary()
  @if (checkIn.FeeDue > 0)
  {

  <div class="panel panel-default">
    <div class="panel-heading">Принять взнос @checkIn.FeeDue</div>
    <div class="panel-body">
      @{
        var disableAcceptFeeCheckbox = checkIn.CanAcceptFee ? "" : "disabled";
      }
      @if (!checkIn.CanAcceptFee)
      {
        <div class="alert alert-danger">
          У вас нет прав отметить оплату взноса.
        </div>

      }
      <input type="checkbox" name="feeAccepted" id="feeAccepted" required="" @disableAcceptFeeCheckbox style="transform: scale(1.5); margin: 1em" />
      <label for="feeAccepted">
        Я, @checkIn.CurrentUserFullName, принял оплату взноса в размере @checkIn.FeeDue рублей, эти деньги будут лежать у меня для передачи уполномоченному мастеру.
      </label>
    </div>
  </div>
  }
  @if (checkIn.Problems.Any())
  {
  <div class="alert alert-danger">
    Не хватает данных для регистрации:
    <ul>
      @foreach (var problem in checkIn.Problems)
      {
        <li>
          <component type="typeof(JoinRpg.Web.Claims.ProblemBadge)" render-mode="Static" param-Model="@problem" />
          (@Html.DisplayFor(modelField => problem.WhoWillFill))
        </li>
      }
    </ul>
    Поля заполняются на @Html.ActionLink("заявке", "Edit", "Claim", new { checkIn.ClaimId, checkIn.ProjectId }, null), с полями мастера поможет ответственный мастер @Html.DisplayFor(model => model.CheckIn.Master).
    Данные профиля игрок заполняет сам в своём профиле.
  </div>
  }
  @await Html.PartialAsync("..\\Print\\_CharacterHandout", Model.Handouts)
  @if (checkIn.CanCheckInInPrinciple)
  {
  <input type="submit" class="btn btn-success" value="Зарегистрировать игрока" />
  }
</form>

@if (checkIn.Override is { } checkInOverride)
{
  <component type="typeof(JoinRpg.Web.CheckIn.CheckInOverridePanel)" render-mode="Static"
             param-Model="@checkInOverride"
             param-Endpoint="@Url.Action("DoCheckIn", new { checkIn.ProjectId, checkIn.ClaimId })" />
}
