@{
    var blocked = ViewData["ProjectBlocked"] is true;
    ViewBag.Title = blocked ? "Проект заблокирован" : "Проект находится в архиве";
}

<h2>@ViewBag.Title</h2>

<p>
    @if (blocked)
    {
        @:Проект заблокирован на время восстановления данных, изменения в нём сейчас невозможны.
    }
    else
    {
        @:Эта функция не доступна для неактивных проектов.
    }
</p>
