<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - JoinRpg.Portal</title>

  <environment include="Development">
    <link rel="stylesheet" href="~/lib/twitter-bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
  </environment>
  <environment exclude="Development">
    <link rel="stylesheet" href="~/lib/twitter-bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  </environment>
  @* Scoped CSS (*.razor.css) всех подключённых razor-библиотек. Бандл собирает SDK
     из графа ProjectReference, список проектов поддерживать руками не нужно.
     MapStaticAssets подставляет в href отпечаток содержимого, asp-append-version тут лишний. *@
  <link rel="stylesheet" href="~/JoinRpg.Portal.styles.css" />
  <link rel="stylesheet" href="~/_content/JoinRpg.Common.WebComponents/css/join-icons.css" />


  <base href="/" />

  <link rel="stylesheet" href="~/_content/JoinRpg.Common.WebComponents/css/roboto.css" />

  @RenderSection("styles", required: false)


  <environment include="Development">
    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.js"></script>
  </environment>
  <environment exclude="Development">
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/twitter-bootstrap/js/bootstrap.min.js"></script>
  </environment>
  <partial name="_ValidationScriptsPartial" />
</head>
<body data-enhance-nav="false">

    <vc:main-menu>
    </vc:main-menu>

    @if (ViewBag.ProjectId != null)
    {
        <vc:project-menu>
        </vc:project-menu>
    }

    <div class="container body-content">
        <partial name="_SiteBanner" />
        @RenderBody()
        <component type="typeof(JoinRpg.Portal.Components.Layout.Footer)" render-mode="Static" />
    </div>

    <component type="typeof(JoinRpg.Portal.Components.Layout.BlazorErrorUi)" render-mode="Static" />

    <script src="~/Scripts/edit-funcs.js" type="text/javascript"></script>
    <script src="/_framework/blazor.web.js" type="text/javascript"></script>
    <partial name="Layout/_WebComponentsScriptPartial" />

    <script src="~/Scripts/blazor-interop.js" type="module"></script>


    @RenderSection("Scripts", required: false)

    <partial name="Layout/_YandexPartial" />
    <persist-component-state />
</body>
</html>
