<environment include="Development">
    <script src="~/lib/jquery-validate/jquery.validate.js"></script>
</environment>
<environment exclude="Development">
    <script src="~/lib/jquery-validate/jquery.validate.min.js"></script>
</environment>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
<script>
  jQuery.validator.addMethod("enforcetrue", function (value, element, param) {
    return element.checked;
  });
  jQuery.validator.unobtrusive.adapters.addBool("enforcetrue");
  // Для обязательного мультивыбора в списке всегда остаётся выбран пустой placeholder
  // «( ничего не выбрано )» (claim.js:multiChanged), поэтому стандартный required
  // считает поле заполненным и алерт не показывается до ответа сервера.
  // Считаем поле заполненным, только если выбран хотя бы один вариант с непустым значением.
  jQuery.validator.addMethod("multiselectrequired", function (value, element) {
    return $(element).find("option:selected").filter(function () { return $(this).val() !== ""; }).length > 0;
  });
  jQuery.validator.unobtrusive.adapters.addBool("multiselectrequired");
</script>
