@using JoinRpg.DomainTypes
@using JoinRpg.Web.ProjectCommon
@model JoinRpg.Web.Models.IOperationsAwareView
@if (ViewBag.HideOperations == true)
{
    return;
}
@{
    var separator = ViewBag.FullyQualifiedUri.Contains('?') ? "&" : "?";
    var exportUri = ViewBag.FullyQualifiedUri + separator + "export=xlsx";
    ProjectIdentification? projectId = Model.ProjectId is int id ? new(id) : null;
    CharacterGroupIdentification? groupId = projectId is not null && Model.CharacterGroupId is int gid ? new(projectId, gid) : null;
}
<div style="display:flex;align-items:center">
    @if (Model.InlineTitle is not null)
    {
        <h2 style="vertical-align:central">@Model.InlineTitle</h2>
    }
    <div style="padding: 1em">
        <component type="typeof(ListOperationsButtons)"
                   render-mode="Static"
                   param-ProjectId="@projectId"
                   param-CharacterGroupId="@groupId"
                   param-ShowCreateCharacter="@Model.ShowCharacterCreateButton"
                   param-ClaimIds="@Model.ClaimIds"
                   param-CharacterIds="@Model.CharacterIds"
                   param-CountString="@Model.CountString"
                   param-ExportUri="@((string)exportUri)" />
    </div>
</div>
