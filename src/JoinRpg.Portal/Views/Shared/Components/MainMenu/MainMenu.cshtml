@using JoinRpg.Helpers
@model MainMenuViewModel
<nav class="navbar navbar-inverse navbar-fixed-top">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>
            @Html.ActionLink("JoinRpg", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
        </div>
        <div class="navbar-collapse collapse">
            <ul class="nav navbar-nav">
                @if (Model.IsAuthenticated)
                {
                <li class="dropdown">

                    @if (Model.CurrentProjectName is not null)
                    {

                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">@Model.CurrentProjectName <span class="caret"></span></a>
                    }
                    else 
                    {
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Мои проекты и заявки <span class="caret"></span></a>
                    }

                    <ul class="dropdown-menu">
                        @if (Model.MasterProjects.Length > 0)
                        {
                            <li class="dropdown-header">Мои проекты</li>
                            @foreach (var project in Model.MasterProjects)
                            {
                                <li>
                                    <a asp-action="Details" asp-controller="Game" asp-route-ProjectId="@project.ProjectId.Value" asp-area=""><join-icon icon="Edit" /> @project.ProjectName</a>
                                </li>
                            }

                            @if (Model.HasMoreProjects)
                            {
                                <li><a asp-action="BrowseGames" asp-controller="Home">...Еще игры</a></li>
                            }
                        }

                        @if (Model.MyClaims.Length > 0)
                        {
                            <li class="dropdown-header">Мои заявки</li>
                            @foreach (var claim in Model.MyClaims)
                            {
                                <li>
                                    <a asp-action="Edit" asp-controller="Claim" asp-route-ProjectId="@claim.ClaimId.ProjectId.Value" asp-route-ClaimId="@claim.ClaimId.ClaimId"><join-icon icon="Claim" /> @claim.CharacterName - @claim.ProjectName.Value</a>
                                </li>
                            }
                        }

                            <li>
                                @*В профиле лежат и архивные проекты, и все заявки — это и есть «мой архив»*@
                                <a asp-action="Me" asp-controller="User">Архив</a>
                            </li>
                        </ul>
                    </li>
                }

                    @if (ViewBag.IsProduction != true)
                    {
                        <li class="alert-danger hidden-sm">@Html.ActionLink("Тестовая версия", "About", "Home", new { area = "" }, null)</li>
                    }
                    else
                    {
                        <li class="hidden-sm">@Html.ActionLink("О сайте", "About", "Home", new { area = "" }, null)</li>
                    }
                    <li class="navbar-text" style="max-width: 10em">
                        @await Html.PartialAsync("SuperSearchPartial")
                    </li>
                </ul>
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
    </nav>
