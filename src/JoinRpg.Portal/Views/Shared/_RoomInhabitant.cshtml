@using JoinRpg.Web.Models.Accommodation;
@using JoinRpg.Web.Models.Money
@model AccRequestViewModel
<div class="list-group-item">
    <button class="btn btn-xs btn-default" title="Выселить из комнаты" onclick="Kick(@Model.Id)"><join-icon icon="Remove" /></button>
    <span class="badge acc-payment alert-@Model.PaymentStatusCssClass" title="@Model.PaymentStatusTitle"><join-icon icon="FeePaid" />@await Html.PartialAsync("Money", new Money(-Model.FeeToPay))</span>
    @await Html.PartialAsync("_RoomRequest", Model)
</div>
