@using JoinRpg.Web.Models.CharacterGroups
@using JoinRpg.Web.ProjectCommon
@inject ICharacterGroupUriLocator GroupUriLocator
@model CharacterGroupDetailsViewModel

@{

      string strikeStyleOfName = Model.IsActive ? "" : "text-decoration: line-through";
      var claimsGridGroupId = new CharacterGroupIdentification(new ProjectIdentification(Model.ProjectId), Model.CharacterGroupId);
}
<div style="margin-bottom: 1em">
    <ul class="nav nav-pills">
        <li class="disabled">
            <a href="#" style="cursor: default; @strikeStyleOfName"><span class="h3">@Model.Name</span></a>
        </li>
        @if (Model.HasMasterAccess || !Model.IsRootGroup)
        {
            <nav-link
                asp-controller="GameGroups"
                asp-action="Details"
                asp-route-projectid="@Model.ProjectId"
                asp-route-charactergroupid="@Model.CharacterGroupId">
                Группа
            </nav-link>
        }
        @if (Model.HasMasterAccess)
        {
            // Списки заявок группы живут на гриде /{projectId}/claims (ADR027 §6), поэтому ссылка
            // строится локатором, а подсветки активной вкладки, как у MVC-экшенов, у неё нет.
            <li><a href="@GroupUriLocator.GetClaimListUri(claimsGridGroupId)">Заявки</a></li>
            if (!Model.IsSpecial)
            {
                <li><a href="@GroupUriLocator.GetDiscussingClaimListUri(claimsGridGroupId)">Обсуждаемые</a></li>
            }
            <nav-link
                asp-controller="CharacterList"
                asp-action="ByGroup"
                asp-route-projectid="@Model.ProjectId"
                asp-route-charactergroupid="@Model.CharacterGroupId">
                Персонажи
            </nav-link>
            <nav-link
                asp-page="/GamePages/GroupReportView"
                asp-route-projectid="@Model.ProjectId"
                asp-route-charactergroupid="@Model.CharacterGroupId">
                Сводный отчет
            </nav-link>
            if (!Model.IsRootGroup)
            {
                <nav-link
                    asp-controller="PlotList"
                    asp-action="ForGroup"
                    asp-route-projectid="@Model.ProjectId"
                    asp-route-charactergroupid="@Model.CharacterGroupId">
                    Сюжеты
                </nav-link>
            }
        }
    </ul>

</div>
