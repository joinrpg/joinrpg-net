@using JoinRpg.Web.Models.Accommodation;
@using Newtonsoft.Json
@model RoomViewModel

<tr id="room@(Model.Id)" roomId="@Model.Id" occupancy="@Model.Occupancy" requests="@JsonConvert.SerializeObject(Model.Requests)">
    <td>@Model.Name</td>
    <td>@Model.Occupancy / @Model.Capacity</td>
    <td id="roomReqs@(Model.Id)">
        @if (Model.Requests != null)
        {
            foreach (AccRequestViewModel request in Model.Requests)
            {
                @await Html.PartialAsync("_RoomInhabitant", request)
            }
        }
    </td>
    <td>
        @if (Model.CanAssignRooms)
        {
            <div class="btn-group btn-group-sm" style="display: inline-block">
                <button id="add@(Model.Id)" onclick="AddPeople(@Model.Id)" type="button" class="btn btn-default" title="Заселить в комнату"><join-icon icon="Accommodation" /></button>
                <button id="kick@(Model.Id)" onclick="KickPeople(@Model.Id)" type="button" class="btn btn-default" title="Освободить комнату"><join-icon icon="Evict" /></button>
            </div>
        }
    </td>
    <td>
        @if (Model.CanManageRooms)
        {
            <div class="btn-group btn-group-sm" style="display: inline-block">
                <button id="rename@(Model.Id)" onclick="RenameRoom(@Model.Id)" type="button" class="btn btn-primary"><join-icon icon="Edit" /></button>
                <button id="delete@(Model.Id)" onclick="DeleteRoom(@Model.Id)" type="button" class="btn btn-warning"><join-icon icon="Delete" /></button>
            </div>
        }
    </td>
</tr>
