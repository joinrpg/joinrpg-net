@using JoinRpg.Web.Accommodation
@using JoinRpg.Web.Models.Accommodation
@model RoomTypeViewModel
@{
    ViewBag.Title = Model.ProjectName + ": тип поселения «" + Model.Name + "»";
}
<h2>@ViewBag.Title</h2>
<ul class="nav nav-tabs">
    <li><a href="@Url.Action("Index", "AccommodationType", new {Model.ProjectId})"><join-icon icon="Back" /> Список типов поселения</a></li>
    <li class="active"><a href="#">@(Model.CanManageRooms ? "Параметры" : "Информация")</a></li>
    <li><a href="@Url.Action("RoomTypeDetails", "AccommodationType", new {Model.ProjectId, RoomTypeId = Model.Id })">Комнаты</a></li>
</ul>
@if (Model.CanManageRooms)
{
    <component type="typeof(RoomTypeEditForm)"
               render-mode="WebAssemblyPrerendered"
               param-ProjectId="new ProjectIdentification(Model.ProjectId)"
               param-RoomTypeId="new AccommodationTypeIdentification(Model.ProjectId, Model.Id)" />
}
else
{
    <partial name="_RoomTypeOverview" model="Model" />
}
