
@using JoinRpg.Web.Models.Accommodation
@model AccommodationListViewModel
@{
    ViewBag.Title = "Поселение на игре «" + Model.ProjectName + "»";
}

@section Scripts {
    <script src="~/Scripts/roomsMessages.js"></script>
}

<h2>@ViewBag.Title</h2>

<div class="btn-group">
    @if (Model.CanManageRooms)
    {
        <a href="@Url.Action("AddRoomType", "AccommodationType", new {Model.ProjectId })" class="btn btn-success">
            <join-icon icon="Add" /> Добавить тип размещения
        </a>
    }
    @if (Model.CanAssignRooms)
    {
        @*<a href="@Url.Action("OccupyAll", "AccommodationType", new {ProjectId = Model.ProjectId })" class="btn btn-default" onclick="return ConfirmPlaceAll()">
            <join-icon icon="Accommodation" /> Заселить всех</a>*@
        @* Выселение меняет состояние, поэтому это POST-форма, а не ссылка. Кнопка остаётся
           в btn-group, а форма прячется рядом: вложенная в группу форма ломает вёрстку BS3. *@
        <button type="button" class="btn btn-default"
                onclick="if (ConfirmKickAll()) { document.getElementById('frmUnOccupyAll').submit(); }">
            <join-icon icon="EvictAll" /> Выселить всех
        </button>
    }
    <a href="@Url.Action("ListForRoomType", "ClaimList", new {Model.ProjectId})" class="btn btn-default">Игроки без поселения...</a>
    <a href="@Url.Action("MainReport", "AccommodationPrint", new { Export = "xlsx", Model.ProjectId})" class="btn btn-default">
        <join-icon icon="Download" /> Список расселения (Excel)
    </a>
</div>
@if (Model.CanAssignRooms)
{
    <form id="frmUnOccupyAll" method="post" asp-action="UnOccupyAll" asp-controller="AccommodationType"
          asp-route-projectId="@Model.ProjectId" hidden></form>
}

<div class="table-responsive" style="margin-top: 1em;">
  <table class="table">
    <thead>
    <tr>
      <th>Название</th>
      <th class="visible-lg">Описание</th>
      <th class="price-table" style="min-width: 10em; width: 10em;">Цена</th>
      <th class="price-table">Места</th>
      <th class="price-table">Нерасселено</th>
      <th style="min-width: 11em; width: 11em;"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var roomType in Model.RoomTypes)
    {
      <partial name="_RoomTypeDetails" model="roomType" />
    }
    @if (Model.RoomTypes.Count == 0)
    {
      <tr><td colspan="6">Типы размещения не добавлены</td></tr>
    }
    <partial name="_UnassignedClaimsDetails" model="Model.UnassignedClaims" />
    <tr>
      <td>Итого</td>
      <td class="visible-lg">&nbsp;</td>
      <td class="price-value">&nbsp;</td>
      <td class="price-value">
        <div>Свободно: @(Model.FreeCapacity)</div>
        <div>Занято: @(Model.TotalOccupied)</div>
      </td>
      <td class="price-value">
        @if (Model.TotalPaid != 0 || Model.TotalAcceptedNotPaid == 0)
        {
          <span title="@RoomTypeListItemViewModel.PaidTooltip">@Model.TotalPaid</span>
        }
        @if (Model.TotalAcceptedNotPaid != 0)
        {
          @if (Model.TotalPaid != 0 || Model.TotalAcceptedNotPaid == 0)
          {
            <text>+</text>
          }
          <span title="@RoomTypeListItemViewModel.AcceptedNotPaidTooltip">@Model.TotalAcceptedNotPaid</span>
        }
        = <span title="@RoomTypeListItemViewModel.TotalUnsettledTooltip">@(Model.TotalPending)</span>
      </td>
      <td>
        <a class="btn btn-sm btn-default disabled" href="#"><join-icon icon="MenuHorizontal" /></a>
      </td>
    </tr>
    </tbody>
  </table>

  @if (Model.CanManageRooms)
  {
    <div style="margin-top: 1em;">
      <a href="@Url.Action("AddRoomType", "AccommodationType", new {Model.ProjectId})" class="btn btn-success">
        <join-icon icon="Add" /> Добавить тип размещения
      </a>
    </div>
  }
</div>
