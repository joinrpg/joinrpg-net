@using JoinRpg.Web.Accommodation.Rooms
@model RoomTypeRoomsViewModel
@{
  ViewBag.Title = Model.ProjectName + ": тип поселения «" + Model.TypeName + "»";
}

<h2>@ViewBag.Title</h2>
<ul class="nav nav-tabs">
  <li><a href="@Url.Action("Index", "AccommodationType", new { ProjectId = Model.TypeId.ProjectId.Value })"><join-icon icon="Back" /> Список типов поселения</a></li>
  <li><a href="@Url.Action("EditRoomType", "AccommodationType", new { ProjectId = Model.TypeId.ProjectId.Value, RoomTypeId = Model.TypeId.AccommodationTypeId })">@(Model.CanManageRooms ? "Параметры" : "Информация")</a></li>
  <li class="active"><a href="#">Комнаты</a></li>
</ul>

<component type="typeof(RoomTypeRoomsControl)" render-mode="WebAssemblyPrerendered" param-Model="Model" />

<div>
  @await Html.PartialAsync("_BackButton", Model.TypeId.ProjectId.Value)
</div>
