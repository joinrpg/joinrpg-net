
@using JoinRpg.Web.Models.Accommodation
@model RoomTypeListItemViewModel

@{
    var actionParams = new
    {
        roomTypeId = Model.Id,
        projectId = Model.ProjectId
    };
}

    <tr>
        <td>
            <div>@Model.Name</div>
            @if (Model.IsInfinite || !Model.IsPlayerSelectable || Model.IsAutoFilledAccommodation)
            {
                <div style="margin-top: 0.3em;">
                    @if (Model.IsInfinite)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Info" Param-Text='"Бесконечное"' />
                    }
                    @if (!Model.IsPlayerSelectable)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Warning" Param-Text='"Закрыто для участников"' />
                    }
                    @if (Model.IsAutoFilledAccommodation)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Success" Param-Text='"Автозаполнение"' />
                    }
                </div>
            }
        </td>
        <td class="visible-lg">@Model.DescriptionView</td>
        <td class="price-value">@(await Html.RenderComponentAsync<PriceElement>(RenderMode.Static, new { Price = Model.Cost }))</td>
        @if (Model.IsInfinite)
        {
            <td class="price-value">
                <div>@Model.Capacity &#x2715; ∞ = ∞</div>
                @if (Model.Occupied == 0)
                {
                    <div>Занято: нет</div>
                }
                else
                {
                    <div>
                        Занято:
                        <span title="@RoomTypeListItemViewModel.CapacityTooltip">@Model.Capacity</span>
                        &#x2715; <span title="@RoomTypeListItemViewModel.FullyOccupiedRoomsTooltip">@Model.FullyOccupiedRoomsCount</span>
                        @if (Model.PartialRoomsCount > 0)
                        {
                            <text>+ <span title="@RoomTypeListItemViewModel.PartialOccupiedSeatsTooltip">@Model.PartialOccupiedSeats</span></text>
                        }
                        = <span title="@RoomTypeListItemViewModel.TotalOccupiedTooltip">@Model.Occupied</span>
                    </div>
                }
            </td>
        }
        else
        {
            <td class="price-value">
                @if (Model.FreeCapacity == 0)
                {
                    <div>Свободно: нет</div>
                }
                else
                {
                    <div>
                        Свободно:
                        <span title="@RoomTypeListItemViewModel.CapacityTooltip">@Model.Capacity</span>
                        &#x2715; <span title="@RoomTypeListItemViewModel.FullyFreeRoomsTooltip">@Model.FullyFreeRoomsCount</span>
                        @if (Model.PartialRoomsCount > 0)
                        {
                            <text>+ <span title="@RoomTypeListItemViewModel.PartialFreeSeatsTooltip">@Model.PartialFreeSeats</span></text>
                        }
                        = <span title="@RoomTypeListItemViewModel.TotalFreeTooltip">@Model.FreeCapacity</span>
                    </div>
                }
                @if (Model.Occupied == 0)
                {
                    <div>Занято: нет</div>
                }
                else
                {
                    <div>
                        Занято:
                        <span title="@RoomTypeListItemViewModel.CapacityTooltip">@Model.Capacity</span>
                        &#x2715; <span title="@RoomTypeListItemViewModel.FullyOccupiedRoomsTooltip">@Model.FullyOccupiedRoomsCount</span>
                        @if (Model.PartialRoomsCount > 0)
                        {
                            <text>+ <span title="@RoomTypeListItemViewModel.PartialOccupiedSeatsTooltip">@Model.PartialOccupiedSeats</span></text>
                        }
                        = <span title="@RoomTypeListItemViewModel.TotalOccupiedTooltip">@Model.Occupied</span>
                    </div>
                }
            </td>
        }
        <td class="price-value">
            @if (Model.PendingRequests != 0)
            {
                if (Model.PaidCount != 0 || Model.AcceptedNotPaidCount == 0)
                {
                    <span title="@RoomTypeListItemViewModel.PaidTooltip">@Model.PaidCount</span>
                }
                if (Model.AcceptedNotPaidCount != 0)
                {
                    if (Model.PaidCount != 0 || Model.AcceptedNotPaidCount == 0)
                    {
                        <text>+</text>
                    }
                    <span title="@RoomTypeListItemViewModel.AcceptedNotPaidTooltip">@Model.AcceptedNotPaidCount</span>
                }
                <text>= </text><span title="@RoomTypeListItemViewModel.TotalUnsettledTooltip">@Model.PendingRequests</span>
            }
        </td>
        <td>
            <div class="btn-group btn-group-sm" style="display: inline-block">
                <a title="Показать список заявок на тип поселения «@Model.Name»" class="btn btn-default" href="@Url.Action("ListForRoomType", "ClaimList", new { Model.ProjectId, RoomTypeId = Model.Id })"><join-icon icon="MenuHorizontal" /></a>
                @if (Model.CanAssignRooms)
                {
                    <a title="Расселение" href="@Url.Action("RoomTypeDetails", "AccommodationType", actionParams)" class="btn btn-default">
                        <join-icon icon="Accommodation" />
                    </a>
                }
                @if (Model.CanManageRooms)
                {
                    <a title="Изменить" href="@Url.Action("EditRoomType", "AccommodationType", actionParams)" class="btn btn-primary">
                        <join-icon icon="Edit" />
                    </a>
                }
                @if (Model.CanManageRooms && Model.Occupied == 0)
                {
                    <a title="Удалить" href="@Url.Action("DeleteRoomType", "AccommodationType", actionParams)" class="btn btn-warning" onclick="return confirm('Удалить тип размещения @(Model.Name)?')">
                        <join-icon icon="Delete" />
                    </a>
                }
            </div>
        </td>
    </tr>
