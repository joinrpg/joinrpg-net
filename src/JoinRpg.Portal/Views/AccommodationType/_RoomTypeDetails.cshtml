@using JoinRpg.Web.Models.Accommodation
@model RoomTypeListItemViewModel

@{
    var actionParams = new
    {
        roomTypeId = Model.Id,
        projectId = Model.ProjectId
    };
    var deleteConfirm = new Dictionary<string, object>
    {
        ["onclick"] = $"return confirm('Удалить тип размещения {Model.Name}?')",
    };
}

    <tr>
        <td>
            <div>@Model.Name</div>
            @if (Model.IsInfinite || !Model.IsPlayerSelectable || Model.IsAutoFilledAccommodation)
            {
                <div style="margin-top: 0.3em;">
                    @if (Model.IsInfinite)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Info" Param-Text='"Бесконечное"' />
                    }
                    @if (!Model.IsPlayerSelectable)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Warning" Param-Text='"Закрыто для участников"' />
                    }
                    @if (Model.IsAutoFilledAccommodation)
                    {
                        <component type="typeof(JoinBadge)" render-mode="Static" Param-Variation="VariationStyleEnum.Success" Param-Text='"Автозаполнение"' />
                    }
                </div>
            }
        </td>
        <td class="visible-lg">@Model.DescriptionView</td>
        <td class="price-value">@(await Html.RenderComponentAsync<PriceElement>(RenderMode.Static, new { Price = Model.Cost }))</td>
        @if (Model.IsInfinite)
        {
            <td class="price-value">
                <div>@Model.Capacity &#x2715; ∞ = ∞</div>
                <div>
                    Занято:
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.CapacityTooltip" param-Text="@Model.Capacity.ToString()" />
                    &#x2715;
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.FullyOccupiedRoomsTooltip" param-Text="@Model.FullyOccupiedRoomsCount.ToString()" />
                    @if (Model.PartialRoomsCount > 0)
                    {
                        <text>+
                        <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.PartialOccupiedSeatsTooltip" param-Text="@Model.PartialOccupiedSeats.ToString()" />
                        </text>
                    }
                    =
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.TotalOccupiedTooltip" param-Text="@Model.Occupied.ToString()" />
                </div>
            </td>
        }
        else
        {
            <td class="price-value">
                <div>
                    Свободно:
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.CapacityTooltip" param-Text="@Model.Capacity.ToString()" />
                    &#x2715;
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.FullyFreeRoomsTooltip" param-Text="@Model.FullyFreeRoomsCount.ToString()" />
                    @if (Model.PartialRoomsCount > 0)
                    {
                        <text>+
                        <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.PartialFreeSeatsTooltip" param-Text="@Model.PartialFreeSeats.ToString()" />
                        </text>
                    }
                    =
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.TotalFreeTooltip" param-Text="@Model.FreeCapacity.ToString()" />
                </div>
                <div>
                    Занято:
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.CapacityTooltip" param-Text="@Model.Capacity.ToString()" />
                    &#x2715;
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.FullyOccupiedRoomsTooltip" param-Text="@Model.FullyOccupiedRoomsCount.ToString()" />
                    @if (Model.PartialRoomsCount > 0)
                    {
                        <text>+
                        <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.PartialOccupiedSeatsTooltip" param-Text="@Model.PartialOccupiedSeats.ToString()" />
                        </text>
                    }
                    =
                    <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.TotalOccupiedTooltip" param-Text="@Model.Occupied.ToString()" />
                </div>
            </td>
        }
        <td class="price-value">
            @if (Model.PaidCount != 0 || Model.AcceptedNotPaidCount == 0)
            {
                <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.PaidTooltip" param-Text="@Model.PaidCount.ToString()" />
            }
            @if (Model.AcceptedNotPaidCount != 0)
            {
                @if (Model.PaidCount != 0 || Model.AcceptedNotPaidCount == 0)
                {
                    <text>+</text>
                }
                <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.AcceptedNotPaidTooltip" param-Text="@Model.AcceptedNotPaidCount.ToString()" />
            }
            =
            <component type="typeof(Tooltip)" render-mode="Static" param-Title="@RoomTypeListItemViewModel.TotalUnsettledTooltip" param-Text="@Model.PendingRequests.ToString()" />
        </td>
        <td>
            <div class="btn-group btn-group-sm" style="display: inline-block">
                <component type="typeof(JoinButton)"
                           render-mode="Static"
                           param-Link="@Url.Action("ListForRoomType", "ClaimList", new { Model.ProjectId, RoomTypeId = Model.Id })"
                           param-Icon="@JoinIconType.MenuHorizontal"
                           param-Size="@SizeStyleEnum.Small"
                           param-Title="@($"Показать список заявок на тип поселения «{Model.Name}»")" />
                @if (Model.CanAssignRooms)
                {
                    <component type="typeof(JoinButton)"
                               render-mode="Static"
                               param-Link="@Url.Action("EditRoomTypeRooms", "AccommodationType", actionParams)"
                               param-Icon="@JoinIconType.Accommodation"
                               param-Size="@SizeStyleEnum.Small"
                               param-Title='"Расселение"' />
                }
                @if (Model.CanManageRooms)
                {
                    <component type="typeof(JoinButton)"
                               render-mode="Static"
                               param-Link="@Url.Action("EditRoomType", "AccommodationType", actionParams)"
                               param-Icon="@JoinIconType.Edit"
                               param-Style="@VariationStyleEnum.Primary"
                               param-Size="@SizeStyleEnum.Small"
                               param-Title='"Изменить"' />
                }
                @if (Model.CanManageRooms && Model.Occupied == 0)
                {
                    <component type="typeof(JoinButton)"
                               render-mode="Static"
                               param-Link="@Url.Action("DeleteRoomType", "AccommodationType", actionParams)"
                               param-Icon="@JoinIconType.Delete"
                               param-Style="@VariationStyleEnum.Warning"
                               param-Size="@SizeStyleEnum.Small"
                               param-Title='"Удалить"'
                               param-AdditionalAttributes="@deleteConfirm" />
                }
            </div>
        </td>
    </tr>
