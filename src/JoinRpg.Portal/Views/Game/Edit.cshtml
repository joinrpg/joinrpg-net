@using JoinRpg.Web.ProjectMasterTools.Settings

@model JoinRpg.Web.Models.EditProjectViewModel

@{
    ViewBag.Title = "Настройки игры";
}

<h2>@ViewBag.Title</h2>

<component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.SettingsButtons)" render-mode="Static"
param-ProjectId="new ProjectIdentification (Model.ProjectId)"
param-Active="Model.Active"
param-Blocked="Model.Blocked"
param-HasEditAccess="Model.HasEditAccess" />
<hr/>

@* Каждая панель — свой остров; аккордеон из них собирает общее имя группы у JoinCollapsePanel,
   а panel-group лишь сближает свёрнутые панели. *@
<div class="panel-group">
    @* В архиве эти панели скрываются сами, но только после загрузки — без условия заголовки мелькали бы. *@
    @if (Model.Active)
    {
        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectMainSettingsPanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />

        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectClaimSettingsPanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />

        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectCheckInSettingsPanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />

        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Fields.ProjectFieldSettingsPanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />

        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectContactRequirementsPanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />

        <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectTimeZonePanel)" render-mode="WebAssembly"
                   param-ProjectId="new ProjectIdentification(Model.ProjectId)" />
    }

    <component type="typeof(JoinRpg.Web.ProjectMasterTools.Settings.ProjectPublishSettingsPanel)" render-mode="WebAssembly"
               param-ProjectId="new ProjectIdentification(Model.ProjectId)" />
</div>
