@model JoinRpg.Web.Models.UnblockProjectViewModel

@{
    ViewBag.Title = "Снятие блокировки проекта";
}

<h2>@ViewBag.Title</h2>

@if (!Model.IsBlocked)
{
    <p>
        Проект не заблокирован, снимать нечего. @Html.ActionLink("Вернуться к проекту", "Details", new { Model.ProjectId })
    </p>
    return;
}

<p>
    Проект заблокирован на время восстановления данных. Команда JoinRpg работает над восстановлением.
    Если восстанавливать проект не нужно, @Html.ActionLink("закройте", "Close", new { Model.ProjectId }) его.
    Если новых данных восстанавливать больше не нужно (всё нужное из раздела «Восстановление проекта» уже восстановлено)
    и вы хотите разблокировать работу и/или восстановить остальное вручную,
    нажмите кнопку «Разблокировать». После этого проект снова станет активным, как до блокировки — игроки смогут подавать
    заявки, если вы их откроете, а мастера менять персонажей, заявки и настройки.
</p>

<div class="alert alert-warning">
    <b>Внимание!</b> Разблокируйте проект, только если вы просмотрели раздел
    <a asp-page="/GamePages/ClaimRestore" asp-route-projectId="@Model.ProjectId">«Восстановление проекта»</a>
    и уверены, что все нужные данные оттуда уже восстановлены.
    После разблокировки восстановление станет недоступно, а <b>заблокировать проект снова нельзя</b>.
    Если после мая в проекте отмечали оплаты вручную (наличными и другими не онлайн-способами), не снимайте блокировку,
    пока они не восстановлены: после разблокировки вернуть их будет нельзя.
    Перед разблокировкой сверьтесь с @await Html.HelpLink("recovery-2026.html", "инструкцией по восстановлению").
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ProjectId)
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.Confirmation, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.Confirmation, new { @class = "form-control", autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.Confirmation, "", new { @class = "text-danger" })
                @Html.DescriptionFor(model => model.Confirmation)
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Разблокировать" class="btn btn-primary" />
            </div>
        </div>
    </div>
}
