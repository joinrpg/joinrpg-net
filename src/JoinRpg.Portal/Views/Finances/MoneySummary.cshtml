@model JoinRpg.Web.Models.MoneyInfoTotalViewModel
@using JoinRpg.Common.WebComponents

@{
    ViewBag.Title = "Сводка по деньгам";
    ViewBag.ShowLinks = true;
}

<h2>@ViewBag.Title</h2>

<h3>Итого</h3>

@await Html.PartialAsync("_MasterBalance", Model.Balance)

@if (Model.ExpenseSummary is { } expenseSummary)
{
    <h3>Расходы</h3>

    <table class="table">
        <tr>
            <th>Категория</th>
            <th>План (одобрено)</th>
            <th>Факт (одобрено)</th>
            <th>На рассмотрении</th>
        </tr>

        @foreach (var row in expenseSummary.Rows)
        {
            <tr>
                <td>@row.CategoryPath</td>
                <td>
                    @(await Html.RenderComponentAsync<PriceElement>(RenderMode.Static, new { Price = row.ApprovedPlannedCost }))
                </td>
                <td>
                    @(await Html.RenderComponentAsync<PriceElement>(RenderMode.Static, new { Price = row.ApprovedActualCost }))
                </td>
                <td>
                    @(await Html.RenderComponentAsync<PriceElement>(RenderMode.Static, new { Price = row.ProposedCost }))
                </td>
            </tr>
        }
        <tr>
            <td>
                <b>Потрачено (одобрено)</b>:
            </td>
            <td></td>
            <td>
                <b>-@expenseSummary.TotalSpent&nbsp;&#8381;</b>
            </td>
            <td></td>
        </tr>
        <tr>
            <td>
                <b>Осталось у мастеров</b>:
            </td>
            <td></td>
            <td>
                <b>@(Model.Balance.Sum(b => b.Total))&nbsp;&#8381;</b>
            </td>
            <td></td>
        </tr>
    </table>
}

<h3>По типам</h3>

@await Html.PartialAsync("_PaymentTypes", Model.PaymentTypeSummary)

<h3>
    Переводы
    <component type="typeof(JoinButton)"
               render-mode="Static"
               param-Link="@(Url.Action("Create", "Transfer", new { Model.ProjectId }))"
               param-Preset="ButtonPreset.Add"
               param-Style="VariationStyleEnum.Success"
               param-Label="@("Отметить перевод")" />
</h3>

@await Html.PartialAsync("_Transfers", Model.Transfers)
