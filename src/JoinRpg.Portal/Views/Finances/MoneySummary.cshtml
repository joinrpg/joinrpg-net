@model JoinRpg.Web.Models.MoneyInfoTotalViewModel
@using JoinRpg.Common.WebComponents

@{
    ViewBag.Title = "Сводка по деньгам";
}

<h2>@ViewBag.Title</h2>

@(await Html.RenderComponentAsync<MasterBalanceTable>(RenderMode.Static, new
{
    Rows = Model.Balance
        .Select(balance => new MasterBalanceRowViewModel(
            new UserLinkViewModel(balance.Master.ToUserInfoHeader()),
            balance.Total,
            balance.FeeBalance,
            balance.ReceiveBalance,
            balance.SendBalance,
            balance.ExpensesBalance,
            balance.PlannedExpenses,
            Url.Action("ByMaster", "Finances", new { balance.ProjectId, MasterId = balance.Master.UserId.Value })))
        .ToArray(),
    ShowTotal = true,
}))

@if (Model.ExpenseSummary is { } expenseSummary)
{
    @(await Html.RenderComponentAsync<ExpenseSummaryTable>(RenderMode.Static, new
    {
        Rows = expenseSummary.Rows
            .Select(row => new ExpenseSummaryRowViewModel(row.CategoryPath, row.ApprovedPlannedCost, row.ApprovedActualCost, row.ProposedCost, row.IsTotal))
            .ToArray(),
        ProjectId = Model.ProjectId,
    }))
}

<h3>Взносы (<a href="@Url.Action("Operations", "Finances", new { Model.ProjectId })">подробнее</a>)</h3>

@await Html.PartialAsync("_PaymentTypes", Model.PaymentTypeSummary)

<h3>
    Переводы
    <component type="typeof(JoinButton)"
               render-mode="Static"
               param-Link="@(Url.Action("Create", "Transfer", new { Model.ProjectId }))"
               param-Preset="ButtonPreset.Add"
               param-Style="VariationStyleEnum.Success"
               param-Label="@("Отметить перевод")" />
</h3>

@await Html.PartialAsync("_Transfers", Model.Transfers)
