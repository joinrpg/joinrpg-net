@using JoinRpg.Web.ProjectMasterTools.Fields
@model FieldNavigationModel

<ul class="nav nav-tabs">
    @*//TODO дисаблить поля, к которым нет доступа *@
    <nav-link asp-controller="GameField" asp-action="Index" asp-route-ProjectId="@Model.ProjectId">
        Активные
    </nav-link>
    <nav-link asp-controller="GameField" asp-action="DeletedList" asp-route-ProjectId="@Model.ProjectId" title="Только поля, использованные хотя бы один раз">
        Удаленные
    </nav-link>
    <nav-link asp-controller="GameField" asp-action="Settings" asp-route-ProjectId="@Model.ProjectId">
        Настройки полей
    </nav-link>
    <nav-link asp-controller="GameField" asp-action="Create" asp-route-ProjectId="@Model.ProjectId">
        <join-icon icon="Add" />Добавить новое поле
    </nav-link>
    @* Форма заявки в дефолтного персонажа — мастеру она показывается так, как её увидит игрок,
       даже если приём заявок закрыт. Без дефолтного шаблона ссылке некуда вести. *@
    @if (Model.DefaultTemplateCharacterId is CharacterIdentification defaultTemplateCharacterId)
    {
        <nav-link asp-controller="Claim" asp-action="AddForCharacter"
                  asp-route-ProjectId="@Model.ProjectId"
                  asp-route-CharacterId="@defaultTemplateCharacterId.CharacterId"
                  title="Посмотреть форму заявки так, как ее видит игрок">
            <join-icon icon="Claim" />Посмотреть форму заявки
        </nav-link>
    }
</ul>

<h3>@ViewBag.Title</h3>
