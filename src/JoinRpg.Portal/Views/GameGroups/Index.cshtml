@using JoinRpg.Web.Models
@using JoinRpg.Web.CharacterGroups.ProjectRoleGrid
@model GameRolesViewModel

@{
    ViewBag.Title = "Сетка ролей " + Model.ProjectName + ": " + Model.RootGroupName;
    ViewData["ShowEditControls"] = Model.ShowEditControls;
}
@Html.DisplayFor(model => model.Details)
@* Тело сетки строит остров ProjectRoleGrid в классическом режиме (транзиентная настройка без id). *@
@(await Html.RenderComponentAsync<ProjectRoleGrid>(RenderMode.WebAssembly, new { Model.ProjectId, ClassicGroupId = Model.GridGroupId }))
