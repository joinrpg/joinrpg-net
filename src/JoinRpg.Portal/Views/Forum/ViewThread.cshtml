@using JoinRpg.Web.Comments
@model JoinRpg.Portal.Models.ForumThreadPageModel

@{
    ViewBag.Title = Model.Thread.Header;
}
@Html.DisplayFor(model => model.Thread.GroupDetails)

<div>
    <h4>Форумы @Html.ActionLink(Model.Thread.GroupDetails.Name, "ListThreadsByGroup", new { Model.Thread.ProjectId, Model.Thread.GroupDetails.CharacterGroupId }) → @Model.Thread.Header</h4>
    <hr />
    <component type="typeof(Discussion)" render-mode="Static" param-Model="@Model.Discussion" />
</div>
