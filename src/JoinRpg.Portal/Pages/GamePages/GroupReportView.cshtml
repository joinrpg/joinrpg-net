@page "/{projectId:int}/roles/{characterGroupId:int}/report"
@using JoinRpg.Web.CharacterGroups.GroupReport
@model JoinRpg.Portal.Pages.GamePages.GroupReportPageModel
@{
    ViewData["Title"] = "Сводный отчет — " + Model.Details.Name;
}

@Html.DisplayFor(model => model.Details)
@(await Html.RenderComponentAsync<GroupReport>(RenderMode.WebAssemblyPrerendered, new { Model.GroupId }))
