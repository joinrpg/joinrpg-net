@inject IPlotUriLocator PlotUriLocator

<JoinButton
Preset="ButtonPreset.Edit"
Link="@uri"
Size="SizeStyleEnum.Small"
/>
@code
{
    private string uri = null!;

    [Parameter]
    [EditorRequired]
    public PlotElementIdentification Id { get; set; } = null!;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        uri = PlotUriLocator.GetElementInFolderUri(Id).ToString();
    }
}
