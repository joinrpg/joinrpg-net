@using JoinRpg.Web.Plots
@using JoinRpg.Common.WebComponents.Dialog
@inject ILogger<PlotElementControls> logger
@inject IPlotClient plotClient
@inject NavigationManager NavigationManager

<JoinButtonGroup>

@if (Model.PublishedVersion != null && Model.PlotStatus != PlotStatus.Deleted)
{
    <JoinButton Size="SizeStyleEnum.Small" Preset="ButtonPreset.Hide"
    Label="Скрыть" Title="Скрыть опубликованную версию от игроков"
    Disabled="!Model.HasEditAccess"
    DisabledTitle="Нужны права редактора сюжетов"
    OnClick="UnpublishExecuted"
    AutoConfirm="true"/>
}


@if (Model.PlotStatus == PlotStatus.Deleted)
{
    <JoinButton Size="SizeStyleEnum.Small" Preset="ButtonPreset.Restore"
    Label="Восстановить" Title="Вводная будет восстановлена и скрыта от игроков"
    Disabled="!Model.HasEditAccess"
    DisabledTitle="Нужны права редактора сюжетов"
    OnClick="RestoreExecuted"
    AutoConfirm="true" />
}
else
{
    <JoinButton Size="SizeStyleEnum.Small" Preset="ButtonPreset.Delete"
    Label="Удалить" Title="Удалить вводную"
    Disabled="!Model.HasEditAccess"
    DisabledTitle="Нужны права редактора сюжетов"
    OnClick="DeleteExecuted"
    AutoConfirm="true" />
}

@if ((Model.CurrentVersion.Version > Model.PublishedVersion?.Version || Model.PublishedVersion == null))
{
    var disabled = false;
    string? disabledReason = null;
    if (!Model.HasEditAccess)
    {
        (disabled, disabledReason) = (true, shouldHaveEditAccess);
    }
    if (Model.CouldBePublished)
    {
        (disabled, disabledReason) = (true, "Невозможно опубликовать вводную. Убедитесь что: Все TODO закрыты и поле очищено; вводная привязана к чему-то.");
    }
    <JoinButton Size="SizeStyleEnum.Small" Preset="ButtonPreset.Publish"
    Title="Опубликовать вводную"
    Disabled="disabled"
    DisabledTitle="@disabledReason"
    OnClick="OpenPublishDialog"
    />
}

</JoinButtonGroup>

<JoinPublishDialog @ref="publishDialogRef" PlotVersion="Model.CurrentVersion" />
<JoinMessageDialog @ref="errorDialog" Type="MessageDialogType.Fail">@error</JoinMessageDialog>

@code{
    const string shouldHaveEditAccess = "У вас должны быть права редактора сюжетов для этого";
    [Parameter]
    [EditorRequired]
    public PlotElementControlsViewModel Model { get; set; } = default!;

    private JoinPublishDialog? publishDialogRef;
    private JoinMessageDialog errorDialog = null!;
    private string error = "";

    //TODO: Удалить рефреши отсюда, вместо них перерисовывать элемент.
    private Task UnpublishExecuted(ButtonClickEventArgs args)
        => ExecuteAndRefresh(args, () => plotClient.UnPublishVersion(Model.CurrentVersion), "Не удалось скрыть вводную");

    private Task RestoreExecuted(ButtonClickEventArgs args)
        => ExecuteAndRefresh(args, () => plotClient.UnDeleteElement(Model.PlotElementId), "Не удалось восстановить вводную");

    private Task DeleteExecuted(ButtonClickEventArgs args)
        => ExecuteAndRefresh(args, () => plotClient.DeleteElement(Model.PlotElementId), "Не удалось удалить вводную");

    private async Task OpenPublishDialog(ButtonClickEventArgs args)
    {
        var model = await publishDialogRef!.ShowModalAsync();
        if (model is null)
        {
            NavigationManager.Refresh(forceReload: true);
            return;
        }
        await ExecuteAndRefresh(args, () => plotClient.PublishVersion(model), "Не удалось опубликовать вводную");
    }

    private async Task ExecuteAndRefresh(ButtonClickEventArgs args, Func<Task> action, string failureText)
    {
        try
        {
            await action();
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException exception)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            ShowError(args, exception.Message);
        }
        catch (Exception exception)
        {
            logger.LogError(exception, "Ошибка операции над вводной {PlotElementId}", Model.PlotElementId);
            ShowError(args, failureText);
        }
    }

    private void ShowError(ButtonClickEventArgs args, string text)
    {
        error = text;
        // Страница не перезагрузится — кнопку надо вывести из состояния «в процессе», иначе повторить нельзя.
        args.ExitProgressState = true;
        StateHasChanged();
        _ = errorDialog.ShowModalAsync();
    }
}

