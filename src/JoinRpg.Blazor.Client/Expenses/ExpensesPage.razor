@using JoinRpg.Blazor.Client.ApiClients
@using JoinRpg.Common.PrimitiveTypes
@using JoinRpg.DomainTypes.Finances
@using JoinRpg.Web.Finances.Expenses
@inject IExpensesClient Client
@inject ILogger<ExpensesPage> Logger

@* Страница «Расходы»: грид всех расходов проекта с действиями в строках и диалог
   создания/правки. Править можно свои расходы (или любые, с правом на деньги),
   одобрять/отклонять — только с правом на деньги. *@
@if (loadError is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@loadError</JoinAlert>
}
else if (expenses is null)
{
    <JoinLoadingMessage />
}
else
{
    @if (actionError is not null)
    {
        <JoinAlert Variation="VariationStyleEnum.Danger">@actionError</JoinAlert>
    }
    <p>
        <JoinButtonGroup>
            <JoinButton Preset="ButtonPreset.Add" Label="Новый расход" AutoProgress="false" OnClick="@StartCreate" />
            <JoinButton Link="@($"/webapi/{ProjectId.Value}/expenses/export?export=xlsx")" Preset="ButtonPreset.Download" Label="Скачать Excel" />
        </JoinButtonGroup>
    </p>
    <ExpenseEditDialog @ref="editDialog" ProjectId="ProjectId" CategorySuggestions="categorySuggestions" />

    <ExpensesGrid Expenses="expenses">
        <RowActions Context="expense">
            @if (CanEdit(expense) || CanDecide(expense))
            {
                <JoinButtonGroup Size="SizeStyleEnum.Small">
                    @if (CanEdit(expense))
                    {
                        <JoinButton Preset="ButtonPreset.Edit" AutoProgress="false" OnClick="@(args => StartEdit(expense))" />
                        @if (expense.ActualCost is null)
                        {
                            @* «Потратил»: факта ещё нет — диалог открывается с фактом, предзаполненным из плана *@
                            <JoinButton Label="Потратил" AutoProgress="false" OnClick="@(args => StartEdit(expense, fillActualFromPlan: true))" />
                        }
                    }
                    @if (CanDecide(expense))
                    {
                        <JoinButton Label="Одобрить" Style="VariationStyleEnum.Success"
                                    AutoConfirm="true" AutoConfirmMessage="@($"Одобрить расход «{expense.Name}»?")"
                                    OnClick="@(args => Decide(args, expense, Client.ApproveExpense))" />
                        <JoinButton Label="Отклонить" Style="VariationStyleEnum.Danger"
                                    AutoConfirm="true" AutoConfirmMessage="@($"Отклонить расход «{expense.Name}»?")"
                                    OnClick="@(args => Decide(args, expense, Client.RejectExpense))" />
                    }
                    @if (CanDeclineApproved(expense))
                    {
                        <JoinButton Label="Отклонить" Style="VariationStyleEnum.Danger"
                                    AutoConfirm="true" AutoConfirmMessage="@($"Отклонить расход «{expense.Name}»?")"
                                    OnClick="@(args => Decide(args, expense, Client.RejectExpense))" />
                    }
                </JoinButtonGroup>
            }
        </RowActions>
    </ExpensesGrid>
}

@code {
    [Parameter, EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    private IReadOnlyList<ExpenseViewModel>? expenses;
    private HashSet<ExpenseIdentification>? myExpenseIds;
    private IReadOnlyCollection<string>? categorySuggestions;
    private UserIdentification? currentUser;
    private bool canManageMoney;
    private ExpenseEditDialog editDialog = null!;
    private string? loadError;
    private string? actionError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAll();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка загрузки расходов проекта {ProjectId}", ProjectId);
            loadError = "Не удалось загрузить расходы. Обновите страницу и попробуйте ещё раз.";
        }
    }

    private async Task LoadAll()
    {
        var expensesTask = Client.GetExpenses(ProjectId);
        var myExpensesTask = Client.GetMyExpenses(ProjectId);
        var accessTask = Client.CanManageMoney(ProjectId);
        var suggestionsTask = Client.GetCategoryPathSuggestions(ProjectId);
        var currentUserTask = Client.GetCurrentUser(ProjectId);
        await Task.WhenAll(expensesTask, myExpensesTask, accessTask, suggestionsTask, currentUserTask);
        expenses = expensesTask.Result;
        myExpenseIds = [.. myExpensesTask.Result.Select(expense => expense.ExpenseId)];
        canManageMoney = accessTask.Result;
        categorySuggestions = suggestionsTask.Result;
        currentUser = currentUserTask.Result;
    }

    // Сервис разрешает править также расходы, созданные текущим пользователем, но понёсшие другого
    // мастера (MasterId ИЛИ CreatedById); остров показывает «Править» только по MasterId — в ExpenseViewModel
    // нет CreatedById. Осознанное сокращение, а не баг: не «исправлять» молча.
    private bool CanEdit(ExpenseViewModel expense)
        => canManageMoney || (myExpenseIds?.Contains(expense.ExpenseId) ?? false);

    private bool CanDecide(ExpenseViewModel expense)
        => canManageMoney && expense.State == ExpenseStateView.Proposed;

    // Отклонять одобренное может только мастер с правом на деньги
    private bool CanDeclineApproved(ExpenseViewModel expense)
        => canManageMoney && expense.State == ExpenseStateView.Approved;

    private async Task StartCreate()
    {
        actionError = null;
        // Мастер по умолчанию — текущий пользователь; дата — последний известный расход
        // (пустой список или расходы без дат — сегодня)
        var model = new ExpenseEditViewModel
        {
            MasterId = currentUser,
            SpentAt = expenses?.MaxBy(expense => expense.SpentAt)?.SpentAt ?? DateOnly.FromDateTime(DateTime.Today),
        };
        await EditAsync(model, state: null);
    }

    private async Task StartEdit(ExpenseViewModel expense, bool fillActualFromPlan = false)
    {
        actionError = null;
        var model = new ExpenseEditViewModel
        {
            ExpenseId = expense.ExpenseId,
            Name = expense.Name,
            CategoryPath = expense.CategoryPath,
            MasterId = expense.MasterId,
            PlannedQuantity = expense.PlannedQuantity,
            PlannedPrice = expense.PlannedPrice,
            // «Потратил» предзаполняет факт из плана; обычная правка сохраняет введённый факт
            ActualQuantity = fillActualFromPlan ? expense.PlannedQuantity : expense.ActualQuantity,
            ActualPrice = fillActualFromPlan ? expense.PlannedPrice : expense.ActualPrice,
            SpentAt = expense.SpentAt,
            Description = expense.Description,
        };
        await EditAsync(model, expense.State);
    }

    private async Task EditAsync(ExpenseEditViewModel model, ExpenseStateView? state)
    {
        while (true)
        {
            var result = await editDialog.ShowAsync(model, state);
            if (result is null)
            {
                return;
            }
            FillPlannedFromActual(result);
            var saved = await Save(result);
            // Продолжение выполняется не из события страницы (диалог закрылся по onclose) —
            // публикуем результат сохранения сами: и actionError, и обновлённый грид
            StateHasChanged();
            if (saved)
            {
                return;
            }
            // Сохранение не удалось — открываем диалог заново с той же моделью:
            // введённые данные не должны пропадать (как в старой панельной форме)
            model = result;
        }
    }

    // Факт ввели, а план пустой — подставляем план из факта. Страховка от потерянного
    // change-события; в живом диалоге то же делает ValueChanged полей факта.
    private static void FillPlannedFromActual(ExpenseEditViewModel model)
    {
        if (model.PlannedQuantity is null && model.ActualQuantity is > 0)
        {
            model.PlannedQuantity = model.ActualQuantity;
        }
        if (model.PlannedPrice is null && model.ActualPrice is > 0)
        {
            model.PlannedPrice = model.ActualPrice;
        }
    }

    private async Task<bool> Save(ExpenseEditViewModel model)
    {
        actionError = null;
        try
        {
            if (model.ExpenseId is { } expenseId)
            {
                await Client.EditExpense(expenseId, model);
            }
            else
            {
                await Client.CreateExpense(ProjectId, model);
            }

            await LoadAll();
            return true;
        }
        catch (ServerProblemException exception)
        {
            // Ожидаемый отказ сервиса (нет прав, чужой расход) — текст предназначен мастеру
            actionError = $"Ошибка: {exception.Message}";
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка сохранения расхода проекта {ProjectId}", ProjectId);
            actionError = "Не удалось сохранить расход. Обновите страницу и попробуйте ещё раз.";
            return false;
        }
    }

    private async Task Decide(ButtonClickEventArgs args, ExpenseViewModel expense, Func<ExpenseIdentification, string?, Task> decision)
    {
        actionError = null;
        try
        {
            await decision(expense.ExpenseId, null);
            await LoadAll();
        }
        catch (ServerProblemException exception)
        {
            actionError = $"Ошибка: {exception.Message}";
            args.ExitProgressState = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка согласования расхода {ExpenseId}", expense.ExpenseId);
            actionError = "Не удалось сохранить решение по расходу. Обновите страницу и попробуйте ещё раз.";
            args.ExitProgressState = true;
        }
    }
}
