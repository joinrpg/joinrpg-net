@using JoinRpg.Blazor.Client.ApiClients
@using JoinRpg.Web.Finances.Expenses
@inject IExpensesClient Client
@inject ILogger<MyExpensesLoader> Logger

@* Раздел «Мои расходы» на странице «Мои деньги»: расходы текущего мастера — сводка
   и общий грид без колонки «Мастер». Заголовок раздела (<h3>) — в самой странице. *@
@if (error is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@error</JoinAlert>
}
else if (expenses is null)
{
    <JoinLoadingMessage />
}
else
{
    @* «Одобрено» — сумма PlannedCost по Approved (факт может отсутствовать); Rejected не учитывается ни в одной сумме. *@
    <p>
        Запланировано: <b>@PlannedTotal ₽</b> / Одобрено: <b>@ApprovedTotal ₽</b>
    </p>
    <ExpensesGrid Expenses="expenses" ShowMaster="false" />
}

@code {
    [Parameter, EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    private IReadOnlyList<ExpenseViewModel>? expenses;
    private string? error;

    private int PlannedTotal => expenses?.Where(expense => expense.State != ExpenseStateView.Rejected).Sum(expense => expense.PlannedCost) ?? 0;

    private int ApprovedTotal => expenses?.Where(expense => expense.State == ExpenseStateView.Approved).Sum(expense => expense.PlannedCost) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            expenses = await Client.GetMyExpenses(ProjectId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка загрузки моих расходов по проекту {ProjectId}", ProjectId);
            error = "Не удалось загрузить расходы. Обновите страницу и попробуйте ещё раз.";
        }
    }
}
