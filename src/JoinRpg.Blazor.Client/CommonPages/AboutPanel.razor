@using JoinRpg.Common.PrimitiveTypes
<JoinPanel>
    <Header><h4>Команда сайта</h4></Header>
    <Body>
        @foreach (var (user, role) in team)
        {
            <div><b><UserLink Model="user" /></b> — @role</div>
        }
        <a href="http://bastilia.ru/about/">#Бастилия</a>
        <br />
        <JoinButton Label="К благодарностям"
                    Title="На сайте бастильского рейтинга"
                    Link="https://rating.bastilia.ru/project/joinrpg"
                    Size="SizeStyleEnum.Large" />

    </Body>
</JoinPanel>

<JoinPanel>
    <Header><h4>Как помочь?</h4></Header>
    <Body>
        <p style="text-align:center">
            <JoinButton Label="Донаты"
                        Link="/about/donate"
                        Preset="ButtonPreset.Donate"
                        Size="SizeStyleEnum.Large" />
        </p>
        <p>
            Самым простым способом помочь проекту было и остается пожертвование денег на оплату хостинга. Донат важен не только деньгами, это значимое подтверждение
            того, что наша работа важна для вас.
        </p>
        <p>
            Помимо донатов, Joinrpg — это открытый проект, в который может внести вклад каждый:
            <ul>
                <li>Программисты могут запилить свою любимую фичу на гитхабе: <a href="https://github.com/joinrpg/joinrpg-net">joinrpg</a> (.NET), <a href="https://github.com/joinrpg/kogda-igra">kogda-igra</a> (PHP).</li>
                <li>Тестеры и просто вьедливые ребята могут принять участие в тестировании релиза.</li>
                <li>Можно расширить документацию.</li>
            </ul>
            Обо всем этом можно поговорить <TelegramLink Link="+QGY9nm81elDmiBX3">в чате</TelegramLink>, а еще там можно обсудить JoinRpg с другими мастерами.
        </p>
    </Body>
</JoinPanel>

@code {
    private static readonly (UserLinkViewModel User, string Role)[] team =
    [
        (Member(1, "#ЛеоЦарев"), "создатель сайта, программист"),
        (Member(6817, "#Шико"), "программист"),
        (Member(393, "#Атана"), "документация"),
        (Member(490, "#Айка"), "техподдержка"),
        (Member(3173, "Лулукошка"), "тестер"),
        (Member(77075, "Боромир"), "DevOps"),
    ];

    private static UserLinkViewModel Member(int userId, string name) => new(new UserIdentification(userId), name, ViewMode.Show);
}
