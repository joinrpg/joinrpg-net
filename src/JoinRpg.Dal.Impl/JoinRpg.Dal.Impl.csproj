<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>
    <!-- JOIN001: EF-навигации, которые нельзя использовать за пределами DAL. DAL строит из них
         доменные снимки, поэтому здесь предупреждение подавлено. Первыми так помечены навигации
         группы проживающих (ADR022); помечать так можно любые навигации. -->

    <NoWarn>$(NoWarn);JOIN001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\JoinRpg.Data.Interfaces\JoinRpg.Data.Interfaces.csproj" />
    <ProjectReference Include="..\JoinRpg.Data.Write.Interfaces\JoinRpg.Data.Write.Interfaces.csproj" />
    <ProjectReference Include="..\JoinRpg.DataModel\JoinRpg.DataModel.csproj" />
    <ProjectReference Include="..\JoinRpg.Helpers\JoinRpg.Helpers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EntityFramework" />
    <PackageReference Include="LinqKit.EntityFramework" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>JoinRpg.DataModel.Mocks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
