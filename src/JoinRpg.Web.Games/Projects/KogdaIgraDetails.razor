@using JoinRpg.Web.ProjectCommon.KogdaIgra
@using JoinRpg.Web.ProjectCommon.Projects
@using JoinRpg.Common.WebComponents

Даты: <DateRangeDisplay Start="Model.Begin" End="Model.End" />
<br />
Регион: @Model.RegionName
<br />
@if (!string.IsNullOrWhiteSpace(Model.MasterGroupName))
{
    <text>МГ: @Model.MasterGroupName</text>
    <br />
}
@if (Model.SiteUri is not null)
{
    <text>Сайт: <a href="@Model.SiteUri"> @Model.SiteUri?.Host </a><br /></text>
}
@if (Model.Vk is not null)
{
    <VkLink Link="Model.Vk.Value" />
    <br />
}
@if (Model.LiveJournal is not null)
{
    <LiveJournalLink Contact="Model.LiveJournal" />
    <br />
}
@if (Model.TelegramChannel is not null)
{
    <text>Telegram: <TelegramLink Link="@Model.TelegramChannel" /></text>
    <br />
}
@code {
    [Parameter]
    [EditorRequired]
    public KogdaIgraCardViewModel Model { get; set; }
}
