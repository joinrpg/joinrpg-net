@if (Projects.Count > 0 || MoreGamesUrl is not null)
{
    <h2>@Header</h2>
    <div class="cards">

        @foreach (var project in Projects)
        {
            <div class="card">
                <h4 title="@project.ProjectName" class="project-name">
                    @if (project.LastKogdaIgraId is not null)
                    {
                        <a href="https://kogda-igra.ru/game/@(project.LastKogdaIgraId.Value)/"><JoinIcon Icon="JoinIconType.Calendar" style="color:black;" /></a>

                        <text>&nbsp;</text>
                    }
                    <ProjectLink Model="project" />
                </h4>
                @if (project.Status == ProjectLifecycleStatus.Blocked)
                {
                    <JoinBadge Variation="VariationStyleEnum.Warning" Title="Проект заблокирован на время восстановления данных" Text="Заблокирован" />
                }
                <JoinButtonGroup Size="SizeStyleEnum.Small">
                    @if (project.IsMaster)
                    {
                        <JoinButton Link="@($"/{project.ProjectId.Value}/home")"
                                    Style="VariationStyleEnum.Info"
                                    Title="У меня есть права мастера на этой игре"
                                    Label="Мой проект" />
                    }

                    <JoinButton Link="@projectUriLocator.GetRolesListUri(project.ProjectId).ToString()"
                                Style="VariationStyleEnum.Primary"
                                Title="Сетка ролей"
                                Label="Сетка ролей" />

                    @if (!project.IsMaster && project.PublishPlot)
                    {
                        <JoinButton Link="@($"/{project.ProjectId.Value}/plots/index")"
                                    Style="VariationStyleEnum.Info"
                                    Label="Материалы" />
                    }

                    @if (project.HasMyClaims || project.IsAcceptingClaims)
                    {
                        <MyClaimButton ProjectId="@project.ProjectId" HasMyClaims="@project.HasMyClaims" ProjectStatus="@project.Status" />
                    }
                </JoinButtonGroup>
            </div>

        }

        @if (MoreGamesUrl is not null)
        {
            <div class="card more-games-card">
                <h4 class="project-name">
                    Еще больше игр на <a href="@MoreGamesUrl"><JoinIcon Icon="JoinIconType.Calendar" style="color:black;" /><text>&nbsp;</text>КогдаИгре</a>
                </h4>
            </div>
        }
    </div>
}
@inject IProjectUriLocator projectUriLocator

@code {
    [Parameter]
    [EditorRequired]
    public IReadOnlyCollection<ProjectListItemViewModel> Projects { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string Header { get; set; } = null!;

    /// <summary>
    /// Ссылка «на все игры» на внешнем каталоге; показывается отдельной карточкой после списка проектов.
    /// </summary>
    [Parameter]
    public string? MoreGamesUrl { get; set; }
}
