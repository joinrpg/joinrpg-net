@inject IExpensesUriLocator ExpensesUriLocator

<h3>Расходы (<a href="@ExpensesUriLocator.GetExpensesUri(new ProjectIdentification(ProjectId))">подробнее</a>)</h3>

<JoinBorderedTable Items="Rows" Context="row">
    <HeadContent>
        <tr>
            <th>Категория</th>
            <th class="text-right">План (одобрено)</th>
            <th class="text-right">Факт (одобрено)</th>
            <th class="text-right">На рассмотрении</th>
        </tr>
    </HeadContent>
    <ItemTemplate>
        <tr>
            @if (row.IsTotal)
            {
                <td><b>@row.CategoryPath</b></td>
                <td class="text-right"><b><PriceElement Price="row.ApprovedPlannedCost" /></b></td>
                <td class="text-right"><b><PriceElement Price="row.ApprovedActualCost" /></b></td>
                <td class="text-right"><b><PriceElement Price="row.ProposedCost" /></b></td>
            }
            else
            {
                <td>@row.CategoryPath</td>
                <td class="text-right"><PriceElement Price="row.ApprovedPlannedCost" /></td>
                <td class="text-right"><PriceElement Price="row.ApprovedActualCost" /></td>
                <td class="text-right"><PriceElement Price="row.ProposedCost" /></td>
            }
        </tr>
    </ItemTemplate>
    <EmptyContent>
        <tr>
            <td colspan="4">Расходов пока нет</td>
        </tr>
    </EmptyContent>
</JoinBorderedTable>

@code {
    /// <summary>Строки по категориям; пустой список — строка-заглушка.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<ExpenseSummaryRowViewModel> Rows { get; set; } = default!;

    /// <summary>Id проекта: для ссылки на страницу расходов.</summary>
    [Parameter]
    [EditorRequired]
    public int ProjectId { get; set; }
}
