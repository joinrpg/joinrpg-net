@using JoinRpg.Helpers
@switch (Status)
{
    case ExpenseStatusView.Spent:
        <JoinBadge Variation="VariationStyleEnum.Success" Title="@Status.GetDescription()">@Status.GetDisplayName()</JoinBadge>
        break;
    case ExpenseStatusView.SpentUnapproved:
        <JoinBadge Variation="VariationStyleEnum.Warning" Title="@Status.GetDescription()">@Status.GetDisplayName()</JoinBadge>
        break;
    case ExpenseStatusView.Planned:
        <JoinBadge Variation="VariationStyleEnum.Info" Title="@Status.GetDescription()">@Status.GetDisplayName()</JoinBadge>
        break;
    case ExpenseStatusView.NotApproved:
        <JoinBadge Variation="VariationStyleEnum.Danger" Title="@Status.GetDescription()">@Status.GetDisplayName()</JoinBadge>
        break;
    default:
        <JoinBadge Variation="VariationStyleEnum.None" Title="@Status.GetDescription()">@Status.GetDisplayName()</JoinBadge>
        break;
}

@code {
    /// <summary>Комбинированный статус расхода: цвет бейджа — по согласованию и факту траты.</summary>
    [Parameter]
    [EditorRequired]
    public ExpenseStatusView Status { get; set; }
}
