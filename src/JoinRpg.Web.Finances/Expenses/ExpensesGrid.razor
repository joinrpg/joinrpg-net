@using System.Globalization

<JoinBorderedTable Items="Expenses" Context="expense">
    <HeadContent>
        <tr>
            <th>Категория</th>
            <th>Название</th>
            @if (ShowMaster)
            {
                <th>Мастер</th>
            }
            <th>Стоимость</th>
            <th>Состояние</th>
            <th>Дата</th>
            @if (RowActions is not null)
            {
                <th>Действия</th>
            }
        </tr>
    </HeadContent>
    <ItemTemplate>
        <tr>
            <td><span class="@StrikeClass(expense)">@expense.CategoryPath</span></td>
            <td><span class="@StrikeClass(expense)">@expense.Name</span></td>
            @if (ShowMaster)
            {
                <td><UserLink Model="expense.MasterLink" /></td>
            }
            <td class="expense-cost">
                <span class="@StrikeClass(expense)">
                    @if (expense.ActualCost is not { } actualCost)
                    {
                        <text>@expense.PlannedQuantity × <PriceElement Price="expense.PlannedPrice" /> = <PriceElement Price="expense.PlannedCost" /></text>
                    }
                    else
                    {
                        <text>@(expense.ActualQuantity!.Value) × <PriceElement Price="expense.ActualPrice!.Value" /> = <PriceElement Price="actualCost" /></text>
                    }
                </span>
                @if (expense.ActualCost is not null && !MatchesPlan(expense))
                {
                    <JoinIcon Icon="JoinIconType.Info" Title="@PlanTooltip(expense)" />
                }
            </td>
            <td><ExpenseStateBadge Status="expense.State.ToStatus(expense.ActualCost is not null)" /></td>
            <td>@(expense.SpentAt?.ToString("d", RussianCulture) ?? "—")</td>
            @if (RowActions is not null)
            {
                <td>@RowActions(expense)</td>
            }
        </tr>
    </ItemTemplate>
    <EmptyContent>
        <tr>
            <td colspan="@(5 + (ShowMaster ? 1 : 0) + (RowActions is null ? 0 : 1))">Расходов пока нет</td>
        </tr>
    </EmptyContent>
</JoinBorderedTable>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<ExpenseViewModel> Expenses { get; set; } = default!;

    /// <summary>Кнопки действий со строкой; <c>null</c> — колонки «Действия» нет.</summary>
    [Parameter]
    public RenderFragment<ExpenseViewModel>? RowActions { get; set; }

    /// <summary>Колонка «Мастер»; <c>false</c> — для списка расходов одного мастера.</summary>
    [Parameter]
    public bool ShowMaster { get; set; } = true;

    /// <summary>Факт совпадает с планом по количеству и цене (не только по итоговой сумме).</summary>
    private static bool MatchesPlan(ExpenseViewModel expense)
        => expense.ActualQuantity == expense.PlannedQuantity && expense.ActualPrice == expense.PlannedPrice;

    private static string PlanTooltip(ExpenseViewModel expense)
        => $"Ранее планировалось {expense.PlannedQuantity} × {FormatPrice(expense.PlannedPrice)} ₽ = {FormatPrice(expense.PlannedCost)} ₽";

    private static string FormatPrice(decimal price)
        => price.ToString("0.##", CultureInfo.GetCultureInfo("ru-RU"));

    private static string? StrikeClass(ExpenseViewModel expense)
        => expense.State == ExpenseStateView.Rejected ? "expense-rejected-strike" : null;
}
