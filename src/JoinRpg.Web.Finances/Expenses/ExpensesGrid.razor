@using System.Globalization

<JoinBorderedTable Items="Expenses" Context="expense">
    <HeadContent>
        <tr>
            <th>Категория</th>
            <th>Название</th>
            @if (ShowMaster)
            {
                <th>Мастер</th>
            }
            <th>План</th>
            <th>Факт</th>
            <th>Состояние</th>
            <th>Дата</th>
            @if (RowActions is not null)
            {
                <th>Действия</th>
            }
        </tr>
    </HeadContent>
    <ItemTemplate>
        <tr>
            <td>@expense.CategoryPath</td>
            <td>@expense.Name</td>
            @if (ShowMaster)
            {
                <td><UserLink Model="expense.MasterLink" /></td>
            }
            <td>@FormatCost(expense.PlannedQuantity, expense.PlannedPrice, expense.PlannedCost)</td>
            <td>
                @if (expense.ActualCost is { } actualCost)
                {
                    @FormatCost(expense.ActualQuantity!.Value, expense.ActualPrice!.Value, actualCost)
                }
                else
                {
                    <text>—</text>
                }
            </td>
            <td><ExpenseStateBadge Status="expense.State.ToStatus(expense.ActualCost is not null)" /></td>
            <td>@(expense.SpentAt?.ToString("d", RussianCulture) ?? "—")</td>
            @if (RowActions is not null)
            {
                <td>@RowActions(expense)</td>
            }
        </tr>
    </ItemTemplate>
    <EmptyContent>
        <tr>
            <td colspan="@(6 + (ShowMaster ? 1 : 0) + (RowActions is null ? 0 : 1))">Расходов пока нет</td>
        </tr>
    </EmptyContent>
</JoinBorderedTable>

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");

    [Parameter]
    [EditorRequired]
    public IReadOnlyList<ExpenseViewModel> Expenses { get; set; } = default!;

    /// <summary>Кнопки действий со строкой; <c>null</c> — колонки «Действия» нет.</summary>
    [Parameter]
    public RenderFragment<ExpenseViewModel>? RowActions { get; set; }

    /// <summary>Колонка «Мастер»; <c>false</c> — для списка расходов одного мастера.</summary>
    [Parameter]
    public bool ShowMaster { get; set; } = true;

    private static string FormatCost(int quantity, int price, int cost) => $"{quantity} × {price} ₽ = {cost} ₽";
}
