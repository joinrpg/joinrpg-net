@using JoinRpg.DomainTypes
<JoinPanel>
    <Header>@(IsNew ? "Новый расход" : "Редактирование расхода")</Header>
    <ChildContent>
        <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <FormHorizontal>
                @if (State is { } state)
                {
                    <FormRow Label="Состояние">
                        <ExpenseStateBadge State="state" />
                    </FormRow>
                }
                <FormRowFor For="@(() => Model.Name)">
                    <JoinTextInput @bind-Value="Model.Name" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.CategoryPath)">
                    <JoinTextInput @bind-Value="Model.CategoryPath" Variants="CategorySuggestions" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.MasterId)">
                    <MasterSelector ProjectId="ProjectId.Value" MasterId="Model.MasterId" MasterIdChanged="OnMasterChanged" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.PlannedQuantity)">
                    <JoinInputNumber @bind-Value="Model.PlannedQuantity" Min="0" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.PlannedPrice)">
                    <JoinInputNumber @bind-Value="Model.PlannedPrice" Min="0" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.ActualQuantity)">
                    <JoinInputNumber @bind-Value="Model.ActualQuantity" Min="0" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.ActualPrice)">
                    <JoinInputNumber @bind-Value="Model.ActualPrice" Min="0" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.SpentAt)">
                    <JoinRpgDatePicker Name="@nameof(Model.SpentAt)" @bind-Value="Model.SpentAt" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.Description)">
                    <JoinMarkdownTextArea @bind-Value="Model.Description" />
                </FormRowFor>
                <br />
                <JoinButton Preset="@(IsNew ? ButtonPreset.Add : ButtonPreset.Save)" Submit="true" Disabled="@formInvalid" />
                |
                <JoinButton Preset="ButtonPreset.Cancel" OnClick="OnCancel" />
            </FormHorizontal>
        </EditForm>
    </ChildContent>
</JoinPanel>

@code {
    /// <summary>
    /// Модель формы; страница создаёт её (для создания — с пустым <see cref="ExpenseEditViewModel.ExpenseId"/>).
    /// EditContext строится один раз при инициализации: при смене модели страница должна пересоздать компонент, например через <c>@("@key")</c>.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public ExpenseEditViewModel Model { get; set; } = null!;

    /// <summary>Проект, из которого MasterSelector грузит список мастеров.</summary>
    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; }

    /// <summary>Текущее состояние расхода; <c>null</c> при создании — бейдж не показываем.</summary>
    [Parameter]
    public ExpenseStateView? State { get; set; }

    /// <summary>Полные пути категорий для подсказок поля «Категория»; <c>null</c> — без подсказок.</summary>
    [Parameter]
    public IReadOnlyCollection<string>? CategorySuggestions { get; set; }

    /// <summary>Сабмит формы; страница сама отправляет результат на сервер.</summary>
    [Parameter]
    public EventCallback<ExpenseEditViewModel> OnSave { get; set; }

    /// <summary>Отмена редактирования; страница прячет форму.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    /// <summary>Режим формы: создание нового расхода (пустой <see cref="ExpenseEditViewModel.ExpenseId"/>) или правка существующего.</summary>
    private bool IsNew => Model.ExpenseId is null;

    private EditContext editContext = null!;
    private bool formInvalid = true;

    protected override void OnInitialized()
    {
        // При создании дата по умолчанию — сегодня; при правке сохранённую дату не затираем
        if (IsNew && Model.SpentAt is null)
        {
            Model.SpentAt = DateOnly.FromDateTime(DateTime.Today);
        }
        editContext = new EditContext(Model);
        editContext.OnFieldChanged += HandleFieldChanged;
        formInvalid = !editContext.Validate();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        formInvalid = !editContext.Validate();
    }

    private void OnMasterChanged(UserIdentification? masterId)
    {
        Model.MasterId = masterId;
        editContext.NotifyFieldChanged(new FieldIdentifier(Model, nameof(Model.MasterId)));
    }

    private async Task HandleSubmit()
    {
        formInvalid = !editContext.Validate();
        if (formInvalid)
        {
            return;
        }
        await OnSave.InvokeAsync(Model);
    }
}
