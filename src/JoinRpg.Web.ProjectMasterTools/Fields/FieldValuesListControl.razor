@inject IProjectFieldUriLocator UriLocator
@inject IProjectFieldOperationsClient ProjectFieldOperationsClient
@inject NavigationManager NavigationManager
@inject ILogger<FieldValuesListControl> Logger

<div>
    <JoinButtonGroup>
        <JoinButton Preset="ButtonPreset.Add"
                    Label="Добавить значение"
                    Link="@UriLocator.GetCreateVariantUri(FieldId).ToString()" />
        @if (SupportsMassAdding)
        {
            <FieldValuesMassAddButton FieldId="FieldId" />
        }
        @if (TimeSlotMassAdd is not null)
        {
            <TimeSlotMassAddButton Model="TimeSlotMassAdd" />
        }
    </JoinButtonGroup>
    <JoinButtonGroup>
        <JoinButton Preset="ButtonPreset.Sort"
                    Icon="JoinIconType.SortByAlphabet"
                    Label="Отсортировать по алфавиту"
                    ProgressLabel="Сортируем..."
                    AutoConfirm="true"
                    AutoConfirmMessage="Отсортировать значения по алфавиту?"
                    OnClick="SortByLabelAsync" />
        @if (IsTimeSlot)
        {
            <JoinButton Preset="ButtonPreset.Sort"
                        Label="Отсортировать по времени начала"
                        ProgressLabel="Сортируем..."
                        AutoConfirm="true"
                        AutoConfirmMessage="Отсортировать значения по времени начала?"
                        OnClick="SortByStartTimeAsync" />
        }
        @if (UnusedCount is var unusedCount && unusedCount > 0)
        {
            <JoinButton Preset="ButtonPreset.Delete"
                        Label="Удалить все неиспользованные"
                        Title="Удалить значения, которые ни разу не выбирали"
                        AutoConfirm="true"
                        AutoConfirmMessage="@($"Удалить значения, которые ни разу не выбирали ({unusedCount} шт.)? Это действие нельзя отменить.")"
                        OnClick="DeleteUnusedAsync" />
        }
    </JoinButtonGroup>
</div>

@if (errorMessage is not null)
{
    <JoinErrorMessage>@errorMessage</JoinErrorMessage>
}

<div style="margin-top: 1em;">
    <JoinTableSimple>
        <TableHeader>
            <th style="width: 20%;">Значение</th>
            <th class="price-table" style="width: 15%;"><span class="price-value price-RUR">Цена,</span></th>
            <th>Описание</th>
            <th style="min-width: 12em; width: 12em;"></th>
        </TableHeader>
        <TableBody>
            @foreach (var item in Items)
            {
                <tr title="@item.Label">
                    <td class="@(item.IsActive ? "" : "deleted")">
                        @item.Label
                        @if (item.MasterRestricted)
                        {
                            <JoinBadge Variation="VariationStyleEnum.Warning" Title="Это значение может выбрать только мастер (игрок не может выбрать)">только мастер</JoinBadge>
                        }
                    </td>
                    <td class="price-table">@(item.Price != 0 ? item.Price.ToString() : "")</td>
                    <td>@item.Description</td>
                    <td>
                        <JoinButtonGroup Size="SizeStyleEnum.Small">
                            @if (item.IsActive)
                            {
                                <JoinButton Preset="ButtonPreset.Edit"
                                            Size="SizeStyleEnum.Small"
                                            Label=""
                                            Title="Изменить"
                                            Link="@UriLocator.GetEditVariantUri(item.VariantId).ToString()" />
                                <JoinButton Preset="ButtonPreset.Delete"
                                            Size="SizeStyleEnum.Small"
                                            Label=""
                                            Title="Удалить"
                                            AutoConfirm="true"
                                            AutoConfirmMessage="@($"Удалить значение «{item.Label}»?")"
                                            OnClick="args => DeleteAsync(item, args)" />
                            }
                            else
                            {
                                <JoinButton Preset="ButtonPreset.Restore"
                                            Size="SizeStyleEnum.Small"
                                            Link="@UriLocator.GetEditVariantUri(item.VariantId).ToString()" />
                            }
                            <JoinMoveControl TItem="FieldVariantListItemViewModel"
                                          Items="Items"
                                          Self="item"
                                          SkipGroup="true"
                                          Size="SizeStyleEnum.Small"
                                          OnMoveCompleted="StateHasChanged" />
                        </JoinButtonGroup>
                    </td>
                </tr>
            }
        </TableBody>
    </JoinTableSimple>
</div>

@code {
    [Parameter, EditorRequired]
    public IList<FieldVariantListItemViewModel> Items { get; set; } = null!;

    [Parameter, EditorRequired]
    public ProjectFieldIdentification FieldId { get; set; } = null!;

    /// <summary>
    /// Поле — таймслот: значения можно отсортировать по времени начала
    /// </summary>
    [Parameter]
    public bool IsTimeSlot { get; set; }

    /// <summary>
    /// Можно добавить несколько значений сразу, по одному на строку
    /// </summary>
    [Parameter]
    public bool SupportsMassAdding { get; set; }

    /// <summary>
    /// Параметры массового добавления таймслотов; null — кнопки нет
    /// </summary>
    [Parameter]
    public TimeSlotMassAddViewModel? TimeSlotMassAdd { get; set; }

    private int UnusedCount => Items.Count(i => i.IsActive && !i.WasEverUsed);

    private string? errorMessage;

    private async Task SortByLabelAsync(ButtonClickEventArgs args)
    {
        try
        {
            errorMessage = null;
            await ProjectFieldOperationsClient.SortVariantsByLabel(FieldId);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (ServerProblemException ex)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при сортировке значений поля {FieldId} по алфавиту", FieldId);
            errorMessage = "Не удалось отсортировать значения";
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    private async Task SortByStartTimeAsync(ButtonClickEventArgs args)
    {
        try
        {
            errorMessage = null;
            await ProjectFieldOperationsClient.SortTimeSlotsByStartTime(FieldId);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (ServerProblemException ex)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при сортировке таймслотов поля {FieldId} по времени начала", FieldId);
            errorMessage = "Не удалось отсортировать значения";
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    private async Task DeleteUnusedAsync(ButtonClickEventArgs args)
    {
        try
        {
            errorMessage = null;
            await ProjectFieldOperationsClient.DeleteUnusedVariants(FieldId);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (ServerProblemException ex)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при удалении неиспользованных значений поля {FieldId}", FieldId);
            errorMessage = "Не удалось удалить неиспользованные значения";
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    private async Task DeleteAsync(FieldVariantListItemViewModel item, ButtonClickEventArgs args)
    {
        try
        {
            errorMessage = null;
            await ProjectFieldOperationsClient.DeleteVariant(item.VariantId);
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
        catch (ServerProblemException ex)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при удалении значения {VariantId}", item.VariantId);
            errorMessage = "Не удалось удалить значение";
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }
}
