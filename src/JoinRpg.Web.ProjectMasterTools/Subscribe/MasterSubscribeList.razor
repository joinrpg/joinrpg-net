@using JoinRpg.Web.ProjectCommon
@using Microsoft.JSInterop
@inject IGameSubscribeClient Client
@inject ILogger<MasterSubscribeList> Logger
@if (model is null)
{
  <JoinLoadingMessage />
  return;
}

@if (error is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@error</JoinAlert>
}

@if (addingModel is not null)
{
    <AddSubscribe ProjectId="@ProjectId" Model="@addingModel" OnClose="@(() => {addingModel = null;})" OnSave="OnAddRow" />
}
else
{
    <JoinButton Preset="ButtonPreset.Add"  Label="Подписаться на группу" OnClick="OnAddClicked" Disabled="@(!model.AllowChanges)"/> 
}

<div class="master-subscribe-list">
  <JoinTableSimple>
    <TableHeader>
        <th>Предмет подписки</th>
        <th>Виды операций</th>
        <th></th>
    </TableHeader>
    <TableBody>
      @foreach (var item in model.Items)
      {
        <MasterSubscribeListRow Model="@item" OnRemoveCallback="OnRemoveRow" @key="@item.UserSubscriptionId" />
      }
      @foreach (var paymentType in model.PaymentTypeNames)
      {
        <tr>
          <td title="Эту подписку нельзя настроить">Взносы/@paymentType</td>
          <td>
            <JoinBadge Variation="VariationStyleEnum.Success">
              Отмеченные взносы
            </JoinBadge>
          </td>
          <td></td>
        </tr>
      }
      <tr>
        <td title="Эту подписку нельзя настроить">Заявки, за которые ответственен</td>
        <td>
          <JoinBadge Variation="VariationStyleEnum.Success">
            Любые изменения
          </JoinBadge>
        </td>
        <td></td>
      </tr>
    </TableBody>
  </JoinTableSimple>

</div>
@code {
    private SubscribeListViewModel? model;

    private EditSubscribeViewModel? addingModel = null;

    [Parameter]
    public SubscribeListViewModel? InitialModel { get; set; }

    [Parameter]
    public int MasterId { get; set; }

    [Parameter]
    public int ProjectId { get; set; }

    protected async override Task OnInitializedAsync()
    {
        if (InitialModel != null)
        {
            model = InitialModel;
        }
        else
        {
            model = await Client.GetSubscribeForMaster(ProjectId, MasterId);
        }
    }

    async Task OnRemoveRow(SubscribeListItemViewModel item)
    {
        var items = model!.Items;
        var idx = items.IndexOf(item);
        if (idx < 0)
        {
            return;
        }
        items.RemoveAt(idx);
        error = null;
        try
        {
            await Client.RemoveSubscription(ProjectId, item.UserSubscriptionId);
        }
        catch (ServerProblemException exception)
        {
            // Например, проект заблокирован — причину показываем как есть
            error = exception.Message;
            items.Insert(idx, item);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при удалении подписки {UserSubscriptionId}", item.UserSubscriptionId);
            error = "Не удалось отписаться";
            items.Insert(idx, item);
        }
    }

    private async Task OnAddRow(EditSubscribeViewModel added)
    {
        error = null;
        try
        {
            await Client.SaveGroupSubscription(ProjectId, added);
        }
        catch (ServerProblemException exception)
        {
            error = exception.Message;
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при добавлении подписки мастера {MasterId}", MasterId);
            error = "Не удалось сохранить подписку";
            return;
        }
        addingModel = null;
        try
        {
            model = await Client.GetSubscribeForMaster(ProjectId, MasterId);
        }
        catch (Exception exception)
        {
            // Подписка уже сохранена — не предлагаем сохранить её ещё раз
            Logger.LogError(exception, "Ошибка при обновлении списка подписок мастера {MasterId}", MasterId);
            error = "Подписка сохранена, но список не обновился — обновите страницу";
        }
    }

    private string? error;

    private void OnAddClicked()
    {
        addingModel = new()
            {
                GroupId = null!, //Will be ignored
                MasterId = MasterId,
                Options = new(),
                UserSubscriptionId = null,
            };
    }

}
