@using JoinRpg.DomainTypes
@using JoinRpg.DomainTypes.Users
@inject IGameSubscribeClient Client
@inject ILogger<ClaimSubscribeButton> Logger

@if (model is null)
{
    <JoinLoadingMessage />
}
else if (model.IsDirect)
{
    <JoinButton Icon="JoinIconType.Subscribe" Label="Отписаться" Title="Вы подписаны на эту заявку" OnClick="OnUnsubscribeClicked" />
}
else if (model.ParentSubscribe.AllSet)
{
    <JoinButton Icon="JoinIconType.Subscribe" Label="Вы подписаны" Title="Вы подписаны на эту заявку" Disabled="true" />
}
else if (!model.ParentSubscribe.AnySet)
{
    <JoinButton Icon="JoinIconType.Subscribe" Label="Подписаться" Title="Вы не подписаны на эту заявку" OnClick="OnSubscribeClicked" />
}
else
{
    <JoinButton Icon="JoinIconType.Subscribe" Label="Подписаться" OnClick="OnSubscribeClicked">
        <TitleContent>
            Вы не подписаны на эту заявку, но будете получать уведомления в случаях:
            <ul>
                @if (model.SubscribeReason.TryGetValue(nameof(SubscriptionOptions.ClaimStatusChange), out var g))
                { <li>Изменение статуса (группа "@g")</li> }
                @if (model.SubscribeReason.TryGetValue(nameof(SubscriptionOptions.Comments), out g))
                { <li>Комментарии (группа "@g")</li> }
                @if (model.SubscribeReason.TryGetValue(nameof(SubscriptionOptions.FieldChange), out g))
                { <li>Изменение полей заявки (группа "@g")</li> }
                @if (model.SubscribeReason.TryGetValue(nameof(SubscriptionOptions.MoneyOperation), out g))
                { <li>Финансовые операции (группа "@g")</li> }
                @if (model.SubscribeReason.TryGetValue(nameof(SubscriptionOptions.AccommodationChange), out g))
                { <li>Операции с поселением (группа "@g")</li> }
            </ul>
        </TitleContent>
    </JoinButton>
}
@if (error is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@error</JoinAlert>
}

@code {
    [PersistentState]
    public ClaimSubscribeViewModel? model { get; set; }

    [Parameter, EditorRequired]
    public ClaimIdentification ClaimId { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        model ??= await Client.GetSubscribeForClaim(ClaimId);
    }

    private string? error;

    private Task OnSubscribeClicked(ButtonClickEventArgs args)
        => Change(args, () => Client.SubscribeClaimToUser(ClaimId), "Не удалось подписаться на заявку");

    private Task OnUnsubscribeClicked(ButtonClickEventArgs args)
        => Change(args, () => Client.UnsubscribeClaimToUser(ClaimId), "Не удалось отписаться от заявки");

    private async Task Change(ButtonClickEventArgs args, Func<Task<ClaimSubscribeViewModel>> action, string failureText)
    {
        error = null;
        try
        {
            model = await action();
        }
        catch (ServerProblemException exception)
        {
            // Например, проект заблокирован — причину показываем как есть
            error = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при изменении подписки на заявку {ClaimId}", ClaimId);
            error = failureText;
        }
        args.ExitProgressState = true;
    }
}
