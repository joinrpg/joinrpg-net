@inject IMasterAccessClient accessClient
@inject NavigationManager navigationManager
@inject ILogger<MasterPermissionsPanel> logger
@implements IDisposable

@if (Model is null)
{
    <JoinLoadingMessage />
    return;
}

<JoinPanel>
    <Header>Права доступа</Header>
    <Body>
        <EditForm FormName="MasterPermissions" EditContext="@editContext" OnValidSubmit="HandleValidSubmit">
            <FormHorizontal>
                @* @key: после сохранения модель перечитывается, а CheckboxInput берёт значение только при создании. *@
                <MasterPermissionFields @key="Model" Permissions="Model.Permissions" />

                <FormRow>
                    @if (Model.IsFormerMaster)
                    {
                        <JoinButton Preset="ButtonPreset.Save" Submit="true" Label="Вернуть в мастера" />
                    }
                    else
                    {
                        <JoinButton Preset="ButtonPreset.Save" Submit="true" />
                    }
                </FormRow>
            </FormHorizontal>
        </EditForm>
    </Body>
</JoinPanel>

@if (success)
{
    <JoinAlert Variation="VariationStyleEnum.Success">Права доступа сохранены</JoinAlert>
}
@if (errorMessage is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
}

@code {
    private EditContext? editContext;
    private bool success;
    private string? errorMessage;

    private MasterPermissionsViewModel? Model { get; set; }

    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public UserIdentification UserId { get; set; } = null!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (editContext is not null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
        Model = await accessClient.GetPermissions(ProjectId, UserId);
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        success = false;
        errorMessage = null;
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        success = false;
        errorMessage = null;
        try
        {
            await accessClient.SavePermissions(Model!);
        }
        catch (ServerProblemException exception)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            errorMessage = exception.Message;
            return;
        }
        catch (Exception exception)
        {
            logger.LogError(exception, "Ошибка при сохранении прав мастера в проекте {ProjectId}", ProjectId);
            errorMessage = "Неизвестная серверная ошибка при сохранении прав";
            return;
        }
        if (Model!.IsFormerMaster)
        {
            // Мастер вернулся — перезагружаем страницу правки целиком: на ней появится его профиль.
            navigationManager.NavigateTo(navigationManager.Uri, forceLoad: true);
            return;
        }
        // Показываем то, что записано: последнему с правом выдавать доступ сервис это право не снимает.
        await LoadAsync();
        success = true;
    }

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnFieldChanged -= HandleFieldChanged;
        }
    }
}
