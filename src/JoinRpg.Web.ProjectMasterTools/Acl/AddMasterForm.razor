@using JoinRpg.Web.ProjectCommon.Masters
@* Статический рендер: обычная HTML-форма, постится в MVC-экшен добавления мастера (поля — как у AddAclViewModel). *@

@if (RendererInfo.IsInteractive)
{
    <JoinErrorMessage>Этот компонент пока не поддерживает интерактивный рендеринг</JoinErrorMessage>
    return;
}

<form method="post" action="@Model.Endpoint">
    <AntiforgeryToken />
    <input type="hidden" name="UserId" value="@Model.UserId" />

    @if (Model.Errors.Count > 0)
    {
        <div class="text-danger">
            <ul>
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @* Чекбоксы — обычным input, а не CheckboxInput: у того значение лежит в скрытом поле, которое
       обновляется только при интерактивном рендере, а здесь рендер статический. *@
    <JoinPanel>
        <Header>Профиль мастера</Header>
        <Body>
            <FormHorizontal>
                <FormRowFor For="@(() => Model.Role)">
                    <JoinTextInput Value="@Model.Role" ValueExpression="@(() => Model.Role)" maxlength="100" required />
                </FormRowFor>
                <FormRowFor For="@(() => Model.Description)">
                    <JoinTextArea Value="@Model.Description" ValueExpression="@(() => Model.Description)" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.IsPublic)">
                    <input type="checkbox" id="IsPublic" name="IsPublic" value="true" checked="@Model.IsPublic" />
                </FormRowFor>
            </FormHorizontal>
        </Body>
    </JoinPanel>

    <JoinPanel>
        <Header>Права доступа</Header>
        <Body>
            <FormHorizontal>
                @foreach (var permission in Model.Permissions)
                {
                    var name = permission.Permission.ToString();
                    <FormRow Label="@permission.DisplayName" Description="@permission.Description">
                        <input type="checkbox" id="@name" name="@name" value="true" checked="@permission.Value" />
                    </FormRow>
                }
            </FormHorizontal>
        </Body>
    </JoinPanel>

    <JoinButton Preset="ButtonPreset.Add" Submit="true" Label="Добавить" />
    | <a href="@Model.UserProfileUrl">вернуться в профиль пользователя</a>
</form>

@code {
    [Parameter]
    [EditorRequired]
    public AddMasterFormViewModel Model { get; set; } = null!;
}
