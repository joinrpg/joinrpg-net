@inherits SettingsPanelBase<ProjectTimeZoneSettingsViewModel>
@inject IProjectSettingsClient settingsClient

@if (Model is null)
{
    <JoinLoadingMessage />
    return;
}

@if (Model.ProjectStatus == ProjectLifecycleStatus.Archived)
{
    return;
}

<JoinPanel>
    <Header>Часовой пояс</Header>
    <Body>
        <EditForm FormName="ProjectTimeZoneSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary />
                <DataAnnotationsValidator />

                <FormRowFor For="@(() => Model.TimeZoneId)">
                    <TimeZoneSelector @bind-Value="Model.TimeZoneId" />
                </FormRowFor>

                <FormRow>
                    <JoinButton Preset="ButtonPreset.Save" Submit="true" Disabled="@formInvalid" />
                </FormRow>
            </FormHorizontal>
        </EditForm>
    </Body>
</JoinPanel>

@if (success)
{
    <JoinAlert Variation="VariationStyleEnum.Success">Часовой пояс сохранён</JoinAlert>
}

@code {
    [Parameter]
    public ProjectIdentification ProjectId { get; set; } = null!;

    protected override Task<ProjectTimeZoneSettingsViewModel> LoadModel() => settingsClient.GetTimeZoneSettings(ProjectId);

    protected override Task SaveModel(ProjectTimeZoneSettingsViewModel model) => settingsClient.SaveTimeZoneSettings(model);
}
