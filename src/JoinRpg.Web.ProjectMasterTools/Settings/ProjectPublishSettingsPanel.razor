@inherits SettingsPanelBase<ProjectPublishSettingsViewModel>
@inject IProjectSettingsClient settingsClient

<JoinCollapsePanel Group="project-settings" Id="settings-publish">
    <Header>Настройки публикации проекта</Header>
    <ChildContent>
        @if (Model is null)
        {
            <JoinLoadingMessage />
            return;
        }
        <EditForm FormName="ProjectPublishSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary Model="Model" />
                <DataAnnotationsValidator />
                <fieldset disabled="@(!Model.HasEditAccess)">
                    @if (Model.ProjectStatus == ProjectLifecycleStatus.Archived)
                    {
                        <FormRowFor For="@(() => Model.PublishEnabled)">
                            <CheckboxInput @bind-Value="Model.PublishEnabled" />
                        </FormRowFor>
                    }
                    <FormRowFor For="@(() => Model.CloneSettings)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.CloneSettings" />
                    </FormRowFor>
                </fieldset>
                <SettingsSaveRow HasEditAccess="Model.HasEditAccess" Disabled="@formInvalid" />
            </FormHorizontal>
        </EditForm>
        @if (success)
        {
            <JoinAlert Variation="VariationStyleEnum.Success">Настройки публикации сохранены</JoinAlert>
        }
    </ChildContent>
</JoinCollapsePanel>

@code {
    [Parameter]
    public ProjectIdentification ProjectId { get; set; } = null!;

    protected override Task<ProjectPublishSettingsViewModel> LoadModel() => settingsClient.GetPublishSettings(ProjectId);

    protected override Task SaveModel(ProjectPublishSettingsViewModel model) => settingsClient.SavePublishSettings(model);
}
