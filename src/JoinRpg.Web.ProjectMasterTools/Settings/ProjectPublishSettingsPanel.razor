@inherits ProjectSettingsPanelBase<ProjectPublishSettingsViewModel>

@if (success)
{
    <JoinAlert Variation="VariationStyleEnum.Success">Настройки публикации сохранены</JoinAlert>
}

<JoinPanel>
    <Header>Настройки публикации проекта</Header>
    <Body>
        @if (Model is null)
        {
            <JoinLoadingMessage />
            return;
        }
        <EditForm FormName="ProjectPublishSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary />
                <DataAnnotationsValidator />
                @if (Model.ProjectStatus == ProjectLifecycleStatus.Archived)
                {
                    <FormRowFor For="@(() => Model.PublishEnabled)">
                        <CheckboxInput @bind-Value="Model.PublishEnabled" />
                    </FormRowFor>
                }
                <FormRowFor For="@(() => Model.CloneSettings)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.CloneSettings" />
                </FormRowFor>
                <FormRow>
                    <JoinButton Preset="ButtonPreset.Save" Submit="true" Disabled="@formInvalid" />
                </FormRow>
            </FormHorizontal>
        </EditForm>
    </Body>
</JoinPanel>

@code {
    protected override Task<ProjectPublishSettingsViewModel> LoadModel(ProjectIdentification projectId)
        => SettingsClient.GetPublishSettings(projectId);

    protected override Task SaveModel(ProjectPublishSettingsViewModel model) => SettingsClient.SavePublishSettings(model);
}
