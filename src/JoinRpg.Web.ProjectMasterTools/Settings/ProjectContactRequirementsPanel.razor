@inherits SettingsPanelBase<ProjectContactsSettingsViewModel>
@inject IProjectSettingsClient settingsClient

@if (Model is { ProjectStatus: ProjectLifecycleStatus.Archived })
{
    return;
}

<JoinCollapsePanel Group="project-settings" Id="settings-contacts">
    <Header>Настройки требований к контактам</Header>
    <ChildContent>
        @if (Model is null)
        {
            <JoinLoadingMessage />
            return;
        }
        <EditForm FormName="ProjectContractRequirementsSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary Model="Model" />
                <DataAnnotationsValidator />
                <fieldset disabled="@(!Model.HasEditAccess)">
                    <FormRowFor For="@(() => Model.Telegram)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.Telegram" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.Vkontakte)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.Vkontakte" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.Fio)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.Fio" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.Phone)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.Phone" />
                    </FormRowFor>
                    <FormRow>
                      <h4>Защищенные данные</h4>
                      Не запрашивайте эти данные, если они вам не абсолютно необходимы (например, для поселения). 
                    </FormRow>
                    <FormRowFor For="@(() => Model.Passport)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.Passport" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.RegistrationAddress)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.RegistrationAddress" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.BirthDate)">
                        <EnumRadioButtonGroup @bind-SelectedValue="Model.BirthDate" />
                    </FormRowFor>
                    @if (RequestsNewSensitiveData)
                    {
                        <FormRow>
                            <JoinAlert Variation="VariationStyleEnum.Warning">
                                Вы запрашиваете новые защищенные данные. Если игрок ранее давал вам согласие, вам нужно будет запрашивать его снова.
                            </JoinAlert>
                        </FormRow>
                    }
                </fieldset>
                <SettingsSaveRow HasEditAccess="Model.HasEditAccess" Disabled="@formInvalid" />
            </FormHorizontal>
        </EditForm>
        @if (success)
        {
            <JoinAlert Variation="VariationStyleEnum.Success">Настройки контактов сохранены</JoinAlert>
        }
    </ChildContent>
</JoinCollapsePanel>

@code {
    [Parameter]
    public ProjectIdentification ProjectId { get; set; } = null!;

    /// <summary>Какие защищённые данные проект запрашивает по сохранённым настройкам.</summary>
    private SensitiveRequests? saved;

    /// <summary>
    /// В форме запрошено то, чего нет в сохранённых настройках: при сохранении сервер отзовёт уже
    /// выданные согласия (#5706), и мастера надо предупредить заранее.
    /// </summary>
    private bool RequestsNewSensitiveData => saved is { } before && SensitiveRequests.From(Model).HasNewComparedTo(before);

    protected override async Task<ProjectContactsSettingsViewModel> LoadModel()
    {
        var model = await settingsClient.GetContactSettings(ProjectId);
        saved = SensitiveRequests.From(model);
        return model;
    }

    protected override async Task SaveModel(ProjectContactsSettingsViewModel model)
    {
        await settingsClient.SaveContactSettings(model);
        saved = SensitiveRequests.From(model);
    }

    private sealed record SensitiveRequests(bool Passport, bool RegistrationAddress, bool BirthDate)
    {
        public static SensitiveRequests From(ProjectContactsSettingsViewModel model)
            => new(
                model.Passport == MandatorySenstiveContactsView.Request,
                model.RegistrationAddress == MandatorySenstiveContactsView.Request,
                model.BirthDate == MandatorySenstiveContactsView.Request);

        public bool HasNewComparedTo(SensitiveRequests before)
            => (Passport && !before.Passport)
            || (RegistrationAddress && !before.RegistrationAddress)
            || (BirthDate && !before.BirthDate);
    }
}
