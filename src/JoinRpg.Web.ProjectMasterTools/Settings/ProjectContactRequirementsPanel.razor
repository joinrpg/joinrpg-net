@inherits SettingsPanelBase<ProjectContactsSettingsViewModel>
@inject IProjectSettingsClient settingsClient

@if (Model is null)
{
    <JoinLoadingMessage />
    return;
}

@if (Model.ProjectStatus == ProjectLifecycleStatus.Archived)
{
    return;
}

<JoinPanel>
    <Header>Настройки требований к контактам</Header>
    <Body>
        <EditForm FormName="ProjectContractRequirementsSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary />
                <DataAnnotationsValidator />
                <FormRowFor For="@(() => Model.Telegram)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.Telegram" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.Vkontakte)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.Vkontakte" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.Fio)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.Fio" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.Phone)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.Phone" />
                </FormRowFor>
                <FormRow>
                  <h4>Защищенные данные</h4>
                  Не запрашивайте эти данные, если они вам не абсолютно необходимы (например, для поселения). 
                </FormRow>
                <FormRowFor For="@(() => Model.Passport)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.Passport" />
                </FormRowFor>
                <FormRowFor For="@(() => Model.RegistrationAddress)">
                    <EnumRadioButtonGroup @bind-SelectedValue="Model.RegistrationAddress" />
                </FormRowFor>
                <FormRow>
                    <JoinButton Preset="ButtonPreset.Save" Submit="true" Disabled="@formInvalid" />
                </FormRow>
            </FormHorizontal>
        </EditForm>
    </Body>
</JoinPanel>

@if (success)
{
    <JoinAlert Variation="VariationStyleEnum.Success">Настройки контактов сохранены</JoinAlert>
}

@code {
    [Parameter]
    public ProjectIdentification ProjectId { get; set; } = null!;

    protected override Task<ProjectContactsSettingsViewModel> LoadModel() => settingsClient.GetContactSettings(ProjectId);

    protected override Task SaveModel(ProjectContactsSettingsViewModel model) => settingsClient.SaveContactSettings(model);
}
