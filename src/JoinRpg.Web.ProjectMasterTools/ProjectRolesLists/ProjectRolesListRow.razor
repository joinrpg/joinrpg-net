@inject NavigationManager NavigationManager
<div class="rule-list-row">

  <div>
    <h5>@Model.RolesList.Name @if (Model.IsDefault) { <text>&nbsp;</text><JoinBadge Variation="VariationStyleEnum.Info">По умолчанию</JoinBadge> }</h5>
    @if (Model.CharacterGroup != null)
    {
      <p>Группа: <CharacterGroupLink Model="Model.CharacterGroup" /></p>
    }
  </div>
  <div class="filler">

  </div>
  <div>
    <JoinButton Preset="ButtonPreset.None"
      OnClick='() => NavigationManager.NavigateTo($"/{Model.RolesList.ProjectRolesListId!.ProjectId.Value}/roleslist/{Model.RolesList.ProjectRolesListId!.ProjectRolesListId}")'
      Label="Открыть сетку"
      />
    <JoinButton Preset="ButtonPreset.Edit"
      OnClick='() => NavigationManager.NavigateTo($"/{Model.RolesList.ProjectRolesListId!.ProjectId.Value}/tools/roleslist/edit/{Model.RolesList.ProjectRolesListId!.ProjectRolesListId}")'
      Label="Редактировать"
      DisabledTitle="Для управления сетками ролей нужны права редактировать ролевку"
      Disabled="!HasEditAccess"
      />
    <JoinButton Preset="ButtonPreset.None"
      OnClick="() => OnSetDefaultCallback.InvokeAsync(Model)"
      Label="Сделать сеткой ролей по умолчанию"
      DisabledTitle="@(!HasEditAccess ? "Для управления сетками ролей нужны права редактировать ролевку" : "Эта сетка уже является сеткой ролей по умолчанию")"
      Disabled="!HasEditAccess || Model.IsDefault"
      />
    <JoinButton Preset="ButtonPreset.Delete"
      OnClick="() => OnRemoveCallback.InvokeAsync(Model)"
      Label="Удалить сетку"
      DisabledTitle="@(!HasEditAccess ? "Для управления сетками ролей нужны права редактировать ролевку" : "Нельзя удалить сетку ролей по умолчанию")"
      Disabled="!HasEditAccess || Model.IsDefault"
      />
  </div>
</div>
@code {

    [Parameter]
    public ProjectRolesListItemViewModel Model { get; set; } = null!;

    [Parameter]
    public EventCallback<ProjectRolesListItemViewModel> OnRemoveCallback { get; set; }

    [Parameter]
    public EventCallback<ProjectRolesListItemViewModel> OnSetDefaultCallback { get; set; }

    [Parameter]
    public bool HasEditAccess { get; set; }
}
