    private RenderFragment CharacterCell(ClaimRestoreRowEditor row) => __builder =>
    {
        var r = row.Row;
        if (r.Action == ClaimRestoreActionView.Create && PlannedCreation(row.Character) is { } creation)
        {
            @* Персонажа ещё нет в базе — выбор персонажа его не знает и сбросил бы на «новый персонаж». *@
            <div class="planned-character">будет создан: @(creation.Name ?? r.CharacterName) (№ @creation.CharacterId.CharacterId)</div>
            <div class="text-muted small">строкой раздела «Новые персонажи»; заявка подаётся на него</div>
        }
        else if (r.Action == ClaimRestoreActionView.Create)
        {
            @* Проект заблокирован, так что списки *ForMaster пусты; план ищет только среди активных. *@
            <SingleCharacterSelector ProjectId="@ProjectId"
                                     ListType="CharacterListType.Active"
                                     SelectedCharacterId="@row.Character"
                                     SelectedCharacterIdChanged="@(id => OnCreateCharacterChanged(row, id))"
                                     NewCharacterOptionText="Новый персонаж" />
            @if (row.NewCharacter)
            {
                <input type="text" class="form-control input-sm" value="@row.NewCharacterName" disabled="@Busy"
                       placeholder="Имя нового персонажа"
                       @onchange="@(e => row.NewCharacterName = e.Value as string ?? "")" />
                <div class="checkbox">
                    <label title="Создать нового персонажа шаблоном: на него подаются все заявки с этим именем, принятые получат своих персонажей из шаблона">
                        <input type="checkbox" class="new-character-slot" checked="@row.NewCharacterIsSlot" disabled="@Busy"
                               @onchange="@(e => row.NewCharacterIsSlot = e.Value is true)" />
                        Шаблон
                    </label>
                </div>
            }
            @if (r.CharacterCandidates.Count > 0)
            {
                <div class="text-muted small">
                    подходят по имени:
                    @for (var i = 0; i < r.CharacterCandidates.Count; i++)
                    {
                        @(i > 0 ? ", " : "")@CharacterLink(r.CharacterCandidates[i])
                    }
                </div>
            }
            @if (r.Character is { } planned && row.Character is null)
            {
                <div class="text-muted small">план предлагал: @planned.Name</div>
            }
        }
        else
        {
            if (r.CurrentCharacter is { } current)
            {
                <text>@CharacterLink(current)</text>
            }
            else
            {
                <text>@r.CharacterName</text>
            }
            if (r.Action == ClaimRestoreActionView.Change && row.CharacterOptions.Count > 0)
            {
                <div>
                    переместить на:
                    <select class="form-control input-sm" value="@(row.Character?.CharacterId.ToString() ?? "")" disabled="@Busy"
                            @onchange="@(e => OnMoveTargetChanged(row, e.Value as string))">
                        <option value="">не перемещать</option>
                        @foreach (var option in row.CharacterOptions)
                        {
                            <option value="@option.CharacterId.CharacterId">@option.Name</option>
                        }
                    </select>
                </div>
            }
            else if (r.CharacterName is not null && r.CharacterName.Trim() != r.CurrentCharacter?.Name.Trim())
            {
                <div class="text-muted">в уведомлениях: @r.CharacterName</div>
            }
        }
        @if (r.Attributes?.CharacterName is { HasAlternatives: true } names)
        {
            <div class="text-muted small">имя по источникам: @SourcesText(names, n => n)</div>
        }
    };

    private static void OnCreateCharacterChanged(ClaimRestoreRowEditor row, CharacterIdentification? id)
    {
        // null — пункт «новый персонаж».
        row.Character = id;
    }

    /// <summary>Куда переместить заявку при «изменить»; пусто — не перемещать.</summary>
    private void OnMoveTargetChanged(ClaimRestoreRowEditor row, string? value)
        => row.Character = int.TryParse(value, out var id) ? new CharacterIdentification(ProjectId, id) : null;

    private RenderFragment PlayerCell(ClaimRestoreRowEditor row) => __builder =>
    {
        var r = row.Row;
        if (r.Action != ClaimRestoreActionView.Create)
        {
            if (r.Player is { } player)
            {
                <UserLink Model="@player" />
            }
            return;
        }

        var candidates = new[] { r.Player }.OfType<UserLinkViewModel>().Concat(r.PlayerCandidates)
            .Where(p => p.UserId is not null).DistinctBy(p => p.UserId).ToList();
        if (candidates.Count > 0)
        {
            var selected = row.ManualPlayer ? "" : row.Player?.Value.ToString() ?? "";
            <select class="form-control input-sm" value="@selected" disabled="@Busy"
                    @onchange="@(e => OnPlayerChanged(row, e.Value as string))">
                @if (!row.ManualPlayer && row.Player is null)
                {
                    <option value="none">— выберите —</option>
                }
                @foreach (var candidate in candidates)
                {
                    <option value="@candidate.UserId!.Value">@candidate.DisplayName</option>
                }
                <option value="">Указать вручную</option>
            </select>
        }
        if (row.ManualPlayer)
        {
            <JoinUserLinkEditor Multiple="false" Values="@row.PlayerLinks" ValuesChanged="@(links => row.PlayerLinks = links)" />
        }
    };

    private void OnPlayerChanged(ClaimRestoreRowEditor row, string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            row.ManualPlayer = true;
            row.Player = null;
        }
        else
        {
            row.ManualPlayer = false;
            row.Player = int.TryParse(value, out var id) ? new UserIdentification(id) : null;
        }
    }

    private RenderFragment StatusCell(ClaimRestoreRowEditor row) => __builder =>
    {
        var r = row.Row;
        var options = row.StatusOptions;
        if (row.CanApply && (options.Count > 1 || (r.Action == ClaimRestoreActionView.Change && options.Count > 0)))
        {
            // Источники расходятся — мастер может выбрать не самый свежий статус.
            <select class="form-control input-sm status-select" value="@(row.Status?.ToString() ?? "")" disabled="@Busy"
                    @onchange="@(e => row.Status = Enum.TryParse<ClaimStatusView>(e.Value as string, out var status) ? status : null)">
                @if (r.Action == ClaimRestoreActionView.Change)
                {
                    <option value="">не менять (@StatusName(r.CurrentStatus))</option>
                }
                @foreach (var option in options.DistinctBy(o => o.Value))
                {
                    <option value="@option.Value">@StatusName(option.Value) — @SourceText(option)</option>
                }
            </select>
            return;
        }
        switch (r.Action)
        {
            case ClaimRestoreActionView.Create:
                <text>@StatusName(r.Status)</text>
                break;
            case ClaimRestoreActionView.Change when r.Status is not null:
                <span class="text-muted">@StatusName(r.CurrentStatus)</span>
                <text> → @StatusName(r.Status)</text>
                break;
            default:
                <span class="text-muted">@StatusName(r.CurrentStatus)</span>
                break;
        }
        if (r.Status is not null && r.StatusChangedAt is { } changedAt)
        {
            <div class="text-muted small">с @Format(changedAt)</div>
        }
    };

    private RenderFragment ResponsibleCell(ClaimRestoreRowEditor row) => __builder =>
    {
        var r = row.Row;
        if (!row.CanApply || model is null)
        {
            <text>@MasterName(r.CurrentResponsibleMaster)</text>
            return;
        }
        var selected = row.ResponsibleMaster?.Value.ToString() ?? "";
        <select class="form-control input-sm" value="@selected" disabled="@Busy"
                @onchange="@(e => row.ResponsibleMaster = int.TryParse(e.Value as string, out var id) ? new UserIdentification(id) : null)">
            @if (r.Action == ClaimRestoreActionView.Change)
            {
                <option value="">не менять (@MasterName(r.CurrentResponsibleMaster))</option>
            }
            else if (row.ResponsibleMaster is null)
            {
                <option value="">— выберите —</option>
            }
            @foreach (var master in model.Masters)
            {
                <option value="@master.UserId.Value">@master.Name</option>
            }
        </select>
        @if (r.Attributes?.ResponsibleMaster is { HasAlternatives: true } responsible)
        {
            <div class="text-muted small">по источникам: @SourcesText(responsible, MasterName)</div>
        }
    };

    private RenderFragment FeeCell(ClaimRestoreRowEditor row) => __builder =>
    {
        var r = row.Row;
        if (r.Action == ClaimRestoreActionView.Change && r.ManualFee is not null)
        {
            <label style="font-weight: normal">
                <input type="checkbox" checked="@row.ApplyFee" disabled="@(!row.CanApply || Busy)" title="Поставить этот взнос"
                       @onchange="@(e => row.ApplyFee = e.Value is true)" />
                <span class="text-muted">@(r.CurrentFee?.ToString() ?? "по умолчанию")</span>
                <text> → @r.ManualFee</text>
            </label>
        }
        else if (r.Action == ClaimRestoreActionView.Create)
        {
            <text>@(r.ManualFee?.ToString() ?? "по умолчанию")</text>
        }
        else
        {
            <span class="text-muted">@(r.CurrentFee?.ToString() ?? "по умолчанию")</span>
        }
    };
}
