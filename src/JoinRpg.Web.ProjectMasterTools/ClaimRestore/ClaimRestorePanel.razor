@using JoinRpg.DomainTypes.Characters
@using JoinRpg.Helpers
@using JoinRpg.Web.Claims
@using JoinRpg.Web.ProjectMasterTools.Fields
@inject IClaimRestoreClient Client
@inject ILogger<ClaimRestorePanel> Logger
@inject IUriLocator<ClaimIdentification> ClaimUriLocator
@inject IUriLocator<CharacterGroupIdentification> GroupUriLocator
@inject ICharacterUriLocator CharacterUriLocator
@inject SelectorListCache SelectorListCache

<JoinPanel>
    <Header>Восстановление проекта</Header>
    <Body>
        <p>
            Основная база восстановлена из резервной копии, и всё, что менялось после неё, потерялось.
            Эта страница собирает проект обратно из двух источников. Из <b>уведомлений</b>, которые сайт рассылал
            до аварии, — заявки: подача, статус, ответственный, взнос, перемещения. Из <b>выгрузок</b> персонажей
            и заявок, которые мастера скачивали себе в Excel (xlsx), — группы, персонажи с прежними номерами
            и значения полей. По каждому значению берётся самое свежее.
        </p>
        <p><HelpLink Link="recovery-2026.html" Message="Инструкция по восстановлению" /></p>
        <p>
            <b>Выгрузок нет — восстановить всё равно можно.</b> План по уведомлениям строится сразу, без загрузки
            файлов: заявки вернутся со своими номерами, статусами, ответственными и взносами, а персонажи для них
            создадутся по именам из уведомлений. Без выгрузки не восстановятся группы, прежние номера персонажей и
            значения полей анкет. В этом случае пропустите шаги 1–2.
        </p>
        <ol>
            <li>Если выгрузки есть — загрузите выгрузки персонажей и заявок, можно несколько, разных дат.</li>
            <li>Укажите дату каждой выгрузки: по ней решается, что свежее. Она подставлена из свойств файла — проверьте её; если в свойствах даты нет, введите сами.</li>
            <li>Проверьте план: по каждому полю видно, что сейчас, что станет и откуда значение.</li>
            <li>Отметьте нужное и нажмите «Применить отмеченные».</li>
        </ol>
        <p>
            Игрокам при этом <b>ничего не отправляется</b>, а в истории заявки остаётся запись о восстановлении.
            Инструмент доступен, только пока проект заблокирован на время восстановления.
            Строки и поля с пометками заранее не отмечены — проверьте их сами.
            Видимость новых персонажей вы выбираете при каждом применении: публичными; публичными, но с игроком,
            которого видят только мастера; или скрытыми.
            Выгрузки на сервере не сохраняются: если обновить страницу, их нужно загрузить снова.
        </p>
        <p>Перед восстановлением желательно:</p>
        <ul>
            <li>
                <b>настроить поля проекта</b>, если они потерялись, с прежними названиями: значения из выгрузки
                сопоставляются с полями по названию колонки, а варианты списков — по тексту варианта;
                прежде всего — поле с именем персонажа: через него задаётся имя новых персонажей;
            </li>
            <li>
                <b>вернуть доступ всем мастерам</b>, которые вели заявки: ответственным можно назначить только
                мастера проекта, и строку с ответственным, которого нет среди мастеров, не применить;
            </li>
            <li>
                убедиться, что <b>игроки есть на сайте</b> — иначе их не выбрать в строке заявки.
            </li>
        </ul>

        @if (model is not null && model.UnavailableReason is null)
        {
            <p class="text-muted">
                Учтены уведомления до @Format(model.LostAt); резервная копия базы — от @Format(model.BackupTakenAt).
            </p>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <JoinAlert Variation="VariationStyleEnum.Success">@successMessage</JoinAlert>
        }

        @if (model is null)
        {
            <JoinLoadingMessage Message="Строим план восстановления..." />
        }
        else if (model.UnavailableReason is { } reason)
        {
            <JoinAlert Variation="VariationStyleEnum.Warning">
                @(reason switch
                {
                    ClaimRestoreUnavailableReason.ProjectNotBlocked => "Восстанавливать проект можно, только пока он заблокирован на время восстановления.",
                    _ => "Для восстановления проекта нужны права на управление заявками.",
                })
            </JoinAlert>
        }
        else
        {
            <UnboundCharacterNameFieldWarning FieldNames="model.UnboundNameFieldCandidates" ProjectId="ProjectId" />

            @if (model.CharacterNameMismatch is { } nameMismatch)
            {
                <CharacterNameMismatchWarning Mismatch="nameMismatch" />
            }

            @ExportsSection()

            @if (IsEmpty)
            {
                <JoinAlert Variation="VariationStyleEnum.Info">
                    @(exports.Count > 0
                        ? "Восстанавливать нечего: по уведомлениям заявки после резервной копии не менялись, а выгрузки совпадают с базой."
                        : "По уведомлениям восстанавливать нечего. Загрузите выгрузки персонажей и заявок, если они есть.")
                </JoinAlert>
            }
            else
            {
                @if (!model.CanEditRoles && (groups.Count > 0 || creations.Count > 0 || changes.Count > 0))
                {
                    <JoinAlert Variation="VariationStyleEnum.Warning">
                        Группы и персонажей может восстанавливать только мастер с правом редактировать персонажей и группы.
                        Эти разделы показаны для сведения, применить их нельзя.
                    </JoinAlert>
                }
                <p>
                    Строк в плане: @TotalRows, из них отмечено: @SelectedRows.
                    Строки применяются по очереди: группы, новые персонажи, заявки, изменения персонажей, поля заявок.
                    Если строка, от которой зависит другая, не применилась, зависимая тоже не применяется.
                </p>

                @NotesSection()
                @GroupsSection()
                @CharactersSection("Новые персонажи", "Персонажи из выгрузки, которых нет в базе: создаются с прежними номерами, с группами и полями из выгрузки и с видимостью, которую вы выберете при применении.", creations)
                @ClaimsSection()
                @CharactersSection("Изменения персонажей", "Группы и поля существующих персонажей, которые отличаются от выгрузки.", changes)
                @ClaimFieldsSection()

                @if (planStale)
                {
                    <JoinAlert Variation="VariationStyleEnum.Warning">
                        План на экране устарел: перестроить его по загруженным выгрузкам не удалось. Применять его нельзя —
                        измените дату или уберите и снова загрузите выгрузку, либо обновите страницу.
                    </JoinAlert>
                }
                @if (CreatesCharacters)
                {
                    @NewCharacterVisibilitySection()
                }
                <JoinButton Preset="ButtonPreset.Save" Label="Применить отмеченные" ProgressLabel="Применяем..."
                            InProgress="@applying" AutoProgress="false"
                            Disabled="@(Busy || planStale || SelectedRows == 0 || VisibilityMissing)"
                            OnClick="ApplySelected" />
            }
        }
    </Body>
</JoinPanel>

@code {
    private const long MaxFileSize = 30 * 1024 * 1024;
    private const int MaxFilesAtOnce = 20;

    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    private ClaimRestorePlanViewModel? model;
    private List<ClaimRestoreRowEditor> rows = [];
    private List<GroupRestoreRowEditor> groups = [];
    private List<CharacterRestoreRowEditor> creations = [];
    private List<CharacterRestoreRowEditor> changes = [];
    private List<ClaimFieldsRestoreRowEditor> claimFields = [];
    private readonly List<UploadedExport> exports = [];

    /// <summary>
    /// Выбор мастера «шаблон / не шаблон» у новых персонажей (#5733). Уходит в план: от типа зависят привязка
    /// заявок и куда идут поля персонажа из выгрузки заявок.
    /// </summary>
    private readonly Dictionary<CharacterIdentification, bool> slotChoices = [];

    private readonly List<string> uploadErrors = [];
    private bool applying;
    private bool uploading;
    /// <summary>Причина для сбоя, который сервер не объяснил (например, 5xx): его текст мастеру не показываем.</summary>
    private const string GenericError = "произошла ошибка, попробуйте ещё раз";

    private string? errorMessage;
    private string? successMessage;

    /// <summary>Идёт построение плана — таблицы показывают прежний план, применять его нельзя.</summary>
    private bool loadingPlan;

    /// <summary>
    /// План на экране не соответствует загруженным выгрузкам (перестроить не удалось) — применять нельзя.
    /// </summary>
    private bool planStale;

    /// <summary>Номер последнего запроса плана: ответы на более ранние запросы отбрасываются.</summary>
    private int planVersion;

    private bool Busy => applying || uploading || loadingPlan;

    private bool IsEmpty => rows.Count == 0 && groups.Count == 0 && creations.Count == 0 && changes.Count == 0 && claimFields.Count == 0;

    private IEnumerable<RestoreRowEditorBase> ExportRows => [.. groups, .. creations, .. changes, .. claimFields];

    /// <summary>Строки, где есть что делать: «ничего» (совпадает с базой или менять нельзя) не считаем.</summary>
    private int TotalRows
        => rows.Count(r => r.Row.Action != ClaimRestoreActionView.Nothing)
            + groups.Count(g => g.Row.Action != ClaimRestoreActionView.Nothing)
            + creations.Concat(changes).Count(c => c.Row.Action != ClaimRestoreActionView.Nothing)
            + claimFields.Count;

    private int SelectedRows => rows.Count(r => r.Selected && r.CanApply) + ExportRows.Count(r => r.Selected && r.CanApply);

    /// <summary>
    /// Видимость персонажей, которых создаст это применение (#5677). Умолчания нет, после применения
    /// выбор сбрасывается: каждое нажатие спрашивает заново.
    /// </summary>
    private CharacterVisibility? newCharacterVisibility;

    /// <summary>Среди отмеченного есть создание персонажа — из выгрузки или под заявку из уведомлений.</summary>
    private bool CreatesCharacters
        => creations.Any(r => r.Selected && r.CanApply && r.BlockingProblem is null)
            || rows.Any(r => r.Selected && r.CanApply && r.BlockingProblem is null && r.CreatesCharacterNamed(createdCharacters) is not null);

    private bool VisibilityMissing => CreatesCharacters && newCharacterVisibility is null;

    protected override async Task OnInitializedAsync() => await ReloadPlan();

    private async Task ReloadPlan()
    {
        if (await LoadPlan() is { } error)
        {
            errorMessage = $"Не удалось построить план восстановления: {error}";
        }
    }

    /// <summary>
    /// Перестраивает план по текущим выгрузкам. Если за время запроса начался другой, ответ отбрасывается —
    /// на экране остаётся план по последнему набору выгрузок.
    /// </summary>
    /// <returns>Текст ошибки; null — план обновлён (или его уже обновляет более поздний запрос).</returns>
    private async Task<string?> LoadPlan()
    {
        var version = ++planVersion;
        loadingPlan = true;
        try
        {
            var request = new ClaimRestorePlanRequest(ProjectId, [.. exports.Select(e => e.ToPlanExport()).OfType<MasterExportForPlan>()])
            {
                SlotChoices = [.. slotChoices.Select(c => new NewCharacterSlotChoice(c.Key, c.Value))],
            };
            var plan = await Client.GetPlan(request);
            if (version != planVersion)
            {
                return null;
            }
            ShowPlan(plan);
            planStale = false;
            return null;
        }
        catch (Exception ex)
        {
            if (ex is not ServerProblemException)
            {
                Logger.LogError(ex, "Не удалось построить план восстановления");
            }
            if (version != planVersion)
            {
                return null;
            }
            planStale = model is not null;
            return ex is ServerProblemException ? ex.Message : GenericError;
        }
        finally
        {
            if (version == planVersion)
            {
                loadingPlan = false;
            }
        }
    }

    private void ShowPlan(ClaimRestorePlanViewModel plan)
    {
        model = plan;

        var previous = rows.ToDictionary(r => r.Row.ClaimId);
        rows = [.. model.Rows.Select(r =>
        {
            var editor = new ClaimRestoreRowEditor(r);
            if (previous.TryGetValue(r.ClaimId, out var old))
            {
                editor.CopyEditsFrom(old);
            }
            return editor;
        })];

        var oldGroups = groups.ToDictionary(g => g.Row.GroupId);
        groups = [.. model.Groups.Select(g =>
        {
            var editor = new GroupRestoreRowEditor(g, model.CanEditRoles);
            if (oldGroups.TryGetValue(g.GroupId, out var old))
            {
                editor.CopyEditsFrom(old);
            }
            return editor;
        })];

        creations = CharacterEditors(model.CharacterCreations, creations, model.CanEditRoles);
        changes = CharacterEditors(model.CharacterChanges, changes, model.CanEditRoles);

        var oldClaimFields = claimFields.ToDictionary(c => c.Row.ClaimId);
        claimFields = [.. model.ClaimFields.Select(c =>
        {
            var editor = new ClaimFieldsRestoreRowEditor(c);
            if (oldClaimFields.TryGetValue(c.ClaimId, out var old))
            {
                editor.CopyEditsFrom(old);
            }
            return editor;
        })];
    }

    private static List<CharacterRestoreRowEditor> CharacterEditors(
        IReadOnlyList<CharacterRestoreRowViewModel> plan, List<CharacterRestoreRowEditor> previous, bool canEditRoles)
    {
        var old = previous.ToDictionary(c => c.Row.CharacterId);
        return [.. plan.Select(c =>
        {
            var editor = new CharacterRestoreRowEditor(c, canEditRoles);
            if (old.TryGetValue(c.CharacterId, out var was))
            {
                editor.CopyEditsFrom(was);
            }
            return editor;
        })];
    }

    // ---------- Загрузка выгрузок ----------

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        uploading = true;
        uploadErrors.Clear();
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(MaxFilesAtOnce);
        }
        catch (InvalidOperationException)
        {
            uploadErrors.Add($"За один раз можно загрузить не больше {MaxFilesAtOnce} файлов.");
            uploading = false;
            return;
        }

        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                uploadErrors.Add($"{file.Name}: файл больше 30 МБ.");
                continue;
            }
            try
            {
                await using var stream = file.OpenReadStream(MaxFileSize);
                var result = await Client.ParseExport(ProjectId, file.Name, stream);
                if (result.Export is { } export)
                {
                    exports.Add(new UploadedExport(export));
                }
                else
                {
                    uploadErrors.Add($"{file.Name}: {result.Error?.GetDisplayName() ?? "не удалось разобрать"}.");
                }
            }
            catch (ServerProblemException ex)
            {
                uploadErrors.Add($"{file.Name}: {ex.Message}");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Не удалось загрузить выгрузку {FileName}", file.Name);
                uploadErrors.Add($"{file.Name}: не удалось загрузить файл — {GenericError}.");
            }
        }

        await ReloadPlan();
        uploading = false;
    }

    private async Task OnExportDateChanged(UploadedExport export, string? value)
    {
        export.SetFromLocalInput(value);
        await ReloadPlan();
    }

    private async Task OnSlotChoiceChanged(CharacterIdentification characterId, bool isSlot)
    {
        slotChoices[characterId] = isSlot;
        await ReloadPlan();
    }

    private async Task RemoveExport(UploadedExport export)
    {
        _ = exports.Remove(export);
        await ReloadPlan();
    }

    private RenderFragment ExportsSection() => __builder =>
    {
        <h4>Выгрузки</h4>
        <p class="text-muted">
            Подходят выгрузки списка персонажей и списка заявок, которые делает сам сайт, в формате Excel (xlsx), до 30 МБ. Выгрузки в csv не подходят.
        </p>
        <div class="form-group">
            <InputFile OnChange="OnFilesSelected" multiple accept=".xlsx" disabled="@Busy" class="form-control" />
        </div>
        @if (uploading)
        {
            <JoinLoadingMessage Message="Разбираем выгрузки..." />
        }
        @foreach (var error in uploadErrors)
        {
            <div class="text-danger">@error</div>
        }
        @if (exports.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-bordered table-condensed">
                    <thead>
                        <tr>
                            <th>Файл</th>
                            <th>Что</th>
                            <th>Строк</th>
                            <th>Дата выгрузки</th>
                            <th>Пометки</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var export in exports)
                        {
                            var upload = export.Upload;
                            <tr class="@(export.ExportedAt is null ? "warning" : "")">
                                <td>@upload.FileName</td>
                                <td>@upload.Kind.GetDisplayName()</td>
                                <td>@upload.RowCount</td>
                                <td>
                                    <input type="datetime-local" class="form-control input-sm export-date" value="@export.LocalInputValue" disabled="@Busy"
                                           @onchange="@(e => OnExportDateChanged(export, e.Value as string))" />
                                    @if (export.ExportedAt is null)
                                    {
                                        <div class="text-danger">Укажите дату — без неё выгрузка не учитывается</div>
                                    }
                                    else if (upload.SuggestedDate is not null && upload.SuggestedDate == export.ExportedAt)
                                    {
                                        <div class="text-muted small">из свойств файла</div>
                                    }
                                </td>
                                <td>
                                    @if (upload.ProjectId != ProjectId.Value)
                                    {
                                        <div class="text-danger">Выгрузка из другого проекта (@upload.ProjectId) — учитываться не будет</div>
                                    }
                                    @foreach (var warning in upload.Warnings)
                                    {
                                        <div class="text-warning">@warning.GetDisplayName()</div>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-default btn-xs remove-export" disabled="@Busy" @onclick="@(() => RemoveExport(export))">Убрать</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (model is not null)
        {
            @foreach (var info in model.Exports.Where(e => e.Used && e.Columns.Count > 0))
            {
                <div>
                    <b>Несопоставленные колонки</b> — выгрузка @info.Kind.GetDisplayName().ToLowerInvariant() от @Format(info.ExportedAt)
                    (сопоставлено с полями: @info.MappedCount):
                    <ul>
                        @foreach (var column in info.Columns)
                        {
                            <li>
                                «@column.Header»@(column.FieldName is null ? "" : $" → поле «{column.FieldName}»")
                                @foreach (var warning in column.Warnings)
                                {
                                    <span class="text-muted"> — @warning.GetDisplayName()</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    };

    // ---------- Разделы плана ----------

    private RenderFragment NotesSection() => __builder =>
    {
        if (model is null || model.Notes.Count == 0)
        {
            return;
        }
        <h4>Пометки</h4>
        <ul>
            @foreach (var group in model.Notes.GroupBy(n => (n.ExportedAt, n.Warning)))
            {
                var rowNumbers = group.Select(n => n.RowNumber).OfType<int>().ToList();
                <li>
                    Выгрузка от @Format(group.Key.ExportedAt): @group.Key.Warning.GetDisplayName()
                    @if (rowNumbers.Count > 0)
                    {
                        <span class="text-muted"> (строки @string.Join(", ", rowNumbers))</span>
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment GroupsSection() => __builder =>
    {
        if (groups.Count == 0)
        {
            return;
        }
        <h4>Группы</h4>
        <p class="text-muted">
            Потерянные группы создаются с прежними номерами прямо под корневой группой, скрытыми. Группа становится
            публичной, как только в неё восстанавливается персонаж, видимый всем (публичный или со скрытым игроком).
            Если вы вложили её в другую скрытую группу, та тоже откроется, когда она восстановлена или создана вами
            после аварии; скрытая группа из резервной копии не откроется, и тогда вложенная останется скрытой:
            публичная группа внутри скрытой не допускается.
        </p>
        <div class="table-responsive">
            <table class="table table-bordered table-condensed restore-groups">
                <thead>
                    <tr>
                        <th></th>
                        <th>№ группы</th>
                        <th>Действие</th>
                        <th>Название</th>
                        <th>Выгрузка от</th>
                        <th>Пометки</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in groups)
                    {
                        var r = row.Row;
                        <tr class="@RowClass(row)" @key="r.GroupId">
                            <td>@SelectCheckbox(row)</td>
                            <td>
                                @if (r.CurrentName is not null)
                                {
                                    <a href="@GroupUriLocator.GetUri(r.GroupId)">@r.GroupId.CharacterGroupId</a>
                                }
                                else
                                {
                                    @r.GroupId.CharacterGroupId
                                }
                            </td>
                            <td>@r.Action.GetDisplayName()</td>
                            <td>
                                @if (row.CanApply)
                                {
                                    <input type="text" class="form-control input-sm" value="@row.Name" disabled="@Busy" placeholder="Название группы"
                                           @onchange="@(e => row.Name = e.Value as string ?? "")" />
                                }
                                else
                                {
                                    @(r.CurrentName ?? r.Name)
                                }
                                @if (r.CurrentName is not null && r.Name is not null && r.Name != r.CurrentName)
                                {
                                    <div class="text-muted small">в выгрузке: @r.Name</div>
                                }
                            </td>
