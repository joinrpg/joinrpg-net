    private async Task<bool> ApplyRow(RestoreRowEditorBase row, string? dependencyProblem, Func<Task> apply)
    {
        if ((row.BlockingProblem ?? dependencyProblem) is { } problem)
        {
            row.Succeeded = false;
            row.Error = problem;
            failedCount++;
            return false;
        }
        try
        {
            await apply();
            row.Succeeded = true;
            succeededCount++;
            return true;
        }
        catch (Exception ex)
        {
            row.Succeeded = false;
            row.Error = ApplyErrorText(ex);
            failedCount++;
            return false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ApplyClaims(RestoreDependencies dependencies)
    {
        // Имена новых персонажей, на которых строка упала: персонаж мог успеть создаться, а его id
        // мы не узнали. Следующие строки с тем же именем в этом проходе не трогаем — после обновления
        // плана он найдётся по имени.
        var uncertainNewCharacters = new HashSet<string>(StringComparer.Ordinal);

        foreach (var row in rows.Where(r => r.Selected && r.CanApply).ToList())
        {
            if ((row.BlockingProblem ?? dependencies.CharacterProblem(row.Character)) is { } problem)
            {
                row.Succeeded = false;
                row.Error = problem;
                failedCount++;
                continue;
            }
            var newCharacterName = row.CreatesCharacterNamed(createdCharacters);
            if (newCharacterName is not null && uncertainNewCharacters.Contains(newCharacterName))
            {
                row.Succeeded = false;
                row.Error = $"Персонаж «{newCharacterName}» мог быть создан строкой выше, которая не применилась. Проверьте строку после обновления плана и примените ещё раз.";
                failedCount++;
                continue;
            }
            try
            {
                // Для шаблона в ответе — сам шаблон: следующие строки с этим именем подаются на него.
                var result = await Client.Apply(row.ToApplyRequest(createdCharacters) with { NewCharacterVisibility = newCharacterVisibility });
                if (newCharacterName is not null && result.Character is not null)
                {
                    createdCharacters[newCharacterName] = result.Character;
                }
                if (row.AppliesPlannedStatus)
                {
                    dependencies.Created(row.Row.ClaimId);
                }
                row.Succeeded = true;
                succeededCount++;
            }
            catch (Exception ex)
            {
                if (newCharacterName is not null)
                {
                    _ = uncertainNewCharacters.Add(newCharacterName);
                }
                row.Succeeded = false;
                row.Error = ApplyErrorText(ex);
                failedCount++;
            }
            StateHasChanged();
        }
    }

    /// <summary>Пометка у строки, которую не удалось применить: причину отказа сервера показываем, прочий сбой — в лог.</summary>
    private string ApplyErrorText(Exception ex)
    {
        if (ex is ServerProblemException)
        {
            return ex.Message;
        }
        Logger.LogError(ex, "Не удалось применить строку восстановления");
        return $"Не удалось применить — {GenericError}";
    }

