    // ---------- Применение ----------

    /// <summary>
    /// Новые персонажи (и шаблоны), созданные за время работы со страницей, по имени. Живёт дольше одного
    /// применения: строка, упавшая после создания персонажа, при повторе не должна создать второго.
    /// Найденный планом персонаж всё равно важнее (см. <see cref="ClaimRestoreRowEditor.CopyEditsFrom"/>).
    /// </summary>
    private readonly Dictionary<string, CharacterIdentification> createdCharacters = new(StringComparer.Ordinal);

    private int succeededCount;
    private int failedCount;

    private async Task ApplySelected()
    {
        if (model is null || Busy || planStale || VisibilityMissing)
        {
            return;
        }
        applying = true;
        errorMessage = null;
        successMessage = null;
        succeededCount = 0;
        failedCount = 0;
        foreach (var row in rows)
        {
            row.Succeeded = null;
            row.Error = null;
        }
        foreach (var row in ExportRows)
        {
            row.Succeeded = null;
            row.Error = null;
        }
        StateHasChanged();

        var dependencies = new RestoreDependencies(model);

        foreach (var row in groups.Where(r => r.Selected && r.CanApply).ToList())
        {
            if (await ApplyRow(row, null, () => Client.ApplyGroup(row.ToApplyRequest())))
            {
                dependencies.Created(row.Row.GroupId);
            }
        }

        foreach (var row in creations.Where(r => r.Selected && r.CanApply).ToList())
        {
            var request = row.ToApplyRequest() with { NewCharacterVisibility = newCharacterVisibility };
            if (await ApplyRow(row, dependencies.GroupsProblem(row.GroupsToApply), () => Client.ApplyCharacter(request)))
            {
                dependencies.Created(row.Row.CharacterId);
            }
        }

        await ApplyClaims(dependencies);

        foreach (var row in changes.Where(r => r.Selected && r.CanApply).ToList())
        {
            // Поля от групп не зависят: если группа не создана, не меняем только группы.
            var groupsProblem = dependencies.GroupsProblem(row.GroupsToApply);
            var request = row.ToApplyRequest();
            if (groupsProblem is null)
            {
                _ = await ApplyRow(row, null, () => Client.ApplyCharacter(request));
            }
            else if (request.Fields.Count == 0)
            {
                _ = await ApplyRow(row, groupsProblem, () => Client.ApplyCharacter(request));
            }
            else if (await ApplyRow(row, null, () => Client.ApplyCharacter(request with { Groups = null })))
            {
                row.Error = $"Поля записаны, группы не изменены: {char.ToLowerInvariant(groupsProblem[0])}{groupsProblem[1..]}";
            }
        }

        foreach (var row in claimFields.Where(r => r.Selected && r.CanApply).ToList())
        {
            _ = await ApplyRow(row, dependencies.ClaimProblem(row.Row.ClaimId), () => Client.ApplyClaimFields(row.ToApplyRequest()));
        }

        // Применение создаёт персонажей; селекторы в новых строках плана должны их увидеть.
        SelectorListCache.Clear();
        var reloadError = await LoadPlan() is { } error
            ? $"Не удалось обновить план: {error}. Обновите страницу."
            : null;

        var summary = failedCount == 0
            ? $"Применено строк: {succeededCount}."
            : $"Применено строк: {succeededCount}. Не удалось применить: {failedCount} — см. пометки в таблицах.";
        if (failedCount == 0 && reloadError is null)
        {
            successMessage = summary;
        }
        else
        {
            errorMessage = reloadError is null ? summary : $"{summary} {reloadError}";
        }

        newCharacterVisibility = null;
        applying = false;
        StateHasChanged();
    }

