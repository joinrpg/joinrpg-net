@using JoinRpg.Web.ProjectMasterTools.Settings
@inherits SettingsPanelBase<FinanceGeneralSettingsViewModel>
@inject IFinanceSettingsClient settingsClient
@inject ILogger<FinanceGeneralSettingsPanel> logger

@* В архиве сохранить нельзя — панель не показываем, как и панели настроек проекта. *@
@if (Model is { ProjectStatus: ProjectLifecycleStatus.Archived })
{
    return;
}

<JoinCollapsePanel Id="@AnchorId">
    <Header>Общие настройки</Header>
    <ChildContent>
        @if (loadError is not null)
        {
            <JoinAlert Variation="VariationStyleEnum.Danger">@loadError</JoinAlert>
            return;
        }
        @if (Model is null)
        {
            <JoinLoadingMessage />
            return;
        }
        <EditForm FormName="FinanceGeneralSettings" EditContext="@editContext" OnSubmit="HandleSubmit">
            <FormHorizontal>
                <ValidationSummary Model="Model" />
                <DataAnnotationsValidator />
                <fieldset disabled="@(!Model.HasEditAccess)">
                    <FormRowFor For="@(() => Model.WarnOnOverPayment)">
                        <CheckboxInput @bind-Value="Model.WarnOnOverPayment" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.PreferentialFeeEnabled)">
                        <CheckboxInput @bind-Value="Model.PreferentialFeeEnabled" />
                    </FormRowFor>
                    <FormRowFor For="@(() => Model.PreferentialFeeConditions)">
                        <JoinMarkdownTextArea @bind-Value="Model.PreferentialFeeConditions" Rows="4" />
                    </FormRowFor>
                </fieldset>
                <SettingsSaveRow HasEditAccess="Model.HasEditAccess" Permission="Permission.CanManageMoney" Disabled="@formInvalid" />
            </FormHorizontal>
        </EditForm>
        @if (success)
        {
            <JoinAlert Variation="VariationStyleEnum.Success">Общие настройки финансов сохранены</JoinAlert>
        }
    </ChildContent>
</JoinCollapsePanel>

@code {
    /// <summary>Якорь панели на странице настройки финансов.</summary>
    public const string AnchorId = "finance-general";

    [Parameter]
    public ProjectIdentification ProjectId { get; set; } = null!;

    private string? loadError;

    // Настройки грузятся в базе SettingsPanelBase, но её исключение уронило бы весь остров
    // страницы — ловим здесь, чтобы остальные панели работали.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
        }
        catch (Exception exception)
        {
            logger.LogError(exception, "Ошибка при загрузке общих настроек финансов проекта {ProjectId}", ProjectId);
            loadError = "Не удалось загрузить общие настройки. Обновите страницу и попробуйте ещё раз.";
        }
    }

    protected override Task<FinanceGeneralSettingsViewModel> LoadModel() => settingsClient.GetGeneralSettings(ProjectId);

    protected override Task SaveModel(FinanceGeneralSettingsViewModel model) => settingsClient.SaveGeneralSettings(model);
}
