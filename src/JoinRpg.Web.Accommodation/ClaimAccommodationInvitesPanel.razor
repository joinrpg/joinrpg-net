@* Панель приглашений к совместному проживанию. Одна и та же для полученных и отправленных — *@
@* различия только в заголовке и наборе кнопок, поэтому направление задаётся параметром. *@
@using JoinRpg.Helpers
@inject IAccommodationInviteClient Client
@inject NavigationManager NavigationManager
@inject ILogger<ClaimAccommodationInvitesPanel> Logger

@* Приглашений нет — панель не показываем вовсе *@
@if (Invites.Count > 0)
{
    <JoinPanel>
        <Header>@Caption</Header>
        <Body>
            <table class="table" style="margin: 0;">
                @foreach (var invite in Invites)
                {
                    <tr @key="invite.InviteId">
                        <td style="vertical-align: middle; border: none;">
                            <UserLink Model="@invite.Counterparty" />
                        </td>
                        @* Мастер видит приглашения без кнопок: отвечает только сам игрок (#5656) *@
                        @if (invite.State == InviteState.Unanswered && invite.CanRespond)
                        {
                            <td style="border: none;">
                                <div style="display: flex; flex-direction: row; align-items: center;">
                                    @if (Direction == InviteDirection.Incoming)
                                    {
                                        <span style="margin-right: 1em;">
                                            <JoinButton Label="Принять"
                                                        Icon="JoinIconType.Approve"
                                                        Size="SizeStyleEnum.Small"
                                                        AutoConfirm="true"
                                                        AutoConfirmMessage="Принять приглашение к совместному проживанию?"
                                                        OnClick="@(args => Act(args, () => Client.AcceptInvite(invite.InviteId), "Не удалось принять приглашение"))" />
                                        </span>
                                        <JoinButton Label="Отклонить"
                                                    Icon="JoinIconType.Decline"
                                                    Size="SizeStyleEnum.Small"
                                                    AutoConfirm="true"
                                                    AutoConfirmMessage="Отклонить приглашение к совместному проживанию?"
                                                    OnClick="@(args => Act(args, () => Client.DeclineInvite(invite.InviteId), "Не удалось отклонить приглашение"))" />
                                    }
                                    else
                                    {
                                        <JoinButton Label="Отозвать"
                                                    Icon="JoinIconType.Decline"
                                                    Size="SizeStyleEnum.Small"
                                                    AutoConfirm="true"
                                                    AutoConfirmMessage="Отменить приглашение к совместному проживанию?"
                                                    OnClick="@(args => Act(args, () => Client.CancelInvite(invite.InviteId), "Не удалось отозвать приглашение"))" />
                                    }
                                </div>
                            </td>
                        }
                        else
                        {
                            <td class="@invite.State.GetAppropriateTextStyle()" style="border: none;">@invite.State.GetDescription()</td>
                        }
                    </tr>
                }
            </table>
            @if (errorMessage is not null)
            {
                <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
            }
        </Body>
    </JoinPanel>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyCollection<AccommodationInviteViewModel> Invites { get; set; } = null!;

    [Parameter, EditorRequired]
    public InviteDirection Direction { get; set; }

    private string? errorMessage;

    private string Caption => Direction switch
    {
        InviteDirection.Incoming => "Полученные приглашения к совместному проживанию",
        InviteDirection.Outgoing => "Отправленные приглашения к совместному проживанию",
        _ => throw new ArgumentOutOfRangeException(nameof(Direction)),
    };

    private async Task Act(ButtonClickEventArgs args, Func<Task> action, string failureText)
    {
        try
        {
            await action();
            // Ответ на приглашение меняет и панель проживания, и оба списка — перезагружаем страницу целиком
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException exception)
        {
            // Отказ сервера (приглашение уже отозвано, проект в архиве) — с понятной игроку причиной
            errorMessage = exception.Message;
            args.ExitProgressState = true;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка операции с приглашением к проживанию: {FailureText}", failureText);
            errorMessage = $"{failureText}. Попробуйте ещё раз.";
            args.ExitProgressState = true;
        }
    }
}
