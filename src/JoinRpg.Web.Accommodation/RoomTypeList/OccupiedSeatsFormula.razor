@* Не «вместимость × комнаты»: полную комнату может заполнить и тип с меньшей вместимостью (ADR020),
   так что выводим само число жильцов полных комнат. *@
@if (Occupancy.PoolOccupied == 0)
{
    <div>Занято: нет</div>
}
else
{
    <div>
        @("Занято: ")<Tooltip Title="@RoomTypeListItemViewModel.FullyOccupiedSeatsTooltip">@Occupancy.FullyOccupiedSeats</Tooltip>
        @if (Occupancy.PartialRoomsCount > 0)
        {
            @(" + ")<Tooltip Title="@RoomTypeListItemViewModel.PartialOccupiedSeatsTooltip">@Occupancy.PartialOccupiedSeats</Tooltip>
        }
        @(" = ")<Tooltip Title="@RoomTypeListItemViewModel.TotalOccupiedTooltip">@Occupancy.PoolOccupied</Tooltip>
    </div>
}

@code {
    [Parameter, EditorRequired] public RoomTypeOccupancySummary Occupancy { get; set; } = null!;
}
