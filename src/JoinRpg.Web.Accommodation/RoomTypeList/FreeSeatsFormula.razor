@* «вместимость × пустые комнаты + свободные места в частично занятых = всего свободно» *@
@if (Occupancy.FreeCapacity == 0)
{
    <div>Свободно: нет</div>
}
else
{
    <div>
        @("Свободно: ")<Tooltip Title="@RoomTypeListItemViewModel.CapacityTooltip">@Occupancy.Capacity</Tooltip>
        @(" ✕ ")<Tooltip Title="@RoomTypeListItemViewModel.FullyFreeRoomsTooltip">@Occupancy.FullyFreeRoomsCount</Tooltip>
        @if (Occupancy.PartialRoomsCount > 0)
        {
            @(" + ")<Tooltip Title="@RoomTypeListItemViewModel.PartialFreeSeatsTooltip">@Occupancy.PartialFreeSeats</Tooltip>
        }
        @(" = ")<Tooltip Title="@RoomTypeListItemViewModel.TotalFreeTooltip">@Occupancy.FreeCapacity</Tooltip>
    </div>
}

@code {
    [Parameter, EditorRequired] public RoomTypeOccupancySummary Occupancy { get; set; } = null!;
}
