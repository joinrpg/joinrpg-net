@* Остров на статической странице «Поселение»: выселение — мутация, поэтому идёт POST-ом через API. *@
@using JoinRpg.Web.Accommodation.Rooms
@inject IAccommodationRoomsClient Client
@inject NavigationManager NavigationManager
@inject ILogger<UnOccupyAllButton> Logger

<JoinButton Icon="JoinIconType.EvictAll" Label="Выселить всех" ProgressLabel="Выселяем..."
            AutoConfirm="true"
            AutoConfirmMessage="Вы точно уверены, что хотите выселить ВСЕХ участников из ВСЕХ комнат ВСЕХ типов?"
            OnClick="UnOccupyAll" />
<JoinMessageDialog @ref="errorDialog" Type="MessageDialogType.Fail">@error</JoinMessageDialog>

@code {
    [Parameter, EditorRequired] public ProjectIdentification ProjectId { get; set; } = null!;

    private JoinMessageDialog errorDialog = null!;
    private string error = "";

    private async Task UnOccupyAll(ButtonClickEventArgs args)
    {
        try
        {
            await Client.UnOccupyAll(ProjectId);
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException exception)
        {
            // Например, проект заблокирован — причину показываем как есть
            ShowError(args, $"Произошла ошибка при выселении: {exception.Message}");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при выселении всех в проекте {ProjectId}", ProjectId);
            ShowError(args, "Произошла ошибка при выселении");
        }
    }

    private void ShowError(ButtonClickEventArgs args, string text)
    {
        error = text;
        args.ExitProgressState = true;
        StateHasChanged();
        _ = errorDialog.ShowModalAsync();
    }
}
