@* Бейдж оплаты группы проживающих: зелёный — оплачено всё, жёлтый — оплачено от 25%, красный — меньше. *@
<span class="badge acc-payment alert-@CssClass" title="@Title"><JoinIcon Icon="JoinIconType.FeePaid" /><span class="price-value price-RUR">@(-Group.FeeToPay)</span></span>

@code {
    [Parameter, EditorRequired]
    public AccommodationGroupViewModel Group { get; set; } = null!;

    private string CssClass => GetCssClass(Group.FeeToPay, Group.FeeTotal);

    private string Title => Group.FeeToPay > 0
        ? $"Не оплачено {Group.FeeToPay} из {Group.FeeTotal}"
        : "Все оплачено полностью";

    /// <summary>
    /// Цвет бейджа по доле оплаченного: зелёный — оплачено всё (в том числе бесплатное проживание),
    /// жёлтый — оплачено 25% и больше, но не всё, красный — оплачено меньше 25% или ничего.
    /// </summary>
    internal static string GetCssClass(int feeToPay, int feeTotal)
    {
        if (feeToPay <= 0)
        {
            return "success";
        }
        if (feeTotal <= 0)
        {
            // Долг при нулевой стоимости быть не должен, но делить на ноль не будем.
            return "danger";
        }
        var paidPercent = 100 * (feeTotal - feeToPay) / feeTotal;
        return paidPercent >= 25 ? "warning" : "danger";
    }
}
