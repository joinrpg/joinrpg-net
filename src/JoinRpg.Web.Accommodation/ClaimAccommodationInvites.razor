@* Полученные и отправленные приглашения к совместному проживанию на странице заявки. *@
@inject IAccommodationInviteClient Client

@* Пока не загрузились — панели не показываем *@
@if (incoming is not null)
{
    <ClaimAccommodationInvitesPanel Invites="@incoming" Direction="InviteDirection.Incoming" />
}
@if (outgoing is not null)
{
    <ClaimAccommodationInvitesPanel Invites="@outgoing" Direction="InviteDirection.Outgoing" />
}

@code {
    // Оба направления — в одном острове и в разных свойствах. Ключ PersistentState считается
    // по типу компонента и имени свойства, поэтому два экземпляра одного острова на странице
    // сохраняли состояние под одним ключом: пререндер падал, а WASM читал чужой список (#5670).
    [PersistentState]
    public IReadOnlyCollection<AccommodationInviteViewModel>? incoming { get; set; }

    [PersistentState]
    public IReadOnlyCollection<AccommodationInviteViewModel>? outgoing { get; set; }

    [Parameter, EditorRequired]
    public ClaimIdentification ClaimId { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        incoming ??= await Client.GetInvites(ClaimId, InviteDirection.Incoming);
        outgoing ??= await Client.GetInvites(ClaimId, InviteDirection.Outgoing);
    }
}
