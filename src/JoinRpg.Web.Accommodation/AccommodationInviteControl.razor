@* Приглашение к совместному проживанию. Раньше жило в Views/Claim/_ClaimAccommodation.cshtml. *@
@* Мастер с правом расселять не приглашает за игрока, а сразу поселяет вместе (#5656). *@
@inject IAccommodationInviteClient Client
@inject NavigationManager NavigationManager

@if (errorMessage is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
}

<div style="display: flex; flex-direction: row; align-items: center; margin-top: 0.5em;">
    <AccommodationInviteTargetSelector ClaimId="@ClaimId"
                                       Value="@selectedTarget"
                                       ValueChanged="@HandleTargetChanged"
                                       ModeChanged="@HandleModeChanged" />
    @if (mode == AccommodationInviteMode.Invite)
    {
        <span style="margin-left: 1em;">
            <JoinButton Label="Пригласить"
                        Style="VariationStyleEnum.Success"
                        Size="SizeStyleEnum.Small"
                        Disabled="@(selectedTarget is null)"
                        DisabledTitle="Сначала выберите, кого пригласить"
                        AutoConfirm="true"
                        AutoConfirmMessage="Отправить приглашение на совместное проживание?"
                        OnClick="@(args => Act(args, Client.CreateInvite))" />
        </span>
    }
    else if (mode == AccommodationInviteMode.Merge)
    {
        <span style="margin-left: 1em;">
            <JoinButton Label="Поселить вместе"
                        Style="VariationStyleEnum.Success"
                        Size="SizeStyleEnum.Small"
                        Disabled="@(selectedTarget is null)"
                        DisabledTitle="Сначала выберите, кого поселить вместе"
                        AutoConfirm="true"
                        AutoConfirmMessage="Объединить в одну группу проживания? Игроки получат уведомление."
                        OnClick="@(args => Act(args, Client.MergeGroups))" />
        </span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ClaimIdentification ClaimId { get; set; } = null!;

    private AccommodationGroupIdentification? selectedTarget;
    private AccommodationInviteMode mode;
    private string? errorMessage;

    private void HandleModeChanged(AccommodationInviteMode value) => mode = value;

    private void HandleTargetChanged(AccommodationGroupIdentification? target)
    {
        selectedTarget = target;
        errorMessage = null;
    }

    private async Task Act(
        ButtonClickEventArgs args,
        Func<ClaimIdentification, AccommodationGroupIdentification, Task> action)
    {
        if (selectedTarget is null)
        {
            args.ExitProgressState = true;
            return;
        }

        try
        {
            await action(ClaimId, selectedTarget);
            // Приглашение меняет панели «приглашения», объединение — соседей: перезагружаем страницу целиком
            NavigationManager.Refresh(forceReload: true);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            args.ExitProgressState = true;
        }
    }
}
