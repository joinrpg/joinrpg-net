@* Форма создания и изменения типа проживания. Режим задаёт RoomTypeId: null — создание. *@
@using Microsoft.AspNetCore.Components.Forms
@inject IRoomTypeEditClient Client
@inject IAccommodationUriLocator UriLocator
@inject NavigationManager NavigationManager
@inject ILogger<RoomTypeEditForm> Logger

@if (model is null)
{
    <JoinLoadingMessage />
}
else
{
    <EditForm Model="model" OnValidSubmit="OnSave">
        <DataAnnotationsValidator />
        @* Отступ от вкладок страницы изменения — как был у MVC-формы. *@
        <div style="margin-top: 1em;">
            <FormHorizontal>
                @if (errorMessage is not null)
                {
                    <div class="text-danger">@errorMessage</div>
                }

                <FormRowFor For="@(() => model.Name)">
                    <JoinTextInput @bind-Value="model.Name" />
                </FormRowFor>

                @if (RoomTypeId is null)
                {
                    @* Категория выбирается один раз, при создании: перенос типа в другую категорию
                       означал бы переселение его жильцов (ADR020, §4). *@
                    <FormRowFor For="@(() => model.RoomCategoryChoice)">
                        <InputRadioGroup @bind-Value="model.RoomCategoryChoice">
                            <div class="radio">
                                <label>
                                    <InputRadio Value="RoomCategoryChoice.New" id="roomtype-category-new" />
                                    Новая категория комнат
                                </label>
                            </div>
                            <div style="margin-left: 20px;">
                                <JoinTextInput @bind-Value="model.NewRoomCategoryName"
                                               placeholder="Название категории (если пусто — как у типа)" />
                            </div>
                            @if (model.RoomCategories.Count > 0)
                            {
                                <div class="radio">
                                    <label>
                                        <InputRadio Value="RoomCategoryChoice.Existing" id="roomtype-category-existing" />
                                        Существующая категория — комнаты будут общими с её типами
                                    </label>
                                </div>
                                <div style="margin-left: 20px;">
                                    <InputSelect @bind-Value="model.ExistingRoomCategoryId" class="form-control" id="roomtype-category-id">
                                        <option value="">— выберите категорию —</option>
                                        @foreach (var category in model.RoomCategories)
                                        {
                                            <option value="@category.Id">@CategoryTitle(category)</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => model.ExistingRoomCategoryId)" />
                                </div>
                            }
                        </InputRadioGroup>
                    </FormRowFor>
                }
                else if (model.RoomCategory is { } roomCategory)
                {
                    <FormRow Label="Категория комнат">
                        <p class="form-control-static">
                            @roomCategory.Name
                            @if (roomCategory.TypeNames.Count > 0)
                            {
                                @* Пробел выражением: пробельный текст между тегами Blazor вырезает. *@
                                @(" ")<span class="text-muted">(комнаты общие с: @string.Join(", ", roomCategory.TypeNames))</span>
                            }
                        </p>
                    </FormRow>
                }

                <FormRowFor For="@(() => model.Cost)">
                    <JoinInputNumber @bind-Value="model.Cost"
                                     ParsingErrorMessage="Укажите цену за 1 место целым числом" />
                </FormRowFor>

                <FormRowFor For="@(() => model.Capacity)">
                    <JoinInputNumber @bind-Value="model.Capacity"
                                     ParsingErrorMessage="Укажите количество мест в номере — целое число от 1 до 1000" />
                </FormRowFor>

                <FormRowFor For="@(() => model.IsPlayerSelectable)">
                    <CheckboxInput @bind-Value="model.IsPlayerSelectable" />
                </FormRowFor>

                <FormRowFor For="@(() => model.Description)">
                    <JoinTextArea @bind-Value="model.Description" cols="100" />
                    <div class="help-block">Можно использовать <a href="https://commonmark.org/help/" target="_blank">MarkDown</a> (**<b>полужирный</b>**, _<i>курсив</i>_)</div>
                </FormRowFor>

                <FormRow Label="">
                    <button type="submit" class="btn btn-success" disabled="@saving">@(RoomTypeId is null ? "Добавить" : "Сохранить")</button>
                    <a href="@ListUri" class="btn btn-default">Назад к списку типов поселения</a>
                </FormRow>
            </FormHorizontal>
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    /// <summary>
    /// Изменяемый тип проживания. <c>null</c> — форма создания нового типа.
    /// </summary>
    [Parameter]
    public AccommodationTypeIdentification? RoomTypeId { get; set; }

    [PersistentState]
    public RoomTypeEditViewModel? model { get; set; }

    private string? errorMessage;
    private bool saving;

    private string ListUri => UriLocator.GetRoomTypesListUri(ProjectId).ToString();

    protected override async Task OnInitializedAsync()
    {
        model ??= RoomTypeId is null ? await Client.GetNewRoomType(ProjectId) : await Client.GetRoomType(RoomTypeId);
    }

    private static string CategoryTitle(RoomCategoryOptionViewModel category)
        => category.TypeNames.Count > 0 ? $"{category.Name} ({string.Join(", ", category.TypeNames)})" : category.Name;

    private async Task OnSave()
    {
        saving = true;
        errorMessage = null;
        try
        {
            if (RoomTypeId is null)
            {
                await Client.CreateRoomType(ProjectId, model!);
            }
            else
            {
                await Client.UpdateRoomType(RoomTypeId, model!);
            }

            // Список типов — MVC-страница, поэтому переход полной загрузкой.
            NavigationManager.NavigateTo(ListUri, forceLoad: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось сохранить тип проживания");
            errorMessage = exception is InvalidOperationException
                ? exception.Message
                : "Не удалось сохранить тип поселения. Попробуйте ещё раз.";
        }
        finally
        {
            saving = false;
        }
    }
}
