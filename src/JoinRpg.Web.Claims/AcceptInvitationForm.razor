@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject IClaimOperationClient ClaimClient
@inject NavigationManager NavigationManager
@inject ILogger<AcceptInvitationForm> Logger

@* Обёртка .collapse раскрывается кнопкой через Bootstrap (data-target="#acceptInvitationActionPanel"). *@
@* margin-top повторяет отступ, который Bootstrap даёт соседним панелям через .panel-group .panel + .panel. *@
<div class="collapse" id="acceptInvitationActionPanel" style="margin-top: 5px">
    <JoinPanel>
        <Header>Принятие приглашения</Header>
        <Body>
            @if (loading)
            {
                <JoinLoadingMessage Message="Принимаем приглашение..." />
            }
            else
            {
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
                }

                <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
                    <FormHorizontal>
                        <FormRowFor For="@(() => model.CommentText)">
                            <JoinMarkdownTextArea @bind-Value="model.CommentText" Placeholder="Комментарий (необязательно)" />
                        </FormRowFor>

                        @if (RequestedSensitiveData.IsAnyRequested())
                        {
                            <FormRowFor For="@(() => model.SensitiveDataAllowed)">
                                <CheckboxInput @bind-Value="model.SensitiveDataAllowed" />
                                <div class="help-block">@RequestedSensitiveData.ConsentDescription()</div>
                            </FormRowFor>
                        }

                        <FormRow>
                            <JoinButton Submit="true" Preset="ButtonPreset.Save" Label="Принять приглашение"
                                        ProgressLabel="Принимаем..." InProgress="@loading" AutoProgress="false" />
                        </FormRow>
                    </FormHorizontal>
                </EditForm>
            }
        </Body>
    </JoinPanel>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public ClaimIdentification ClaimId { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public RequestedSensitiveDataView RequestedSensitiveData { get; set; } = null!;

    private sealed class FormModel
    {
        [Display(Name = "Комментарий")]
        public string CommentText { get; set; } = "";

        // Пояснение зависит от того, что запросил проект, — выводится в разметке, а не через Description.
        [Display(Name = "Предоставить доступ к защищённым данным")]
        public bool SensitiveDataAllowed { get; set; }
    }

    private readonly FormModel model = new();
    private bool loading;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        loading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            await ClaimClient.AcceptInvitation(ClaimId, new AcceptInvitationRequest(model.CommentText, model.SensitiveDataAllowed));
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException ex)
        {
            // Отказ сервера (например, проект заблокирован) — текст предназначен игроку
            ShowError(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при принятии приглашения по заявке {ClaimId}", ClaimId);
            ShowError("Не удалось принять приглашение. Обновите страницу и попробуйте ещё раз.");
        }
    }

    private void ShowError(string text)
    {
        errorMessage = text;
        loading = false;
        StateHasChanged();
    }
}
