@using JoinRpg.DomainTypes.Characters.Claims.Finances
<JoinBadge Variation="@variation">
    <ChildContent>@Model.FeePaid / @Model.TotalFee</ChildContent>
    <TooltipContent><ClaimBalanceStatus Model="Model" PlainText="true" /></TooltipContent>
</JoinBadge>


@code {

    [Parameter]
    [EditorRequired]
    public ClaimBalance Model { get; set; }

    private VariationStyleEnum variation;

    protected override void OnParametersSet()
    {
        // Не оплачен — красный, недооплата — жёлтый, переплата — зелёный, как в заявке
        // (ClaimBalanceStatus); полностью оплаченный — нейтральный, как здесь было раньше.
        variation = Model.PaymentStatus switch
        {
            ClaimPaymentStatus.NotPaid => VariationStyleEnum.Danger,
            ClaimPaymentStatus.MoreToPay => VariationStyleEnum.Warning,
            ClaimPaymentStatus.Overpaid => VariationStyleEnum.Success,
            _ => VariationStyleEnum.Primary,
        };
        base.OnParametersSet();
    }

}
