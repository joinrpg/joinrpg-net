@* Ручное назначение размера базового взноса заявки. *@
@using JoinRpg.Common.WebComponents.Dialog
@inject IChangeFeeClient Client
@inject NavigationManager NavigationManager
@inject ILogger<ChangeFeeButton> Logger

<JoinButton Label="Изменить вручную…"
            Size="@Size"
            AutoProgress="false"
            OnClick="OpenDialog" />

@* Кнопка своя, а не Buttons диалога: те закрывают окно сразу, а при отказе сервера окно должно остаться с введённым значением *@
<JoinDialog @ref="dialog" Caption="Изменение суммы взноса" Width="600px" MaxWidth="95%" ShowCloseButton="@(!inProgress)">
    <ChildContent>
        <JoinAlert Variation="VariationStyleEnum.Info">
            <p>Размер взноса для этой заявки будет назначен вручную.</p>
            <p>После этого взнос не будет больше зависеть от времени сдачи и будет зафиксирован.</p>
        </JoinAlert>

        @if (View.HasFieldsWithFee)
        {
            <JoinAlert Variation="VariationStyleEnum.Warning">
                Эта настройка меняет только базовое значение взноса. Итоговая сумма взноса складывается из установленного вручную взноса и суммы модификаторов от полей.
            </JoinAlert>
        }

        @if (errorMessage is not null)
        {
            <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
        }

        <div class="form-group">
            <label for="change-fee-value">Новый размер взноса</label>
            <input id="change-fee-value" type="number" class="form-control" @bind="feeValue" list="change-fee-variants" />
            <datalist id="change-fee-variants">
                @foreach (var variant in View.FeeVariants)
                {
                    <option value="@variant" />
                }
            </datalist>
        </div>
    </ChildContent>
    <FooterContent>
        @* Стили футера JoinDialog — scoped и на эту разметку не действуют; перенос нужен на узком экране *@
        <div style="display: flex; flex-wrap: wrap; gap: 0.5em; justify-content: flex-end; flex: 1 1 auto; min-width: 0;">
        <JoinButton Preset="ButtonPreset.Cancel" AutoProgress="false" Disabled="@inProgress" OnClick="CloseDialog" />
        <JoinButton Label="Изменить" Icon="JoinIconType.Ok" Style="VariationStyleEnum.Info" AutoProgress="false"
                    InProgress="@inProgress" Disabled="@inProgress" OnClick="Submit" />
        </div>
    </FooterContent>
</JoinDialog>

@code {
    [Parameter, EditorRequired]
    public ChangeFeeView View { get; set; } = null!;

    /// <summary>В плотных финансовых таблицах — XS, как соседние.</summary>
    [Parameter]
    public SizeStyleEnum Size { get; set; } = SizeStyleEnum.ExtraSmall;

    private JoinDialog dialog = default!;
    private string feeValue = "";
    private string? errorMessage;
    private bool inProgress;

    private void OpenDialog()
    {
        feeValue = View.BaseFee.ToString();
        errorMessage = null;
        dialog.ShowModal();
    }

    private void CloseDialog() => dialog.Close();

    private async Task Submit()
    {
        errorMessage = null;
        if (!int.TryParse(feeValue, out var fee) || fee < 0)
        {
            errorMessage = "Введите корректную сумму взноса (целое число не меньше нуля).";
            return;
        }

        inProgress = true;
        try
        {
            await Client.ChangeFee(View.ClaimId, new ChangeFeeRequest(fee));
            // Взнос влияет на баланс и статус заявки на странице, поэтому перезагружаем её целиком
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException exception)
        {
            // Ожидаемый отказ сервера (нет прав) — текст предназначен мастеру
            errorMessage = exception.Message;
            inProgress = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Не удалось сохранить новый размер взноса для заявки {ClaimId}", View.ClaimId);
            errorMessage = "Не удалось сохранить. Обновите страницу и попробуйте ещё раз.";
            inProgress = false;
        }
    }
}
