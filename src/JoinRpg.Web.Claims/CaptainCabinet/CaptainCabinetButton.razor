@using JoinRpg.Web.ProjectCommon.Claims
@using JoinRpg.Web.ProjectCommon.Projects
@inject IProjectUriLocator uriLocator

<JoinButton Link="@uri.ToString()" Size="@Size" Title="Информация о персонажах в вашей команде" Preset="ButtonPreset.Claim" Label="Кабинет капитана" Style="VariationStyleEnum.None" />

@code {
    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    /// <summary>Размер кнопки. Если не задан — размер окружающей <see cref="JoinButtonGroup"/>, вне группы обычный.</summary>
    [Parameter]
    public SizeStyleEnum? Size { get; set; }

    private Uri uri = null!;

    protected override void OnParametersSet()
    {
        uri = uriLocator.GetCaptainCabinetUri(ProjectId);
        base.OnParametersSet();
    }
}
