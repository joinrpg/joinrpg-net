@using JoinRpg.Common.WebComponents.Dialog
@inject IClaimOperationClient ClaimClient;
@inject NavigationManager NavigationManager;
@inject ILogger<AllowSensitiveDataButton> Logger
<JoinButton
  Preset="ButtonPreset.Profile"
  Label="Разрешить доступ к защищённым данным"
  AutoConfirm="true"
  AutoConfirmMessage="@RequestedSensitiveData.AllowConfirmation()"
  OnClick="OnClick"
  />
<JoinMessageDialog @ref="errorDialog" Type="MessageDialogType.Fail">@error</JoinMessageDialog>
@code {
    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public RequestedSensitiveDataView RequestedSensitiveData { get; set; } = null!;

    private JoinMessageDialog errorDialog = null!;
    private string error = "";

    private async Task OnClick(ButtonClickEventArgs args)
    {
        try
        {
            await ClaimClient.AllowSensitiveData(ProjectId);
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException exception)
        {
            // Например, проект заблокирован — причину показываем как есть
            ShowError(args, $"Не удалось разрешить доступ к защищённым данным: {exception.Message}");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при разрешении доступа к защищённым данным в проекте {ProjectId}", ProjectId);
            ShowError(args, "Не удалось разрешить доступ к защищённым данным");
        }
    }

    private void ShowError(ButtonClickEventArgs args, string text)
    {
        error = text;
        // Страница не перезагрузится — кнопку надо вывести из состояния «в процессе», иначе повторить нельзя.
        args.ExitProgressState = true;
        StateHasChanged();
        _ = errorDialog.ShowModalAsync();
    }
}
