@using JoinRpg.Web.ProjectCommon
@using JoinRpg.Common.WebComponents
@using Microsoft.AspNetCore.Components.Forms
@using JoinRpg.DomainTypes.ProjectMetadata
@inject IInvitePlayerClient InvitePlayerClient
@inject NavigationManager NavigationManager

@if (loading)
{
    <JoinLoadingMessage Message="Отправка приглашения..." />
    return;
}

<JoinPanel>
    <Header>Пригласить игрока</Header>
    <Body>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <JoinAlert Variation="VariationStyleEnum.Success">@successMessage</JoinAlert>
        }

        <EditForm Model="@model" OnValidSubmit="@HandleSubmit">
           <FormHorizontal>
                <DataAnnotationsValidator />
                <ValidationSummary />

                <FormRowFor For="@(() => model.CharacterId)" Required="true">
                    <SingleCharacterSelector @bind-SelectedCharacterId="@selectedCharacterId" ProjectId="@ProjectId" AllowEmpty="false" ListType="@characterListType" />
                </FormRowFor>

                <FormRowFor For="@(() => model.UserLinks)" Required="true">
                    <JoinUserLinkEditor Multiple="true" Values="@model.UserLinks" ValuesChanged="@OnUserLinksChanged" />
                </FormRowFor>

                <FormRowFor For="@(() => model.ClaimText)">
                    <InputTextArea @bind-Value="model.ClaimText" class="form-control" rows="4" />
                </FormRowFor>

                <FormRow>
                    <JoinButton Submit="true" Preset="ButtonPreset.Save" Label="Пригласить" ProgressLabel="Приглашаем..." InProgress="@loading" AutoProgress="false" />
                </FormRow>
            </FormHorizontal>
        </EditForm>
    </Body>
</JoinPanel>

@code {
    [Parameter]
    [EditorRequired]
    public ProjectIdentification ProjectId { get; set; }

    [Parameter]
    public CharacterIdentification? PreselectedCharacterId { get; set; }

    private InvitePlayerViewModel model = new();
    private bool loading = false;
    private string? errorMessage = null;
    private string? successMessage = null;

    private CharacterListType characterListType =>
        HasMultiplePlayers(model.UserLinks) ? CharacterListType.AvailableTemplates : CharacterListType.Available;

    private static bool HasMultiplePlayers(List<string> userLinks) => userLinks.Count(l => !string.IsNullOrWhiteSpace(l)) > 1;

    private void OnUserLinksChanged(List<string> newUserLinks)
    {
        var wasMultiplePlayers = HasMultiplePlayers(model.UserLinks);
        model.UserLinks = newUserLinks;
        if (HasMultiplePlayers(model.UserLinks) && !wasMultiplePlayers)
        {
            // Список персонажей сузился до шаблонов — ранее выбранный персонаж мог в него не попасть.
            model.CharacterId = 0;
        }
    }

    private CharacterIdentification? selectedCharacterId
    {
        get => model.CharacterId > 0 ? new CharacterIdentification(ProjectId, model.CharacterId) : null;
        set
        {
            if (value is null)
            {
                model.CharacterId = 0;
            }
            else
            {
                if (value.ProjectId == ProjectId)
                {
                    model.CharacterId = value.CharacterId;
                }
            }
        }
    }

    protected override void OnInitialized()
    {
        model.ProjectId = ProjectId;
        if (PreselectedCharacterId is not null && PreselectedCharacterId.ProjectId == ProjectId)
        {
            model.CharacterId = PreselectedCharacterId.CharacterId;
        }
        base.OnInitialized();
    }

    private async Task HandleSubmit()
    {
        loading = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        var succeeded = new List<ClaimIdentification>();
        var failed = new List<(string UserLink, string Message)>();

        foreach (var userLink in model.UserLinks)
        {
            try
            {
                var claimId = await InvitePlayerClient.InvitePlayer(model.CharacterIdentification, userLink, model.ClaimText);
                succeeded.Add(claimId);
            }
            catch (Exception ex)
            {
                failed.Add((userLink, ex.Message));
            }
        }

        if (failed.Count == 0)
        {
            var lastClaimId = succeeded[^1];
            successMessage = succeeded.Count == 1
                ? $"Игрок успешно приглашён. Заявка создана: {lastClaimId.ClaimId}"
                : $"Игроки успешно приглашены. Создано заявок: {succeeded.Count}";
            NavigationManager.NavigateTo($"/{lastClaimId.ProjectId.Value}/claim/{lastClaimId.ClaimId}/edit", forceLoad: true);
            model = new InvitePlayerViewModel { ProjectId = ProjectId };
        }
        else
        {
            model.UserLinks = failed.Select(f => f.UserLink).ToList();
            var failedText = string.Join("; ", failed.Select(f => $"{f.UserLink} — {f.Message}"));
            errorMessage = succeeded.Count == 0
                ? $"Не удалось пригласить игроков: {failedText}"
                : $"Приглашено игроков: {succeeded.Count}. Не удалось пригласить: {failedText}";
        }

        loading = false;
        StateHasChanged();
    }
}
