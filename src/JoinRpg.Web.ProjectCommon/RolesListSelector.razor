@using System.Linq.Expressions
@inject IRolesListSelectorClient client
@inject SelectorListCache cache

<TypedSelector TKey="ProjectRolesListIdentification" TItem="ProjectRolesListDto"
               Name="@Name"
               Items="rolesLists"
               KeySelector="@(r => r.ProjectRolesListId)"
               ToListItem="@(r => TypedSelectList.CreateItem(
                   Value: r.ProjectRolesListId,
                   Text: r.Name))"
               SelectedValues="initial"
               SelectedItemsChanged="HandleSelectedItemsChanged"
               Multiple="false"
               />

@code {

    [CascadingParameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Name { get; set; } = null;
    /// <summary>Поле модели формы: EditContext узнаёт об изменении выбора по этому выражению.</summary>
    [Parameter] public Expression<Func<ProjectRolesListIdentification[]?>>? SelectedIdsExpression { get; set; }
    [Parameter][EditorRequired] public ProjectIdentification ProjectId { get; set; } = null!;
    [Parameter] public ProjectRolesListIdentification? SelectedId { get; set; }
    [Parameter] public EventCallback<ProjectRolesListIdentification[]> SelectedIdsChanged { get; set; }
    [Parameter] public EventCallback<ProjectRolesListDto[]> SelectedChanged { get; set; }

    private ProjectRolesListDto[]? rolesLists;
    private ProjectRolesListIdentification[] initial => SelectedId is not null ? [SelectedId] : [];
    private FieldIdentifier? fieldIdentifier;

    private async Task HandleSelectedItemsChanged(ProjectRolesListDto[] selectedItems)
    {
        await SelectedIdsChanged.InvokeAsync(selectedItems.Select(x => x.ProjectRolesListId).ToArray());
        await SelectedChanged.InvokeAsync(selectedItems);
        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (SelectedIdsExpression is not null)
        {
            // Как в CharacterGroupSelector: пересоздаём при каждом рендере — модель формы может быть заменена.
            fieldIdentifier = FieldIdentifier.Create(SelectedIdsExpression);
            Name ??= fieldIdentifier.Value.FieldName;
        }
        else
        {
            fieldIdentifier = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        rolesLists = [.. await cache.GetOrLoad<ProjectRolesListDto>($"roles-lists:{ProjectId.Value}",
            async () => await client.GetRolesListsList(ProjectId))];
    }
}
