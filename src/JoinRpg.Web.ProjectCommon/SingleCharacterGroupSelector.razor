<CharacterGroupSelector
  Name="@Name"
  ProjectId="@ProjectId"
  SelectedGroupIds="@selectedGroupIds"
  SelectedGroupsChanged="HandleSelectedGroupChanged"
  IncludeSpecial="@IncludeSpecial"
  Multiple="false"
  Mode="@Mode"
  EmptyText="@EmptyText"
  />

@code {

    [Parameter] public string? Name { get; set; } = null;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public CharacterGroupIdentification? SelectedGroupId { get; set; }
    [Parameter] public EventCallback<CharacterGroupIdentification?> SelectedGroupIdChanged { get; set; }
    [Parameter] public CharacterGroupDto? SelectedGroup { get; set; }
    [Parameter] public EventCallback<CharacterGroupDto> SelectedGroupChanged { get; set; }
    [Parameter] public bool IncludeSpecial { get; set; } = true;
    /// <summary>См. <see cref="CharacterGroupSelectorMode"/>: нужен ли пустой пункт и предлагается ли корень.</summary>
    [Parameter] public CharacterGroupSelectorMode Mode { get; set; } = CharacterGroupSelectorMode.ShowRoot;
    /// <summary>Текст пустого пункта при <see cref="Mode"/>, отличном от <see cref="CharacterGroupSelectorMode.ShowRoot"/>.</summary>
    [Parameter] public string EmptyText { get; set; } = "Все группы";

    private CharacterGroupIdentification[] selectedGroupIds = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (SelectedGroupId is not null)
        {
            selectedGroupIds = [ SelectedGroupId ];
        }
        else if (SelectedGroup is not null)
        {
            selectedGroupIds = [SelectedGroup.CharacterGroupId ];
        }
    }

    private async Task HandleSelectedGroupChanged(CharacterGroupDto[] values)
    {
        CharacterGroupDto? selected = values.Length == 0 ? null : values.Single();
        await SelectedGroupIdChanged.InvokeAsync(selected?.CharacterGroupId);
        await SelectedGroupChanged.InvokeAsync(selected);
    }
}
