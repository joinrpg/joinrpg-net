@using JoinRpg.Common.PrimitiveTypes
@inject IMasterClient client

<TypedSelector TKey="UserIdentification" TItem="MasterViewModel"
    Name="@Name"
    Items="items"
    KeySelector="@(m => m.MasterId)"
    ToListItem="@(m => TypedSelectList.CreateItem(
        Value: m.MasterId,
        Text: m.DisplayName.DisplayName,
        Subtext: m.DisplayName.FullName ?? "",
        ExtraSearch: m.DisplayName.FullName ?? ""))"
    SelectedValues="@Selected"
    SelectedItemsChanged="@HandleSelectedChanged"
    Multiple="false"
    />

@code {

    [Parameter] public string? Name { get; set; } = null;
    [Parameter] [EditorRequired] public int ProjectId { get; set; }
    [Parameter] public UserIdentification? MasterId { get; set; }
    [Parameter] public EventCallback<UserIdentification?> MasterIdChanged { get; set; }
    [Parameter] public UserIdentification[] IdsToRemove { get; set; } = [];

    [Parameter] public MasterViewModel? Master { get; set; }
    [Parameter] public EventCallback<MasterViewModel?> MasterChanged { get; set; }

    private UserIdentification[] Selected { get; set; } = [];
    private MasterViewModel[]? items;

    protected override async Task OnInitializedAsync()
    {
        var masters = await client.GetMasters(ProjectId);
        items = [.. masters.Where(master => !IdsToRemove.Contains(master.MasterId))];
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (MasterId is not null)
        {
            Selected = [MasterId];
        }
        else if (Master is not null)
        {
            Selected = [Master.MasterId];
        }
    }

    private async Task HandleSelectedChanged(MasterViewModel[] values)
    {
        var master = values.Length == 0 ? null : values.Single();
        await MasterIdChanged.InvokeAsync(master?.MasterId);
        await MasterChanged.InvokeAsync(master);
    }
}
