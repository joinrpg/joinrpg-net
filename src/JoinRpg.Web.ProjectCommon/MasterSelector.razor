@using System.Linq.Expressions
@using JoinRpg.Common.PrimitiveTypes
@using JoinRpg.Common.PrimitiveTypes.Users
@inject IMasterClient client
@inject SelectorListCache cache

<TypedSelector TKey="UserIdentification" TItem="UserInfoHeader"
    Name="@Name"
    Items="items"
    KeySelector="@(m => m.UserId)"
    ToListItem="@(m => TypedSelectList.CreateItem(
        Value: m.UserId,
        Text: m.DisplayName.DisplayName,
        Subtext: m.DisplayName.FullName ?? "",
        ExtraSearch: m.DisplayName.FullName ?? ""))"
    SelectedValues="@Selected"
    SelectedItemsChanged="@HandleSelectedChanged"
    Multiple="false"
    AllowEmpty="@AllowEmpty"
    EmptyText="@EmptyItemText"
    />

@code {

    [CascadingParameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Name { get; set; } = null;
    /// <summary>Поле модели формы: EditContext узнаёт об изменении выбора по этому выражению.</summary>
    [Parameter] public Expression<Func<UserIdentification?>>? MasterIdExpression { get; set; }
    /// <summary>Пустой пункт «любой» — для фильтров, где отсутствие выбора тоже значение.</summary>
    [Parameter] public bool AllowEmpty { get; set; } = false;
    [Parameter] public string EmptyText { get; set; } = "Любой мастер";
    /// <summary>TypedSelector показывает EmptyText и на кнопке «ничего не выбрано»: без AllowEmpty оставляем его родной «(нет)».</summary>
    private string EmptyItemText => AllowEmpty ? EmptyText : "(нет)";
    [Parameter] [EditorRequired] public int ProjectId { get; set; }
    [Parameter] public UserIdentification? MasterId { get; set; }
    [Parameter] public EventCallback<UserIdentification?> MasterIdChanged { get; set; }
    [Parameter] public UserIdentification[] IdsToRemove { get; set; } = [];

    [Parameter] public UserInfoHeader? Master { get; set; }
    [Parameter] public EventCallback<UserInfoHeader?> MasterChanged { get; set; }

    private UserIdentification[] Selected { get; set; } = [];
    private UserInfoHeader[]? items;
    private FieldIdentifier? fieldIdentifier;

    protected override async Task OnInitializedAsync()
    {
        var masters = await cache.GetOrLoad<UserInfoHeader>($"masters:{ProjectId}",
            async () => await client.GetMasters(ProjectId));
        items = [.. masters.Where(master => !IdsToRemove.Contains(master.UserId))];
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (MasterId is not null)
        {
            Selected = [MasterId];
        }
        else if (Master is not null)
        {
            Selected = [Master.UserId];
        }

        if (MasterIdExpression is not null)
        {
            // Как в CharacterGroupSelector: пересоздаём при каждом рендере — модель формы может быть заменена.
            fieldIdentifier = FieldIdentifier.Create(MasterIdExpression);
            Name ??= fieldIdentifier.Value.FieldName;
        }
        else
        {
            fieldIdentifier = null;
        }
    }

    private async Task HandleSelectedChanged(UserInfoHeader[] values)
    {
        var master = values.Length == 0 ? null : values.Single();
        await MasterIdChanged.InvokeAsync(master?.UserId);
        await MasterChanged.InvokeAsync(master);
        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }
}
