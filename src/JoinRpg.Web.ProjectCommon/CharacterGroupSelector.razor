@using System.Linq.Expressions
@inject ICharacterGroupsClient groupsClient

<TypedSelector TKey="CharacterGroupIdentification" TItem="CharacterGroupDto"
               Name="@Name"
               Items="groups"
               KeySelector="@(g => g.CharacterGroupId)"
               ToListItem="@(g => TypedSelectList.CreateItem(
                   Value: g.CharacterGroupId,
                   Text: g.Name,
                   Subtext: string.Join("→", g.FullPath),
                   ExtraSearch: string.Join(" ", g.FullPath)))"
               SelectedValues="@SelectedGroupIds"
               SelectedItemsChanged="HandleSelectedItemsChanged"
               Multiple="@Multiple"
               />
@if (SelectedGroupNames.Length > 1)
{
  <p>@string.Join(" • ", SelectedGroupNames)</p>
}

@code {

    [CascadingParameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Name { get; set; } = null;
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public CharacterGroupIdentification[] SelectedGroupIds { get; set; } = [];
    [Parameter] public EventCallback<CharacterGroupIdentification[]> SelectedGroupIdsChanged { get; set; }
    [Parameter] public Expression<Func<CharacterGroupIdentification[]?>>? SelectedGroupIdsExpression { get; set; }

    [Parameter] public EventCallback<CharacterGroupDto[]> SelectedGroupsChanged { get; set; }
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public bool IncludeSpecial { get; set; } = true;
    [Parameter] public CharacterGroupIdentification? ExcludeGroupId { get; set; }

    public string[] SelectedGroupNames { get; private set; } = [];

    private CharacterGroupDto[]? groups;
    /// <summary>Ключ загрузки: пока не изменился, в сеть не ходим.</summary>
    private (int ProjectId, bool IncludeSpecial, CharacterGroupIdentification? ExcludeGroupId)? loadedFor;
    private FieldIdentifier? fieldIdentifier = null;

    private async Task HandleSelectedItemsChanged(CharacterGroupDto[] selectedItems)
    {
        RefreshSelectedNames(selectedItems);
        await SelectedGroupIdsChanged.InvokeAsync([.. selectedItems.Select(x => x.CharacterGroupId)]);
        await SelectedGroupsChanged.InvokeAsync(selectedItems);

        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }

    private void RefreshSelectedNames(CharacterGroupDto[] val)
    {
        SelectedGroupNames = [.. val.Select(item => item.Name)];
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (ExcludeGroupId is not null && IncludeSpecial)
        {
            throw new InvalidOperationException($"{nameof(ExcludeGroupId)} requires {nameof(IncludeSpecial)}=false");
        }
        // Параметры выставляются заново при каждой перерисовке родителя, поэтому грузим список только
        // когда изменилось то, от чего он зависит.
        if (loadedFor != (ProjectId, IncludeSpecial, ExcludeGroupId))
        {
            groups = ExcludeGroupId is not null
                ? [.. await groupsClient.GetValidParentGroups(ExcludeGroupId)]
                : IncludeSpecial
                    ? [.. await groupsClient.GetCharacterGroupsWithSpecial(ProjectId)]
                    : [.. await groupsClient.GetRealCharacterGroups(ProjectId)];
            loadedFor = (ProjectId, IncludeSpecial, ExcludeGroupId);
        }

        var selectedItems = (groups ?? []).Where(item => SelectedGroupIds.Contains(item.CharacterGroupId)).ToArray();
        if (SelectedGroupIdsExpression is not null)
        {
            fieldIdentifier = FieldIdentifier.Create(SelectedGroupIdsExpression);
            Name ??= fieldIdentifier.Value.FieldName;
        }
        RefreshSelectedNames(selectedItems);
    }
}
