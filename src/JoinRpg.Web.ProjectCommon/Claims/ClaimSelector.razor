@using System.Linq.Expressions
@using JoinRpg.DomainTypes.Characters.Claims
@inject IClaimListClient client
@inject SelectorListCache cache

<TypedSelector TKey="ClaimIdentification" TItem="ClaimLinkViewModel"
               Name="@Name"
               Items="claims"
               KeySelector="@(c => c.ClaimId)"
               ToListItem="@(c => TypedSelectList.CreateItem(
                   Value: c.ClaimId,
                   Text: c.CharacterName,
                   Subtext: c.PlayerName.ToLongString(),
                   ExtraSearch: c.OtherPlayerNicks))"
               SelectedValues="@Selected"
               SelectedItemsChanged="HandleSelectedItemsChanged"
               Multiple="false"
               />

@code {

    [CascadingParameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Name { get; set; } = null;
    /// <summary>Поле модели формы: EditContext узнаёт об изменении выбора по этому выражению.</summary>
    [Parameter] public Expression<Func<ClaimIdentification?>>? ClaimIdExpression { get; set; }
    [Parameter] [EditorRequired] public ProjectIdentification ProjectId { get; set; }
    [Parameter] public ClaimIdentification? ClaimId { get; set; }
    [Parameter] public EventCallback<ClaimIdentification?> ClaimIdChanged { get; set; }

    [Parameter] public ClaimLinkViewModel? Claim { get; set; }
    [Parameter] public EventCallback<ClaimLinkViewModel?> ClaimChanged { get; set; }
    [Parameter] public ClaimStatusSpec Spec { get; set; } = ClaimStatusSpec.Active;

    /// <summary>Заявка, которую нельзя выбрать (например, та, с которой переводят взнос).</summary>
    [Parameter] public ClaimIdentification? ExceptClaimId { get; set; }

    private ClaimIdentification[] Selected { get; set; } = [];
    private ClaimLinkViewModel[]? claims;
    private FieldIdentifier? fieldIdentifier;

    protected override async Task OnInitializedAsync()
        => claims = [.. (await cache.GetOrLoad<ClaimLinkViewModel>($"claims:{ProjectId.Value}:{Spec}",
            async () => await client.GetClaims(ProjectId, Spec))).Where(c => c.ClaimId != ExceptClaimId)];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ClaimId is not null)
        {
            Selected = [ClaimId];
        }
        else if (Claim is not null)
        {
            Selected = [Claim.ClaimId];
        }

        if (ClaimIdExpression is not null)
        {
            // Как в CharacterGroupSelector: пересоздаём при каждом рендере — модель формы может быть заменена.
            fieldIdentifier = FieldIdentifier.Create(ClaimIdExpression);
            Name ??= fieldIdentifier.Value.FieldName;
        }
        else
        {
            fieldIdentifier = null;
        }
    }

    private async Task HandleSelectedItemsChanged(ClaimLinkViewModel[] selectedItems)
    {
        var claim = selectedItems.SingleOrDefault();
        await ClaimIdChanged.InvokeAsync(claim?.ClaimId);
        await ClaimChanged.InvokeAsync(claim);
        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }
}
