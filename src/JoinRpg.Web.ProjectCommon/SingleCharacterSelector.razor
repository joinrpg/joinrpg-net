<CharacterSelector
  Name="@Name"
  ProjectId="@ProjectId"
  SelectedCharacterIds="@selectedIds"
  SelectedCharactersChanged="HandleSelectedChanged"
  Multiple="false"
  ListType="@ListType"
  AllowEmpty="@(AllowEmpty || NewCharacterOptionText is not null)"
  EmptyText="@(NewCharacterOptionText ?? "(нет)")"
  ExcludeCharacterIds="@ExcludeCharacterIds"
  />

@code {

    [Parameter] public string? Name { get; set; } = null;
    [Parameter] [EditorRequired] public ProjectIdentification ProjectId { get; set; }
    [Parameter] public CharacterIdentification? SelectedCharacterId { get; set; }
    [Parameter] public EventCallback<CharacterIdentification?> SelectedCharacterIdChanged { get; set; }
    [Parameter] public CharacterDto? SelectedCharacter { get; set; }
    [Parameter] public EventCallback<CharacterDto> SelectedCharacterChanged { get; set; }
    [Parameter] public CharacterListType ListType { get; set; } = CharacterListType.All;
    [Parameter] public bool AllowEmpty { get; set; } = false;
    [Parameter] public CharacterIdentification[] ExcludeCharacterIds { get; set; } = [];

    /// <summary>
    /// Текст пункта «новый персонаж». null (по умолчанию) — такого пункта нет.
    /// Если задан, первым пунктом списка идёт вариант с этим текстом; он занимает место пустого пункта
    /// (<see cref="AllowEmpty"/> тогда не нужен), и <see cref="SelectedCharacterId"/> == null означает
    /// «выбран новый персонаж».
    /// </summary>
    [Parameter] public string? NewCharacterOptionText { get; set; }

    private CharacterIdentification[] selectedIds = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (SelectedCharacterId is not null)
        {
            selectedIds = [ SelectedCharacterId ];
        }
        else if (SelectedCharacter is not null)
        {
            selectedIds = [SelectedCharacter.CharacterId ];
        }
        else
        {
            // Родитель сбросил выбор (пустой пункт или «новый персонаж») — не держим прежний id.
            selectedIds = [];
        }
    }

    private async Task HandleSelectedChanged(CharacterDto[] values)
    {
        var selected = values.Length == 0 ? null : values.Single();
        await SelectedCharacterIdChanged.InvokeAsync(selected?.CharacterId);
        await SelectedCharacterChanged.InvokeAsync(selected);
    }
}
