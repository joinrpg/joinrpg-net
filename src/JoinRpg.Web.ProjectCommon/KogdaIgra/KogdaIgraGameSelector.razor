@using System.Linq.Expressions
@inject IKogdaIgraSyncClient client
@inject SelectorListCache cache

<TypedSelector TKey="KogdaIgraIdentification" TItem="KogdaIgraShortViewModel"
               Name="@Name"
               Items="itemModels"
               KeySelector="@(m => m.KogdaIgraId)"
               ToListItem="@(m => TypedSelectList.CreateItem(
                   Value: m.KogdaIgraId,
                   Text: m.Name,
                   Subtext: m.Year?.ToString() ?? ""))"
               SelectedValues="@KogdaIgraIds"
               SelectedValuesChanged="@HandleSelectedValuesChanged"
               SelectedItemsChanged="@KogdaIgrasChanged"
               Multiple="@Multiple"
               />

@code {

    [CascadingParameter] public EditContext? EditContext { get; set; }
    [Parameter] public string? Name { get; set; } = null;
    [Parameter] public KogdaIgraIdentification[] KogdaIgraIds { get; set; } = [];
    [Parameter] public EventCallback<KogdaIgraIdentification[]> KogdaIgraIdsChanged { get; set; }

    [Parameter] public KogdaIgraShortViewModel[] KogdaIgras { get; set; } = [];
    [Parameter] public EventCallback<KogdaIgraShortViewModel[]> KogdaIgrasChanged { get; set; }
    [Parameter] public KogdaIgraShortViewModel[]? InitialList { get; set; }

    /// <summary>Поле модели для одиночного выбора (форма создания проекта): EditContext узнаёт об изменении по этому выражению.</summary>
    [Parameter] public Expression<Func<KogdaIgraIdentification?>>? KogdaIgraGameIdExpression { get; set; }

    /// <summary>Разрешить выбор нескольких игр (по умолчанию — как в админке).</summary>
    [Parameter] public bool Multiple { get; set; } = true;

    /// <summary>Загружать только будущие игры (используется формой создания проекта).</summary>
    [Parameter] public bool FutureOnly { get; set; } = false;

    private KogdaIgraShortViewModel[]? itemModels;
    private FieldIdentifier? fieldIdentifier;

    protected override async Task OnInitializedAsync()
    {
        itemModels = InitialList ?? (FutureOnly
            ? [.. await cache.GetOrLoad<KogdaIgraShortViewModel>("kogda-igra:future",
                async () => await client.GetFutureKogdaIgraCandidates())]
            : [.. await cache.GetOrLoad<KogdaIgraShortViewModel>("kogda-igra:all",
                async () => await client.GetKogdaIgraCandidates())]);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (KogdaIgraGameIdExpression is not null)
        {
            // Как в CharacterGroupSelector: пересоздаём при каждом рендере — модель формы может быть заменена.
            fieldIdentifier = FieldIdentifier.Create(KogdaIgraGameIdExpression);
            Name ??= fieldIdentifier.Value.FieldName;
        }
        else
        {
            fieldIdentifier = null;
        }
    }

    private async Task HandleSelectedValuesChanged(KogdaIgraIdentification[] selection)
    {
        await KogdaIgraIdsChanged.InvokeAsync(selection);
        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }
}
