<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Override global TargetFramework from Directory.Build.props -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>JoinRpg.Common.PrimitiveTypes.SourceGenerator</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>Source generator for typed entity IDs</Description>
    <PackageProjectUrl>https://github.com/joinrpg/joinrpg-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joinrpg/joinrpg-net</RepositoryUrl>
    <!--
      Анализатор грузится в компилятор потребителя как есть, версии не совместимы вперёд: если
      Microsoft.CodeAnalysis.CSharp здесь новее, чем компилятор потребителя, хост тихо отказывается
      загружать анализатор (CS9057 — предупреждение, не ошибка) и весь сгенерированный код исчезает,
      что дальше валится совершенно непонятными ошибками в другом месте. Поэтому эта версия
      НЕ должна следовать за общим Directory.Packages.props (там 5.9.0, актуальная для остального
      решения) — фиксируем низкий потолок, достаточный только для используемых API
      (SyntaxValueProvider.ForAttributeWithMetadataName появился в 4.3.0), чтобы пакет грузился на
      максимально широком диапазоне SDK у потребителей.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- Аналайзер-пакет намеренно не кладёт сборку в lib/ref (IncludeBuildOutput=false), NU5128 — ложное срабатывание -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
