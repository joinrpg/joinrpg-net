<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Общий для всех DRP-инструментов (DrpConfiguration.UserSecretsId): строки подключения задаются один раз. -->
    <UserSecretsId>joinrpg-drp</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql" />
    <!-- SqlClient 6.1.x тянет уязвимый Pkcs 9.0.11 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <!-- В коде не используется, поэтому TreatAsUsed: иначе ReferenceTrimmer предлагает удалить (RT0003). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" TreatAsUsed="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ради ProjectEntityIdParser: EntityReference уведомлений разбираем тем же кодом, что и портал. -->
    <ProjectReference Include="..\JoinRpg.DomainTypes\JoinRpg.DomainTypes.csproj" />
    <ProjectReference Include="..\JoinRpg.Tools.Drp.Common\JoinRpg.Tools.Drp.Common.csproj" />
  </ItemGroup>
</Project>
