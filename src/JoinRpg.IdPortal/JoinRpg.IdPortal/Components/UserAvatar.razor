@using JoinRpg.Data.Interfaces
@using JoinRpg.Interfaces
@inject IAvatarLoader avatarProvider
@inject IUserRepository userRepository

@* Никакого интерактива здесь нет: компонент грузит URI и рисует картинку.
   Раньше стоял @@rendermode InteractiveServer — из-за этого circuit поднимался
   на каждой авторизованной странице, потому что аватарка живёт в MainLayout. *@

@if (AvatarUri is not null)
{

  <JoinRpg.Common.WebComponents.JoinAvatar Uri="@AvatarUri" Size=@Size />

}


@code {
    // Этот компонент надо слить с порталом

    [Parameter]
    public AvatarIdentification? AvatarId{ get; set; }

    [Parameter]
    [EditorRequired]
    // Без AvatarId приходит cookie, выданная до того, как аватарку завели, и ещё не пересобранная: тогда только читаем её.
    public int UserId { get; set; }

    [Parameter]
    public int Size { get; set; } = 64;

    private Uri? AvatarUri;

    protected async override Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var userAvatarId = AvatarId ?? (await userRepository.GetUserInfoHeaders([new UserIdentification(UserId)])).SingleOrDefault()?.Avatar;
        AvatarUri = userAvatarId is null ? null : (await avatarProvider.GetAvatar(userAvatarId, Size)).Uri;
    }

}
