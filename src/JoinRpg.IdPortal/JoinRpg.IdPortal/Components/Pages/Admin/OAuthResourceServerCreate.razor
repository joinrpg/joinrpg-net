@page "/admin/oauthclients/create-resource-server"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using JoinRpg.IdPortal.OAuthServer
@inject IOAuthClientService OAuthClientService

<PageTitle>Создать resource server — id.joinrpg.ru</PageTitle>

<JoinAdminAuthorizeView Roles="@Security.AdminRoleName">
    <h3>Создать resource server</h3>

    <JoinAlert Variation="VariationStyleEnum.Info">
        Resource server — это сервер, который сам токенов не получает, а проверяет чужие
        через <code>connect/introspect</code>. Так устроен Portal для эндпоинта
        <code>/mcp</code> (ADR012). У него нет ни redirect URI, ни scope, ни authorization
        code — только право на интроспекцию.
    </JoinAlert>

    @if (created)
    {
        <JoinAlert Variation="VariationStyleEnum.Warning">
            Сохраните секрет — после закрытия страницы он недоступен.
        </JoinAlert>
        <FormHorizontal>
            <FormRow Label="Client ID">
                <JoinTextInput Value="@(createdClientId ?? "")" readonly />
            </FormRow>
            <FormRow Label="Client Secret">
                <JoinTextArea Value="@createdSecret" ReadOnly="true" HasCopyButton="true" Rows="2" />
            </FormRow>
        </FormHorizontal>
        <JoinAlert Variation="VariationStyleEnum.Info">
            Пропишите эти значения в конфиг Portal как <code>Mcp__ClientId</code> и
            <code>Mcp__ClientSecret</code> — без них <code>/mcp</code> не регистрируется.
        </JoinAlert>
        <JoinButton Link="/admin/oauthclients" Label="К списку клиентов" />
    }
    else
    {
        <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
            <DataAnnotationsValidator />

            @if (errorMessage is not null)
            {
                <JoinAlert Variation="VariationStyleEnum.Danger">@errorMessage</JoinAlert>
            }

            <FormHorizontal>
                <FormRowFor For="() => Input.ClientId">
                    <JoinTextInput @bind-Value="Input.ClientId" />
                </FormRowFor>
                <FormRowFor For="() => Input.DisplayName">
                    <JoinTextInput @bind-Value="Input.DisplayName" />
                </FormRowFor>
            </FormHorizontal>

            <JoinButton Submit="true" Preset="ButtonPreset.Create" />
            <JoinButton Link="/admin/oauthclients" Preset="ButtonPreset.Cancel" />
        </EditForm>
    }
</JoinAdminAuthorizeView>

@code {
    private bool created;
    private string? createdSecret;
    private string? createdClientId;
    private string? errorMessage;

    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        var displayName = string.IsNullOrWhiteSpace(Input.DisplayName) ? null : Input.DisplayName;

        createdSecret = await OAuthClientService.CreateResourceServerAsync(Input.ClientId, displayName);
        createdClientId = Input.ClientId;
        created = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Укажите Client ID")]
        [MaxLength(100, ErrorMessage = "Client ID не должен превышать 100 символов")]
        [Display(Name = "Client ID")]
        public string ClientId { get; set; } = "";

        [MaxLength(200)]
        [Display(Name = "Название")]
        public string DisplayName { get; set; } = "";
    }
}
