@page "/oauth/consent"
@attribute [Authorize]
@using JoinRpg.Data.Interfaces
@using JoinRpg.IdPortal.OAuthServer
@using JoinRpg.IdPortal.OAuthServer.Cimd
@using JoinRpg.Interfaces
@using Microsoft.AspNetCore.WebUtilities
@using OpenIddict.Abstractions
@inject IOpenIddictApplicationManager ApplicationManager
@inject IProjectRepository ProjectRepository
@inject ICurrentUserAccessor CurrentUserAccessor
@inject NavigationManager NavigationManager

@* Страница рендерится статически: интерактива ей не нужно, решение пользователя — это
   обычная HTML-форма, которая уходит GET-ом обратно на connect/authorize (см. OAuthConsent).
   Раньше здесь стоял @@rendermode InteractiveServer, то есть на каждый OAuth-логин
   поднимался Blazor Server circuit. *@

<PageTitle>Запрос доступа — id.joinrpg.ru</PageTitle>

@if (notFound)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">Приложение не найдено.</JoinAlert>
}
else
{
    <h3>«@clientDisplayName» запрашивает доступ</h3>

    @if (cimdHost is not null)
    {
        @* Имя приложение задаёт себе само, а домен — единственное, что проверил joinrpg.
           Спека требует показывать его явно. *@
        <p>
            Приложение опознано по адресу <strong>@cimdHost</strong>: описание опубликовано
            на этом домене. За само приложение JoinRpg.ru не ручается.
        </p>
    }

    @if (redirectHosts.Count > 0)
    {
        <p>После подтверждения вас вернёт на: <strong>@string.Join(", ", redirectHosts)</strong></p>
    }

    @if (loopbackOnly)
    {
        <JoinAlert Variation="VariationStyleEnum.Warning">
            Это приложение работает на вашем компьютере. JoinRpg.ru не может проверить,
            какая именно программа запросила доступ, — разрешайте, только если вы сами
            сейчас её запустили.
        </JoinAlert>
    }

    <p>Запрошенные права:</p>
    <ul>
        @if (requestsRead)
        {
            <li>Чтение данных ваших проектов (список проектов, персонажи, группы, поля)</li>
        }
        @if (requestsCharactersWrite)
        {
            <li>Создание и правка персонажей в выбранных проектах</li>
        }
    </ul>

    @* Обе кнопки лежат снаружи форм и привязаны к ним атрибутом form — иначе чекбоксы
       пришлось бы дублировать или ломать вёрстку вложенными формами (что запрещено). *@
    <form method="get" action="@AuthorizeEndpoint" id="@GrantFormId">
        @RequestParameters(OAuthConsent.Granted)

        @if (requestsRead)
        {
            <p>Выберите проекты, к которым приложение получит доступ:</p>
            @if (projects.Count == 0)
            {
                <JoinAlert Variation="VariationStyleEnum.Warning">
                    У вас нет проектов с правами мастера — доступ открывать не к чему.
                </JoinAlert>
            }
            else
            {
                @foreach (var project in projects)
                {
                    <div class="checkbox">
                        <label>
                            <input type="checkbox"
                                   name="@OAuthConsent.ProjectsParameter"
                                   value="@project.ProjectId" />
                            @project.Name.Value
                        </label>
                    </div>
                }
            }
        }
    </form>

    <form method="get" action="@AuthorizeEndpoint" id="@DenyFormId">
        @RequestParameters(OAuthConsent.Denied)
    </form>

    <p>
        <JoinButton Submit="true" form="@GrantFormId" Label="Разрешить" Preset="ButtonPreset.Save" />
        <JoinButton Submit="true" form="@DenyFormId" Label="Отклонить" Preset="ButtonPreset.Cancel" />
    </p>
}

@code {
    private const string AuthorizeEndpoint = "/connect/authorize";
    private const string GrantFormId = "oauth-consent-grant";
    private const string DenyFormId = "oauth-consent-deny";

    private bool notFound;
    private string clientDisplayName = "";
    private string? cimdHost;
    private bool loopbackOnly;
    private readonly List<string> redirectHosts = [];
    private bool requestsRead;
    private bool requestsCharactersWrite;
    private readonly List<ProjectChoice> projects = [];

    /// <summary>
    /// Исходный запрос авторизации. GET-форма теряет query string из action, поэтому все
    /// параметры (client_id, state, code_challenge и прочие) переносим в скрытые поля.
    /// </summary>
    private readonly List<KeyValuePair<string, string>> requestParameters = [];

    private RenderFragment RequestParameters(string consentDecision) =>
        @<text>
            @foreach (var (name, value) in requestParameters)
            {
                <input type="hidden" name="@name" value="@value" />
            }
            <input type="hidden" name="@OAuthConsent.ConsentParameter" value="@consentDecision" />
        </text>;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        foreach (var (name, values) in query)
        {
            // Своё решение проставляем сами, чужое из запроса не тащим.
            if (name == OAuthConsent.ConsentParameter || name == OAuthConsent.ProjectsParameter)
            {
                continue;
            }

            foreach (var value in values)
            {
                requestParameters.Add(new(name, value ?? ""));
            }
        }

        var clientId = query.TryGetValue("client_id", out var clientIdValues) ? clientIdValues.ToString() : null;
        var application = clientId is null ? null : await ApplicationManager.FindByClientIdAsync(clientId);
        if (application is null)
        {
            notFound = true;
            return;
        }

        clientDisplayName = await ApplicationManager.GetDisplayNameAsync(application) ?? clientId!;

        if (CimdClientId.TryParse(clientId, out var cimdClientId))
        {
            cimdHost = cimdClientId.Host;
        }

        // Куда уйдёт пользователь после подтверждения — спека требует показать явно.
        var redirectUris = await ApplicationManager.GetRedirectUrisAsync(application);
        redirectHosts.AddRange(redirectUris
            .Select(uri => Uri.TryCreate(uri, UriKind.Absolute, out var parsed) ? parsed.Host : uri)
            .Distinct(StringComparer.OrdinalIgnoreCase));

        loopbackOnly = redirectUris.Length > 0 && redirectUris.All(
            uri => Uri.TryCreate(uri, UriKind.Absolute, out var parsed) && parsed.IsLoopback);

        var scopeValue = query.TryGetValue("scope", out var scopeValues) ? scopeValues.ToString() : "";
        var scopes = scopeValue.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        requestsRead = scopes.Contains(JoinRpgScopes.Read);
        requestsCharactersWrite = scopes.Contains(JoinRpgScopes.CharactersWrite);

        if (requestsRead)
        {
            var myProjects = await ProjectRepository.GetPersonalizedProjectsBySpecification(
                ProjectListSpecification.ActiveWithMyMasterAccess(CurrentUserAccessor.UserIdentification));

            projects.AddRange(myProjects
                .Where(p => p.HasMyMasterAccess)
                .Select(p => new ProjectChoice(p.ProjectId.Value, p.ProjectName)));
        }
    }

    private sealed class ProjectChoice(int projectId, JoinRpg.DomainTypes.ProjectMetadata.ProjectName name)
    {
        public int ProjectId { get; } = projectId;
        public JoinRpg.DomainTypes.ProjectMetadata.ProjectName Name { get; } = name;
    }
}
