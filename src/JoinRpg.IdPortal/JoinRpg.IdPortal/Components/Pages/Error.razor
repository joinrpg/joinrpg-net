@page "/Error"
@page "/Error/{StatusCode:int}"
@using JoinRpg.Common.WebInfrastructure

<PageTitle>@title</PageTitle>

<h1 class="text-danger">@title</h1>
@if (StatusCode == StatusCodes.Status404NotFound)
{
    <h3 class="text-danger">
        Если вы перешли на эту страницу по ссылке с нашего сайта, обратитесь в техподдержку.
    </h3>
}
else
{
    <h3 class="text-danger">При обработке вашего запроса возникла ошибка.</h3>
}

@if (info is not null)
{
    <SupportInfoPanel ActivityId="@info.ActivityId"
                      RequestId="@info.RequestId"
                      Path="@info.Path"
                      Referer="@info.Referer"
                      PodName="@info.PodName"
                      Version="@info.Version.Version"
                      CommitSha="@info.Version.CommitSha" />
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Parameter]
    public int? StatusCode { get; set; }

    private ErrorSupportInfo? info;

    private string title => StatusCode == StatusCodes.Status404NotFound ? "Страница не найдена" : "Ошибка";

    protected override void OnInitialized()
    {
        if (HttpContext is null)
        {
            return;
        }

        // Если маршрут не дал статус (страница открыта из UseExceptionHandler), берём его из ответа.
        StatusCode ??= HttpContext.Response.StatusCode is var sc and > 0 ? sc : null;
        info = ErrorSupportInfo.FromHttpContext(HttpContext);
    }
}
