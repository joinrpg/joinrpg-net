<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Web SDK нужен для генерации staticwebassets-манифеста от wwwroot (тесты MapStaticAssets).
       Заодно он добавляет свои global usings — убираем их, чтобы не перетряхивать using'и всех тестов. -->
  <ItemGroup>
    <Using Remove="Microsoft.AspNetCore.Builder" />
    <Using Remove="Microsoft.AspNetCore.Hosting" />
    <Using Remove="Microsoft.AspNetCore.Http" />
    <Using Remove="Microsoft.AspNetCore.Routing" />
    <Using Remove="Microsoft.Extensions.Configuration" />
    <Using Remove="Microsoft.Extensions.DependencyInjection" />
    <Using Remove="Microsoft.Extensions.Hosting" />
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JoinRpg.Common.WebInfrastructure\JoinRpg.Common.WebInfrastructure.csproj" />
    <ProjectReference Include="..\..\JoinRpg.TestHelpers\JoinRpg.TestHelpers.csproj" />
  </ItemGroup>
</Project>
