@using System.Linq.Expressions
@{
    var dataListId = Variants is not null ? variantsListId : null;
}
@if (Immediate)
{
    <input type="text" id="@inputId" name="@InputName" value="@internalValue" @oninput="UpdateValue" @onblur="TrimDisplayedValue" placeholder="@Placeholder" list="@dataListId" data-val="@ValidationEnabled" data-val-required="@RequiredMessageValue" @attributes="AdditionalAttributes" />
}
else
{
    <input type="text" id="@inputId" name="@InputName" value="@internalValue" @onchange="UpdateValue" placeholder="@Placeholder" list="@dataListId" data-val="@ValidationEnabled" data-val-required="@RequiredMessageValue" @attributes="AdditionalAttributes" />
}
@if (Required)
{
    <span class="field-validation-valid" data-valmsg-for="@(InputName ?? inputId)" data-valmsg-replace="true"></span>
}
@if (Variants is not null)
{
    <datalist id="@variantsListId">
        @foreach (var variant in Variants)
        {
            <option value="@variant" />
        }
    </datalist>
}

@code {
    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    [Parameter]
    [EditorRequired]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string>>? ValueExpression { get; set; }

    /// <summary>
    /// Имя поля формы. Нужно для постинга поля из MVC-формы; при null берётся имя из
    /// <see cref="ValueExpression"/>, если оно задано.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// When true, updates fire on every keystroke (oninput) instead of on blur/change (onchange).
    /// </summary>
    [Parameter]
    public bool Immediate { get; set; } = false;

    /// <summary>
    /// Обрезать пробелы по краям: наружу (в <see cref="ValueChanged"/>) значение уходит уже обрезанным,
    /// поэтому валидация формы видит то же, что потом сохранит сервер.
    /// </summary>
    [Parameter]
    public bool Trim { get; set; } = true;

    /// <summary>
    /// Обязательное поле: рендерит атрибуты <c>data-val-*</c> и span для сообщения —
    /// клиентскую валидацию jquery.validate.unobtrusive (подключена в Portal).
    /// </summary>
    [Parameter]
    public bool Required { get; set; } = false;

    /// <summary>Сообщение об ошибке обязательности для <c>data-val-required</c>.</summary>
    [Parameter]
    public string RequiredMessage { get; set; } = "Это поле обязательно к заполнению";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Варианты значений для подсказки ввода (рендерится как datalist, input получает атрибут list).
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<string>? Variants { get; set; }

    private readonly string variantsListId = $"join-text-input-variants-{Guid.NewGuid():N}";
    private readonly string fallbackId = $"join-text-input-{Guid.NewGuid():N}";

    [CascadingParameter]
    private FormRowLabelTarget? LabelTarget { get; set; }

    private FieldIdentifier FieldIdentifier { get; set; }

    private string? ValidationEnabled => Required ? "true" : null;
    private string? RequiredMessageValue => Required ? RequiredMessage : null;

    private string? InputName => Name ?? FieldIdentifier.FieldName;

    private string internalValue = "";
    private string? inputId;

    protected override void OnParametersSet()
    {
        // В режиме Immediate поле держит текст как набран (с пробелом в конце посреди ввода), а наружу ушёл обрезанный.
        // Перезаписываем только если значение поменяли снаружи — иначе не напечатать пробел между словами.
        // Value бывает null: @bind-Value к string? в вью-моделях.
        var value = Value ?? "";
        if (value != Normalize(internalValue))
        {
            internalValue = value;
        }
        inputId = LabelTarget?.Claim(this, FormRowLabelTarget.ExplicitId(AdditionalAttributes))
            ?? FormRowLabelTarget.ExplicitId(AdditionalAttributes)
            ?? Name
            ?? fallbackId;
        if (ValueExpression is not null)
        {
            FieldIdentifier = FieldIdentifier.Create(ValueExpression);
        }
    }

    private async Task UpdateValue(ChangeEventArgs eventArgs)
    {
        var rawValue = (string?)eventArgs.Value ?? "";
        internalValue = Immediate ? rawValue : Normalize(rawValue);
        await ValueChanged.InvokeAsync(Normalize(rawValue));
        if (ValueExpression is not null)
        {
            EditContext?.NotifyFieldChanged(FieldIdentifier);
        }
    }

    private void TrimDisplayedValue() => internalValue = Normalize(internalValue);

    private string Normalize(string value) => Trim ? value.Trim() : value;
}
