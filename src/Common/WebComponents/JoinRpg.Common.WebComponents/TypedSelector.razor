@*
    Выбор из списка на нативном <details>: в раскрывающейся панели — поиск (если пунктов больше 10)
    и radio/checkbox с name, поэтому обычная форма постит выбранное сама, без скриптов.
    value пункта — KeySelector(item).ToString(): полный идентификатор вроде CharacterGroupId(5-10),
    его разбирает ProjectEntityIdModelBinder.

    Пока ничего не выбрано, ничего и не отмечено — даже без AllowEmpty. Нативный <select> тут молча выбирал
    первый пункт, и форма постила то, чего человек не выбирал. Теперь форма не постит под этим именем ничего,
    и экшен, принимающий значение, обязан это проверить.

    В интерактивном режиме поиск и текст на кнопке ведёт C#. В статическом (render-mode="Static" в MVC-формах)
    Blazor в браузере не исполняется — там то же самое делает делегированный слушатель в
    wwwroot/JoinRpg.Common.WebComponents.lib.module.js, только для корней с data-join-select-static.
    Открытие и закрытие панели (клик мимо, Esc, выбор одиночного пункта) — тот же скрипт в обоих режимах.
*@
@typeparam TKey where TKey : notnull
@typeparam TItem

@if (Items is null)
{
    <JoinLoadingMessage />
}
else
{
    <details class="join-select"
             style="@WidthStyle"
             data-join-select-static="@(RendererInfo.IsInteractive ? null : "")"
             data-empty-text="@EmptyText">
        <summary class="join-select__toggle"
                 id="@toggleId"
                 title="@(toggleId is null ? summaryText : null)"
                 aria-labelledby="@(toggleId is null ? null : $"{LabelTarget!.LabelId} {ValueId}")">
            <span class="join-select__value" id="@ValueId">@summaryText</span>
            <span class="join-select__caret"></span>
        </summary>
        <div class="join-select__panel">
            @if (HasSearch)
            {
                <input type="search"
                       class="join-select__search"
                       placeholder="Поиск"
                       aria-label="Поиск по списку"
                       autocomplete="off"
                       value="@query"
                       @oninput="OnQueryChanged" />
            }
            <ul class="join-select__list">
                @if (ShowEmptyItem)
                {
                    <li hidden="@(HasSearch && !TypedSelectSearch.Matches(emptySearch, query))"
                        data-search="@(HasSearch ? emptySearch : null)">
                        <label class="join-select__item">
                            <input type="radio"
                                   name="@InputName"
                                   value=""
                                   checked="@(!options.Any(o => IsChecked(o.Key)))"
                                   @onchange="SelectEmptyAsync" />
                            <span class="join-select__text">@EmptyText</span>
                        </label>
                    </li>
                }
                @foreach (var option in options)
                {
                    var selected = IsChecked(option.Key);
                    <li @key="option.Key"
                        hidden="@(HasSearch && !TypedSelectSearch.Matches(option.Search, query))"
                        data-search="@(HasSearch ? option.Search : null)">
                        <label class="join-select__item @(option.Item.Disabled ? "join-select__item--disabled" : "")">
                            <input type="@(Multiple ? "checkbox" : "radio")"
                                   name="@InputName"
                                   value="@option.Key"
                                   checked="@selected"
                                   disabled="@option.Item.Disabled"
                                   @onchange="args => ToggleAsync(option.Key, args)" />
                            <span class="join-select__text">@option.Item.Text</span>
                            @if (!string.IsNullOrEmpty(option.Item.Subtext))
                            {
                                <small class="join-select__subtext">@option.Item.Subtext</small>
                            }
                        </label>
                    </li>
                }
            </ul>
        </div>
    </details>
}

@code {
    /// <summary>Имя поля формы. Без него radio получают сгенерированное имя — чтобы группировались между собой.</summary>
    [Parameter] public string? Name { get; set; } = null;
    [Parameter] [EditorRequired] public TItem[]? Items { get; set; }
    [Parameter] [EditorRequired] public Func<TItem, TKey> KeySelector { get; set; } = null!;
    [Parameter] [EditorRequired] public Func<TItem, TypedSelectListItem<TKey>> ToListItem { get; set; } = null!;
    [Parameter] public TKey[] SelectedValues { get; set; } = [];
    [Parameter] public EventCallback<TKey[]> SelectedValuesChanged { get; set; }
    [Parameter] public EventCallback<TItem[]> SelectedItemsChanged { get; set; }
    [Parameter] public bool Multiple { get; set; } = false;
    /// <summary>Добавить пустой пункт с текстом <see cref="EmptyText"/>. Для <see cref="Multiple"/> не нужен: там пусто — это ничего не отмечено.</summary>
    [Parameter] public bool AllowEmpty { get; set; } = false;
    /// <summary>Текст пустого пункта и текст на кнопке, когда ничего не выбрано.</summary>
    [Parameter] public string EmptyText { get; set; } = "(нет)";
    /// <summary>CSS-ширина, например <c>"30em"</c> или <c>"100%"</c>. null — ширина по умолчанию (220px, как была у bootstrap-select).</summary>
    [Parameter] public string? Width { get; set; }

    /// <summary>
    /// Подпись строки формы. &lt;summary&gt; не labelable: <c>&lt;label for&gt;</c> на нём фокус не ставит и имени не даёт.
    /// Поэтому клик по подписи открывает список скриптом (lib.module.js), а имя — через aria-labelledby: подпись и выбранное значение.
    /// </summary>
    [CascadingParameter] private FormRowLabelTarget? LabelTarget { get; set; }

    private string? toggleId;
    private string ValueId => $"{generatedName}-value";

    /// <summary>Поиск появляется, когда пунктов больше этого числа (как data-live-search у bootstrap-select).</summary>
    private const int SearchThreshold = 10;

    // Guid, а не счётчик: статические корни нумерует сервер, острова — WASM, и счётчики совпали бы.
    private readonly string generatedName = $"join-select-{Guid.NewGuid():N}";

    private (TKey Key, TypedSelectListItem<TKey> Item, string Search)[] options = [];
    private TKey[] currentSelection = [];
    private TKey[]? lastSelectedValues;
    private string summaryText = "";
    private string emptySearch = "";
    private bool hasSearch;
    private string query = "";

    private string InputName => Name ?? generatedName;
    private bool HasSearch => hasSearch;
    private bool ShowEmptyItem => AllowEmpty && !Multiple;
    private string? WidthStyle => Width is null ? null : $"width: {Width}";

    protected override void OnParametersSet()
    {
        // Пока список грузится, <summary> нет — подпись не должна ссылаться на несуществующий id.
        // Вторым полем строки id не достанется: тогда и подпись строки не наша, имя берётся из содержимого.
        // title при подписи не нужен: имя и так содержит значение, а title скринридер прочитал бы второй раз.
        toggleId = Items is null ? null : LabelTarget?.Claim(this);
        hasSearch = Items is { Length: > SearchThreshold };
        // Нормализация не бесплатная, а без поля поиска строки пунктов не нужны (селектор бывает в каждой строке сетки).
        options = Items is null
            ? []
            : [.. Items.Select(item =>
            {
                var listItem = ToListItem(item);
                return (KeySelector(item), listItem, hasSearch ? TypedSelectSearch.ForItem(listItem) : "");
            })];
        emptySearch = hasSearch ? TypedSelectSearch.Normalize(EmptyText) : "";

        // Родитель может не вернуть выбор обратно в SelectedValues (слушает только SelectedItemsChanged).
        // Тогда выбор живёт здесь, а SelectedValues перечитываем, только когда родитель и правда передал другие.
        if (lastSelectedValues is null || !lastSelectedValues.SequenceEqual(SelectedValues))
        {
            currentSelection = SelectedValues;
            lastSelectedValues = SelectedValues;
        }

        RefreshSummary();
    }

    private bool IsChecked(TKey key) => currentSelection.Contains(key);

    private void RefreshSummary()
    {
        var texts = options.Where(o => IsChecked(o.Key)).Select(o => o.Item.Text).ToArray();
        summaryText = texts.Length == 0 ? EmptyText : string.Join(", ", texts);
    }

    private void OnQueryChanged(ChangeEventArgs args) => query = args.Value?.ToString() ?? "";

    private Task SelectEmptyAsync() => SetSelectionAsync([]);

    private Task ToggleAsync(TKey key, ChangeEventArgs args)
    {
        if (!Multiple)
        {
            return SetSelectionAsync([key]);
        }
        var isChecked = args.Value is true || (args.Value is string text && bool.TryParse(text, out var parsed) && parsed);
        TKey[] newSelection = isChecked
            ? [.. currentSelection.Where(k => !k.Equals(key)), key]
            : [.. currentSelection.Where(k => !k.Equals(key))];
        // Порядок — как в списке, а не как кликали.
        return SetSelectionAsync([.. options.Select(o => o.Key).Where(newSelection.Contains)]);
    }

    private async Task SetSelectionAsync(TKey[] selection)
    {
        currentSelection = selection;
        RefreshSummary();
        await SelectedValuesChanged.InvokeAsync(selection);
        if (SelectedItemsChanged.HasDelegate)
        {
            await SelectedItemsChanged.InvokeAsync([.. Items!.Where(i => selection.Contains(KeySelector(i)))]);
        }
    }
}
