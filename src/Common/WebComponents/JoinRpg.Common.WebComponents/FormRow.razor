<div class="form-group" @attributes="@InputAttributes">
  @if (string.IsNullOrEmpty(Label))
  {
    @* Пустой label — мусор для скринридера; колонка остаётся, чтобы поле стояло вровень со строками с подписью. *@
    <div class="col-md-2"></div>
  }
  else
  {
    <label id="@labelTarget.LabelId" class="control-label col-md-2" for="@labelTarget.InputId">@Label</label>
  }
  <div class="col-md-10">
    <CascadingValue Value="labelTarget" IsFixed="true">
      @ChildContent
    </CascadingValue>
    @if (Description is not null)
    {
      <div class="help-block">@Description</div>
    }
    else if (DescriptionFragment is not null)
    {
      <div class="help-block">@DescriptionFragment</div>
    }
  </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Подпись поля. Без неё строка выводит пустую колонку вместо <c>&lt;label&gt;</c> — так ставят кнопки под полями.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? DescriptionFragment { get; set; } = null;
    [Parameter] public string? Description { get; set; } = null;

    /// <summary>
    /// Имя поля — часть сгенерированного id поля ввода, чтобы его было легче узнать в разметке.
    /// Связь подписи с полем от него не зависит — см. <see cref="FormRowLabelTarget"/>.
    /// </summary>
    [Parameter] public string? FieldName { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> InputAttributes { get; set; } = new();

    private FormRowLabelTarget labelTarget = null!;

    protected override void OnInitialized() => labelTarget = new FormRowLabelTarget(FieldName, StateHasChanged);
}
