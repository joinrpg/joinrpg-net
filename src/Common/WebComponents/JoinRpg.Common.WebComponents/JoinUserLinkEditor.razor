@using System.Linq.Expressions
@inject IUserLinkResolveClient ResolveClient

@for (var i = 0; i < RowsToRender.Count; i++)
{
    var index = i;
    <div class="join-user-link-editor-row">
        <JoinTextInput Value="@RowsToRender[index]"
                       ValueChanged="@(newValue => OnRowChangedAsync(index, newValue))"
                       Placeholder="@("Ссылка или ID")"
                       Immediate="@Multiple"
                       autocomplete="off" />
        @if (Multiple && index < Values.Count)
        {
            <JoinButton Preset="ButtonPreset.Delete" Label="" Size="SizeStyleEnum.Small" OnClick="@(() => OnRemoveRowAsync(index))" />
        }
    </div>
    @if (ResolveEnabled)
    {
        var state = StateFor(RowsToRender[index]);
        if (state is not null)
        {
            <div class="join-user-link-editor-status">
                @if (state.User is not null)
                {
                    <UserLink Model="@state.User" />
                }
                else
                {
                    <span class="text-danger">@state.Error</span>
                }
            </div>
        }
    }
}

@if (Name is not null)
{
    @* Значение уезжает обычным POST'ом MVC-формы — только успешно разрезолвленные id. *@
    <input type="hidden" name="@Name" value="@HiddenValue" />
}

@code {
    [Parameter]
    public bool Multiple { get; set; } = false;

    [Parameter]
    [EditorRequired]
    public List<string> Values { get; set; } = new();

    [Parameter]
    public EventCallback<List<string>> ValuesChanged { get; set; }

    [Parameter]
    public Expression<Func<List<string>>>? ValuesExpression { get; set; }

    /// <summary>
    /// Имя скрытого инпута, в который уезжают разрезолвленные id через запятую. Нужно, когда
    /// компонент встроен островом в обычную MVC-форму (ADR017 §5). null — инпута нет.
    /// </summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>
    /// Проект, в контексте которого резолвится ссылка. null — резолв выключен, компонент работает
    /// как чистый ввод строк (так его использует форма приглашения игрока, где строка уходит
    /// на сервер как есть).
    /// </summary>
    [Parameter]
    public int? ProjectId { get; set; }

    /// <summary>
    /// Уже известные пользователи для начальных значений <see cref="Values"/> (i-й соответствует
    /// i-му значению). Нужны, чтобы при загрузке страницы сохранённое значение сразу показывалось
    /// именем, а не голым числом и не после лишнего запроса.
    /// </summary>
    [Parameter]
    public IReadOnlyList<UserLinkViewModel> InitialUsers { get; set; } = [];

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    private FieldIdentifier fieldIdentifier;

    private sealed record ResolveState(UserLinkViewModel? User, string? Error);

    private readonly Dictionary<string, ResolveState> resolved = new(StringComparer.Ordinal);
    private readonly HashSet<string> inFlight = new(StringComparer.Ordinal);
    private bool initialized;

    private bool ResolveEnabled => ProjectId is not null;

    protected override void OnParametersSet()
    {
        if (ValuesExpression is not null)
        {
            fieldIdentifier = FieldIdentifier.Create(ValuesExpression);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Ключ — сам id строкой: сохранённое значение поля выглядит именно так, а раскладывать
        // по индексам нельзя — мусорное значение в базе сдвинуло бы соответствие.
        foreach (var user in InitialUsers)
        {
            if (user.UserId is not null)
            {
                resolved[user.UserId.Value.ToString()] = new ResolveState(user, null);
            }
        }

        initialized = true;

        foreach (var value in Values.ToList())
        {
            await ResolveIfNeededAsync(value);
        }
    }

    private static string Key(string? value) => value?.Trim() ?? "";

    private ResolveState? StateFor(string value)
        => resolved.TryGetValue(Key(value), out var state) ? state : null;

    private string HiddenValue
        => string.Join(
            ",",
            Values
                .Select(v => StateFor(v)?.User?.UserId?.Value)
                .Where(id => id is not null)
                .Distinct());

    private async Task ResolveIfNeededAsync(string value)
    {
        var key = Key(value);
        if (!ResolveEnabled || !initialized || key.Length == 0 || resolved.ContainsKey(key))
        {
            return;
        }

        if (!inFlight.Add(key))
        {
            return;
        }

        try
        {
            var user = await ResolveClient.ResolveUserLink(ProjectId!.Value, key);
            resolved[key] = new ResolveState(user, null);
        }
        catch (Exception exception)
        {
            resolved[key] = new ResolveState(
                null,
                string.IsNullOrWhiteSpace(exception.Message) ? "Пользователь не найден" : exception.Message);
        }
        finally
        {
            _ = inFlight.Remove(key);
        }

        StateHasChanged();
    }

    private List<string> RowsToRender
    {
        get
        {
            if (!Multiple)
            {
                return [Values.Count > 0 ? Values[0] : ""];
            }

            if (Values.Count == 0 || !string.IsNullOrEmpty(Values[^1]))
            {
                return [.. Values, ""];
            }

            return Values;
        }
    }

    private async Task OnRowChangedAsync(int index, string newValue)
    {
        if (!Multiple)
        {
            Values = string.IsNullOrEmpty(newValue) ? [] : [newValue];
        }
        else if (index == Values.Count)
        {
            if (!string.IsNullOrEmpty(newValue))
            {
                Values.Add(newValue);
            }
        }
        else
        {
            Values[index] = newValue;
            if (index == Values.Count - 1 && string.IsNullOrEmpty(newValue))
            {
                Values.RemoveAt(index);
            }
        }

        await NotifyChangedAsync();
        await ResolveIfNeededAsync(newValue);
    }

    private async Task OnRemoveRowAsync(int index)
    {
        Values.RemoveAt(index);
        await NotifyChangedAsync();
    }

    private async Task NotifyChangedAsync()
    {
        await ValuesChanged.InvokeAsync(Values);
        if (ValuesExpression is not null)
        {
            EditContext?.NotifyFieldChanged(fieldIdentifier);
        }
    }
}
