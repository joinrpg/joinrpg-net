<input type="number" id="@inputId" class="form-control" @onchange="UpdateValue" name="@Name" value="@Value" min="@Min" max="@Max"/>

  @code {
      [Parameter]
      public int? Value { get; set; }

      [Parameter]
      public EventCallback<int?> ValueChanged { get; set; }

      [Parameter]
      public string Name { get; set; } = null!;

      [Parameter]
      public int? Min { get; set; }

      [Parameter]
      public int? Max { get; set; }

      [CascadingParameter]
      private FormRowLabelTarget? LabelTarget { get; set; }

      private string? inputId;

      protected override void OnParametersSet() => inputId = LabelTarget?.Claim(this);

      private async Task UpdateValue(ChangeEventArgs eventArgs)
      {
        var value = eventArgs.Value?.ToString();
        // Браузер пропускает в type=number дроби, экспоненту и числа больше int —
        // их считаем пустым значением, а не роняем обработчик
        await ValueChanged.InvokeAsync(
            int.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var parsed)
                ? parsed
                : null);
      }
    }
