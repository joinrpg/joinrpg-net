@typeparam TViewModel where TViewModel: class
@using JoinRpg.Common.WebComponents.Dialog

@if (editContext is not null)
{

    <JoinDialog @ref="dialogRef"
                Buttons="@buttons"
                Caption="@Caption"
                DisableSumbit="formInvalid"
                MaxWidth="@MaxWidth"
                Width="@Width"
                Height="@Height"
                MaxHeight="@MaxHeight"
    >
        <EditForm FormName="@FormName" EditContext="@editContext">
            <DataAnnotationsValidator />
            <FormHorizontal>
              @ChildContent
            </FormHorizontal>
        </EditForm>
    </JoinDialog>

}
@code
{
    [Parameter]
    public string? Caption { get; set; }

    [Parameter]
    [EditorRequired]
    public string FormName { get; set; }

    [Parameter]
    [EditorRequired]
    public ButtonPreset SubmitButtonPreset { get; set; }

    [EditorRequired]
    [Parameter]
    public TViewModel Model { get; set; } = null!;

    [Parameter]
    public string? Width { get; set; } = "700px";

    [Parameter]
    public string? MaxWidth { get; set; } = "80%";

    [Parameter]
    public string? MaxHeight { get; set; }

    [Parameter]
    public string? Height { get; set; }

    /// <summary>
    /// Тело формы
    /// </summary>
    [Parameter]
    public required RenderFragment ChildContent { get; set; }

    private JoinDialog dialogRef = default!;
    private EditContext? editContext;
    private bool contextIsStale;
    private bool formInvalid;

    private IReadOnlyCollection<DialogButton> buttons = null!;

    public async Task<TViewModel?> ShowModalAsync()
    {
        var result = await dialogRef.ShowBoolModalAsync();
        // Следующий показ начнётся с чистого EditContext (без сообщений прошлого раза). Обнулять
        // его прямо здесь нельзя: закрытие диалога перерисовывает JoinDialog, тот рисует наше
        // содержимое, и EditForm получил бы null — падение рендера.
        contextIsStale = true;
        if (result)
        {
            return Model;
        }
        return null;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        formInvalid = !IsModelValid();
        StateHasChanged();
    }

    // Валидность считаем по самой модели, а не через editContext.Validate(): тот показал бы
    // ошибки сразу у всех полей, включая ещё не тронутые. Сообщения у полей выводит
    // DataAnnotationsValidator по мере их изменения.
    private bool IsModelValid()
        => System.ComponentModel.DataAnnotations.Validator.TryValidateObject(
            Model,
            new System.ComponentModel.DataAnnotations.ValidationContext(Model),
            validationResults: null,
            validateAllProperties: true);

    protected override Task OnParametersSetAsync()
    {
        buttons = [new DialogButton(SubmitButtonPreset), new DialogButton(ButtonPreset.Cancel, cancel: true)];
        // Новый EditContext заставляет EditForm пересоздать всё содержимое: поле, в которое
        // сейчас вводят, теряет фокус. Поэтому пересоздаём только при смене модели.
        if (editContext is null || contextIsStale || !ReferenceEquals(editContext.Model, Model))
        {
            contextIsStale = false;
            if (editContext is not null)
            {
                editContext.OnFieldChanged -= HandleFieldChanged;
            }
            editContext = new(Model);
            editContext.OnFieldChanged += HandleFieldChanged;
        }
        // Пересчитываем на каждую перерисовку родителя: не все поля (например, JoinRpgDatePicker)
        // сообщают EditContext об изменениях, а перерисовку родителя @bind вызывает всегда
        formInvalid = !IsModelValid();
        return base.OnParametersSetAsync();
    }
}
