<li>
    <a href="@Href">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @if (Icon is not null)
            {
                <JoinIcon Icon="@Icon.Value" />
                @Space
            }
            @Label
        }
    </a>
</li>

@code {
    // Статическую разметку из одних пробелов (включая <text> </text>) Blazor вырезает
    // (#5324), поэтому пробел в разметке задаётся выражением.
    private const string Space = " ";

    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public JoinIconType? Icon { get; set; }
}
