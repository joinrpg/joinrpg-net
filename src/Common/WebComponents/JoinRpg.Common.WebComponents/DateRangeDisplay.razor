@{

    var startWeekDay = Start.ToString("dddd");
    var rangeWeekDay = Start.ToString("dddd") + "—" + End.ToString("dddd");

    if (Start.Year != End.Year)
    {
         <Tooltip Title="@rangeWeekDay">
            <text>@DateRangeFormatter.Format(Start, End, HideCurrentYear)</text>
        </Tooltip>
        return;
    }
    if (Start.Month == End.Month && Start.Day == End.Day)
    {
        <Tooltip Title="@startWeekDay">
            @DateRangeFormatter.Format(Start, End, HideCurrentYear)
        </Tooltip>
    }
    else
    {
        <Tooltip Title="@rangeWeekDay">
            <text>@DateRangeFormatter.Format(Start, End, HideCurrentYear)</text>
        </Tooltip>
    }
}

@code {
    [Parameter]
    [EditorRequired]
    public DateOnly Start { get; set; }

    [Parameter]
    [EditorRequired]
    public DateOnly End { get; set; }

    [Parameter]
    public bool HideCurrentYear { get; set; } = false;

}
