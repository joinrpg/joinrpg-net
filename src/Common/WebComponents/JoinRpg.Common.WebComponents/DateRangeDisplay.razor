@{
    var range = new DateRange(Start, End);
    var display = DateRangeFormatter.FormatDisplay(range, hideCurrentYear: HideCurrentYear);
    var tooltip = DateRangeFormatter.FormatTooltip(range);
}

<Tooltip Title="@tooltip">
    <text>@display</text>
</Tooltip>

@code {
    [Parameter]
    [EditorRequired]
    public DateOnly Start { get; set; }

    [Parameter]
    [EditorRequired]
    public DateOnly End { get; set; }

    [Parameter]
    public bool HideCurrentYear { get; set; } = false;

}
