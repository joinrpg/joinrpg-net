@typeparam TValue where TValue:struct, Enum
@inject ILogger<EnumRadioButtonGroup<TValue>> logger
@foreach (var enumValue in Values ?? Enum.GetValues<TValue>())
{
    <div>
        <label>
            <input type="radio" value="@enumValue" checked="@(enumValue.Equals(SelectedValue))" @onchange="UpdateSelected" name="@name" />
            &nbsp;@enumValue.GetDisplayName()
        </label>
        @if (enumValue.GetDescription() is string description)
        {
            <div class="help-block">@description</div>
        }
    </div>
}

@code {
    private FieldIdentifier? fieldIdentifier;
    private string? name;

    [CascadingParameter]
    public EditContext? EditContext { get; set; } = default!;
    [Parameter]
    public TValue SelectedValue { get; set; } = default(TValue)!;

    [Parameter]
    public EventCallback<TValue> SelectedValueChanged { get; set; }


    [Parameter]
    public System.Linq.Expressions.Expression<Func<TValue>>? SelectedValueExpression { get; set; }

    [Parameter]
    public string Name { get; set; } = null!;

    /// <summary>
    /// Какие значения показывать; <c>null</c> — все значения enum. Порядок списка сохраняется.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TValue>? Values { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // Override зашиплен в публичном API пакета; состояние полностью выставляется в OnParametersSet.
        if (SelectedValueExpression is not null)
        {
            logger.LogTrace("FieldName = {fieldName}", FieldIdentifier.Create(SelectedValueExpression).FieldName);
        }
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // Как в CharacterGroupSelector: пересоздаём при каждом вызове — модель формы может быть заменена.
        fieldIdentifier = SelectedValueExpression is not null ? FieldIdentifier.Create(SelectedValueExpression) : null;
        name = Name ?? fieldIdentifier?.FieldName;
    }

    private async Task UpdateSelected(ChangeEventArgs eventArgs)
    {
        await SelectedValueChanged.InvokeAsync(Enum.Parse<TValue>(eventArgs.Value!.ToString ()!));
        if (EditContext is not null && fieldIdentifier is not null)
        {
            EditContext.NotifyFieldChanged(fieldIdentifier.Value);
        }
    }
}
