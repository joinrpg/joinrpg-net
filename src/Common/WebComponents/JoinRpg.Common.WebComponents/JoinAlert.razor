<div class="@style">
    @if (Icon is { } icon)
    {
        <JoinIcon Icon="icon" />
        <div>@ChildContent</div>
    }
    else
    {
        @ChildContent
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public VariationStyleEnum? Variation { get; set; } = VariationStyleEnum.None;

    /// <summary>
    /// Иконка слева от текста. С ней алерт получает раскладку <c>.join.alert</c>: иконка и текст
    /// в строку, иконка крупнее текста.
    /// </summary>
    [Parameter] public JoinIconType? Icon { get; set; }

    private string style => Icon is null
        ? BootstrapStyle.Build("alert", Variation, null)
        : "join " + BootstrapStyle.Build("alert", Variation, null);
}
