@*
    Форма с «правильным» поведением полей: каскадирует область имён (см. InputNameScope),
    поэтому поля ввода с производным именем рендерят name с префиксом FormName
    (например, name="AddPaymentType.Name" вместо name="Name") — браузерное автодополнение
    перестаёт предлагать имя пользователя в нерелевантных полях.

    Содержимое гейтится JoinInteractiveGate: префиксные имена безопасны только когда форма
    не постится нативно — пререндеренная форма с ними сломала бы биндинг. Поэтому форма
    показывается только при работающей Blazor-интерактивности, как уже принято у CreateProjectPanel.
*@
<JoinInteractiveGate Message="@GateMessage">
    <EditForm FormName="@FormName" Model="@Model" EditContext="@EditContext"
              OnSubmit="@OnSubmit" OnValidSubmit="@OnValidSubmit" OnInvalidSubmit="@OnInvalidSubmit"
              @attributes="AdditionalAttributes">
        <CascadingValue Value="inputNameScope" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </EditForm>
</JoinInteractiveGate>

@code {
    /// <summary>Имя формы. Используется и EditForm'ом, и как префикс имён полей ввода.</summary>
    [Parameter, EditorRequired]
    public string FormName { get; set; } = null!;

    [Parameter]
    public object? Model { get; set; }

    [Parameter]
    public EditContext? EditContext { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public EventCallback<EditContext> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    /// <summary>Текст заглушки на время пререндера. null — стандартный текст загрузки.</summary>
    [Parameter]
    public string? GateMessage { get; set; }

    /// <summary>Содержимое формы.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private InputNameScope inputNameScope = null!;

    protected override void OnParametersSet() => inputNameScope = new(FormName);
}
