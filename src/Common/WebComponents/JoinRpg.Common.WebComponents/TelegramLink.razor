@{
    var effectiveLink = Link ?? Contact?.PrettyName?.Value;
}
@if (!string.IsNullOrWhiteSpace(effectiveLink))
{
    <ContactLink Icon="JoinIconType.Telegram" Href="@($"https://t.me/{effectiveLink}")" Collapse="Collapse" Title="Telegram">
        @if (ChildContent is null)
        {
            @effectiveLink
        }
        else
        {
            @ChildContent
        }
    </ContactLink>
    @if (!Collapse && Contact is not null && !Contact.IsVerified)
    {
        <JoinIcon Icon="JoinIconType.Info" Title="Telegram не подтвержден" />
    }
}

@code {
    [Parameter] public TelegramSocialLink? Contact { get; set; }
    [Parameter] public string? Link { get; set; }
    [Parameter] public bool Collapse { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
