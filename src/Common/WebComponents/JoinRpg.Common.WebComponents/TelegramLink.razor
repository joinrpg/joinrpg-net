@{
    var effectiveLink = Link ?? Contact?.PrettyName?.Value;
}
@if (!string.IsNullOrWhiteSpace(effectiveLink))
{
    if (Collapse)
    {
        <a href="@($"https://t.me/{effectiveLink}")"><JoinIcon Icon="JoinIconType.Telegram" /></a>
    }
    else
    {
        <ContactLink Icon="JoinIconType.Telegram" Href="@($"https://t.me/{effectiveLink}")">
            @if (ChildContent is null)
            {
                @effectiveLink
            }
            else
            {
                @ChildContent
            }
        </ContactLink>
    }
}

@code {
    [Parameter] public TelegramSocialLink? Contact { get; set; }
    [Parameter] public string? Link { get; set; }
    [Parameter] public bool Collapse { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
