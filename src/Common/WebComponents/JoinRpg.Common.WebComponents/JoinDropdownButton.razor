@*
    Кнопка с выпадающим меню на нативном <details>: открывает браузер, без JS Bootstrap, поэтому работает
    и в статическом рендере. Рядом с JoinButton в JoinButtonGroup даёт «кнопку с выпадашкой»: основное
    действие — кнопкой, остальные — в меню. Пункты меню — JoinMenuItem.

    Закрытие по клику мимо и по Esc — делегированный слушатель в JoinRpg.Common.WebComponents.lib.module.js;
    без него меню закрывается повторным кликом по кнопке.
*@
<details class="join-dropdown @(Split ? "join-dropdown--split" : "")">
    <summary class="join-dropdown__toggle @JoinButtonStyle.Build(Style, Size ?? GroupSize)" aria-label="@AriaLabel" title="@AriaLabel">
        @if (ToggleContent is not null)
        {
            @ToggleContent
        }
        else
        {
            @if (Label is not null)
            {
                <span class="join-dropdown__label">@Label</span>
            }
            <span class="join-dropdown__caret"></span>
        }
    </summary>
    <ul class="join-dropdown__menu @(AlignRight ? "join-dropdown__menu--right" : "")">
        @ChildContent
    </ul>
</details>

@code {
    /// <summary>Пункты меню — <see cref="JoinMenuItem"/>.</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;

    /// <summary>Текст на кнопке. Без него — только стрелка (тогда обязательно задайте <see cref="AriaLabel"/>).</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Содержимое кнопки вместо <see cref="Label"/> и стрелки — например, одна иконка.</summary>
    [Parameter] public RenderFragment? ToggleContent { get; set; }

    /// <summary>Вариант кнопки — та же шкала, что у <see cref="JoinButton"/>.</summary>
    [Parameter] public VariationStyleEnum? Style { get; set; }

    /// <summary>Размер кнопки — та же шкала, что у <see cref="JoinButton"/>.</summary>
    [Parameter] public SizeStyleEnum? Size { get; set; }

    /// <summary>
    /// Размер, заданный окружающей <see cref="JoinButtonGroup"/>. Используется, если у кнопки нет своего <see cref="Size"/>.
    /// </summary>
    [CascadingParameter(Name = JoinButtonGroup.GroupSizeCascadeName)]
    public SizeStyleEnum? GroupSize { get; set; }

    /// <summary>Что за меню — для скринридера и подсказки, когда на кнопке одна стрелка.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Прижать меню к правому краю кнопки — когда кнопка у правого края страницы.</summary>
    [Parameter] public bool AlignRight { get; set; }

    /// <summary>
    /// Половина «разделённой кнопки» (split button): меню выпадает не из стрелки, а из всей
    /// <see cref="JoinButtonGroup"/>, в которой лежит кнопка, — выровненное по её левому краю
    /// (или по правому с <see cref="AlignRight"/>) и не уже неё. Поэтому основную кнопку и эту кладут
    /// в отдельную группу — вложенную, если рядом есть другие кнопки.
    /// </summary>
    [Parameter] public bool Split { get; set; }
}
