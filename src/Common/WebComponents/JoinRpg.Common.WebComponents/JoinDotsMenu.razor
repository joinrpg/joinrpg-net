@*
    Кнопка-«три точки» с меню действий: JoinDropdownButton с иконкой вместо подписи. Открывается
    браузером (нативный <details>), JS Bootstrap не нужен. Пункты меню — JoinMenuItem, заголовок —
    JoinMenuHeader. Имя и подсказка кнопки — «действия», потому что на ней одна иконка.
*@
<JoinDropdownButton Size="Size" AriaLabel="действия">
    <ToggleContent>
        <JoinIcon Icon="JoinIconType.MenuVertical" />
    </ToggleContent>
    <ChildContent>@ChildContent</ChildContent>
</JoinDropdownButton>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;

    /// <summary>
    /// Размер кнопки — та же шкала, что у <see cref="JoinButton"/>, чтобы меню
    /// совпадало по высоте с кнопками рядом.
    /// </summary>
    [Parameter] public SizeStyleEnum Size { get; set; } = SizeStyleEnum.Small;
}
