@if (Contact is not null)
{
    <ContactLink Icon="JoinIconType.Email" Href="@($"mailto:{Contact.Value}")" Collapse="Collapse" Title="@Contact.Value">@Contact.Value.Trim()</ContactLink>
}

@code {
    [Parameter]
    public Email? Contact { get; set; }

    [Parameter]
    public bool Collapse { get; set; }
}
