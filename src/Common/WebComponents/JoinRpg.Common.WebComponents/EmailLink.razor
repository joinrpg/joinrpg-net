@if (Contact is not null)
{
    if (Collapse)
    {
        <a href="@($"mailto:{Contact.Value}")" title="@Contact.Value"><JoinIcon Icon="JoinIconType.Email" /></a>
    }
    else
    {
        <ContactLink Icon="JoinIconType.Email" Href="@($"mailto:{Contact.Value}")">@Contact.Value.Trim()</ContactLink>
    }
}

@code {
    [Parameter]
    public Email? Contact { get; set; }

    [Parameter]
    public bool Collapse { get; set; }
}
