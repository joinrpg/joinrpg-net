@using JoinRpg.Common.WebComponents.Dialog
@typeparam TItem where TItem : class, IMoveableListItem
@inject IMoveClient MoveClient
@inject NavigationManager NavigationManager
@inject ILogger<JoinMoveControl<TItem>> Logger

 <JoinButtonGroup SkipGroup="SkipGroup">
        @if (showUp)
        {
            <JoinButton Preset="ButtonPreset.Up"
                        Size="Size"
                        Title="Переместить вверх"
                        OnClick="MoveUpAsync" />
        }
        @if (showDown)
        {
            <JoinButton Preset="ButtonPreset.Down"
                        Size="Size"
                        Title="Переместить вниз"
                        OnClick="MoveDownAsync" />
        }
        @if (showSort)
        {
            <JoinButton Preset="ButtonPreset.Sort"
                        Size="Size"
                        Title="Переместить в любую позицию"
                        Label=""
                        ProgressLabel=""
                        OnClick="OpenSortDialogAsync" />
        }
</JoinButtonGroup>

<JoinDialog @ref="_sortDialog"
            Caption="Переместить"
            Buttons="SortDialogButtons"
            MinWidth="22em"
            MinHeight="30em">
    <ChildContent>
        <label class="control-label">Поместить после</label>
        <TypedSelector TKey="string" TItem="TItem"
                       Items="selectorItems"
                       KeySelector="@(i => i.Id)"
                       ToListItem="@(i => TypedSelectList.CreateItem(Value: i.Id, Text: i.DisplayText, Subtext: i.Subtext))"
                       SelectedValues="@(_selectedTarget is null ? [] : [_selectedTarget])"
                       SelectedValuesChanged="v => _selectedTarget = v.FirstOrDefault()"
                       AllowEmpty="true"
                       EmptyText="Поставить в начало" />
    </ChildContent>
</JoinDialog>

@* Контрол стоит в каждой строке сетки ролей — диалог ошибки рендерим, только когда она случилась *@
@if (_error is not null)
{
    <JoinMessageDialog @ref="_errorDialog" Type="MessageDialogType.Fail">@_error</JoinMessageDialog>
}

@code {
    [Parameter, EditorRequired]
    public IList<TItem> Items { get; set; } = null!;

    [Parameter, EditorRequired]
    public TItem Self { get; set; } = null!;

    [Parameter]
    public EventCallback OnMoveCompleted { get; set; }

    [Parameter]
    public bool SkipGroup { get; set; } = false;

    [Parameter]
    public bool AutoRefresh { get; set; } = false;

    /// <summary>
    /// Размер кнопок. Если не задан — размер группы, в которой стоят кнопки: собственной или,
    /// при <see cref="SkipGroup"/>, окружающей <see cref="JoinButtonGroup"/>; вне группы обычный.
    /// </summary>
    [Parameter]
    public SizeStyleEnum? Size { get; set; }

    private bool showUp, showDown, showSort;
    private TItem? targetIfUp, targetIfDown;
    private TItem[] selectorItems = [];
    private string? _selectedTarget;
    private JoinDialog? _sortDialog;
    private JoinMessageDialog? _errorDialog;
    private string? _error;
    private bool _showErrorPending;

    private static readonly IReadOnlyCollection<DialogButton> SortDialogButtons =
    [
        new DialogButton(ButtonPreset.Sort),
        new DialogButton(ButtonPreset.Cancel, cancel: true),
    ];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        var selfId = Self.Id;
        var idx = -1;
        for (var i = 0; i < Items.Count; i++)
        {
            if (Items[i].Id == selfId) { idx = i; break; }
        }

        if (idx == -1)
            throw new InvalidOperationException("Self не найден в Items");

        showUp = idx > 0;
        showDown = idx < Items.Count - 1;
        showSort = Items.Count > 1;
        targetIfUp = idx > 1 ? Items[idx - 2] : null;
        targetIfDown = idx < Items.Count - 1 ? Items[idx + 1] : null;
        _selectedTarget = null;

        selectorItems = [.. Items.Where(i => i.Id != selfId)];
    }

    private async Task MoveUpAsync(ButtonClickEventArgs args)
    {
        try { await ExecuteMoveAsync(targetIfUp?.Id); }
        finally { args.ExitProgressState = true; }
    }

    private async Task MoveDownAsync(ButtonClickEventArgs args)
    {
        try { await ExecuteMoveAsync(targetIfDown?.Id); }
        finally { args.ExitProgressState = true; }
    }

    private async Task OpenSortDialogAsync(ButtonClickEventArgs args)
    {
        try
        {
            var result = await _sortDialog!.ShowModalAsync();
            if (result == nameof(ButtonPreset.Sort))
            {
                await ExecuteMoveAsync(_selectedTarget);
            }
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Диалог появляется в разметке только с ошибкой — открыть его можно после отрисовки
        if (_showErrorPending && _errorDialog is not null)
        {
            _showErrorPending = false;
            _ = _errorDialog.ShowModalAsync();
        }
    }

    private void ShowError(string text)
    {
        _error = text;
        _showErrorPending = true;
        StateHasChanged();
    }

    private async Task ExecuteMoveAsync(string? moveAfterIdStr)
    {
        string[] newOrder;
        try
        {
            newOrder = await MoveClient.MoveAfterAsync(Self.Id, Self.ParentId, moveAfterIdStr);
        }
        catch (ServerProblemException exception)
        {
            // Отказ сервера (проект заблокирован, нет прав) — причину показываем как есть
            ShowError(exception.Message);
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка при перемещении {SelfId}", Self.Id);
            ShowError("Не удалось переместить — попробуйте обновить страницу");
            return;
        }
        ReorderItems(newOrder);
        if (OnMoveCompleted.HasDelegate)
            await OnMoveCompleted.InvokeAsync();
        if (AutoRefresh)
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private void ReorderItems(string[] newOrder)
    {
        var lookup = Items.ToDictionary(i => i.Id);
        var pos = 0;
        foreach (var idStr in newOrder.Where(lookup.ContainsKey))
            Items[pos++] = lookup[idStr];
    }
}
