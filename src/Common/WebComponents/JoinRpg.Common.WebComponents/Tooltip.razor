@if(string.IsNullOrWhiteSpace(Title) && TooltipContent is null)
{
    @ChildContent@Text
    return;
}

<span class="join-tooltip-container">
    <span>
        @ChildContent@Text
    </span>
    <span class="join-tooltip">
        @if (TooltipContent is not null)
        {
            @TooltipContent
        }
        else
        {
            @Title
        }
    </span>
</span>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? TooltipContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Текст, к которому показываем подсказку — альтернатива <see cref="ChildContent"/> для MVC-разметки,
    /// где тег-хелпер &lt;component&gt; не умеет передавать вложенное содержимое.
    /// </summary>
    [Parameter]
    public string? Text { get; set; }
}

