@*
    Подсказка по наведению. Рисуется через Popover API — браузер выносит её в top layer,
    поэтому подсказку не обрезают предки с overflow: hidden (шапка сетки расписания и т. п.).

    Показом, скрытием и координатами занимается скрипт wwwroot/JoinRpg.Common.WebComponents.lib.module.js:
    это JS-инициализатор Blazor, его подключает сам фреймворк при старте интерактивного рантайма,
    а для страниц Portal из одних статических компонентов — ещё и тег в layout'е.
*@
@if(string.IsNullOrWhiteSpace(Title) && TooltipContent is null)
{
    @ChildContent
    return;
}

<span class="join-tooltip-container" data-join-tooltip-placement="@PlacementAttribute">
    <span>
        @ChildContent
    </span>
    <span class="join-tooltip" popover="manual" role="tooltip">
        @if (TooltipContent is not null)
        {
            @TooltipContent
        }
        else
        {
            @Title
        }
    </span>
</span>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public RenderFragment? TooltipContent { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>С какой стороны от цели показывать подсказку. По умолчанию — снизу.</summary>
    [Parameter]
    public TooltipPlacement Placement { get; set; } = TooltipPlacement.Bottom;

    private string PlacementAttribute => Placement switch
    {
        TooltipPlacement.Top => "top",
        TooltipPlacement.Left => "left",
        TooltipPlacement.Right => "right",
        _ => "bottom",
    };
}
