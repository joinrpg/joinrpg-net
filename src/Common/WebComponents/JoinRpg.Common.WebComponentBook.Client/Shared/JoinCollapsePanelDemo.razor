<h3>JoinCollapsePanel</h3>

<h4>Аккордеон</h4>
<p>
    Панели внутри <code>JoinCollapsePanelGroup</code>: открыта не больше одной. Сворачивает клик по
    <code>Header</code>; ссылки и кнопки заголовка кладутся в <code>HeaderExtra</code> — они видны всегда
    и панель не сворачивают.
</p>
<JoinCollapsePanelGroup>
    <JoinCollapsePanel Open="true">
        <Header><b>Первая</b> — открыта сразу</Header>
        <ChildContent>Содержимое первой панели.</ChildContent>
    </JoinCollapsePanel>
    <JoinCollapsePanel>
        <Header><b>Вторая</b></Header>
        <HeaderExtra>— <a href="https://joinrpg.ru" target="_blank">ссылка в заголовке</a></HeaderExtra>
        <ChildContent>Содержимое второй панели.</ChildContent>
    </JoinCollapsePanel>
    <JoinCollapsePanel>
        <Header><b>Третья</b></Header>
        <ChildContent>Содержимое третьей панели.</ChildContent>
    </JoinCollapsePanel>
</JoinCollapsePanelGroup>

<h4>Независимые панели и варианты</h4>
@foreach (var variation in new VariationStyleEnum?[] { null, VariationStyleEnum.Info, VariationStyleEnum.Warning })
{
    <JoinCollapsePanel Variation="@variation">
        <Header>Variation = @(variation?.ToString() ?? "null")</Header>
        <ChildContent>Разделитель заголовка и тела — цвета рамки панели.</ChildContent>
    </JoinCollapsePanel>
}
