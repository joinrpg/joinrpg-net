@* Рисуется статически: фильтр — обычная GET-форма, параметры приходят из адреса страницы. *@
@preservewhitespace true
@inject INotificationLogClient Client
@inject ILogger<NotificationLog> logger

@if (isError)
{
    <JoinErrorMessage />
    return;
}

@if (log is null)
{
    <JoinLoadingMessage />
    return;
}

<form method="get" class="form-inline" style="margin-bottom: 15px">
    @if (log.RecipientId is not null)
    {
        <input type="hidden" name="userId" value="@log.RecipientId.Value" />
        <span class="form-control-static" style="margin-right: 15px">
            Получатель: <UserLink Model="log.Recipient!" /> (id @log.RecipientId.Value)
            <a href="@NotificationLogUrl.For(recipient: null, log.Channel)">[сбросить]</a>
        </span>
    }
    <div class="form-group">
        <label for="notification-log-channel">Канал</label>
        <select id="notification-log-channel" name="channel" class="form-control">
            <option value="" selected="@(log.Channel is null)">Все</option>
            @foreach (var channel in Enum.GetValues<NotificationChannel>())
            {
                <option value="@channel" selected="@(log.Channel == channel)"><NotificationChannelName Channel="channel" /></option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-default">Показать</button>
</form>

<p class="text-muted">Последние @log.Limit уведомлений, новые сверху. Время — UTC.</p>

@if (log.Items.Count == 0)
{
    <p>Уведомлений нет.</p>
    return;
}

@foreach (var item in log.Items)
{
    <JoinCollapsePanel>
        <Header>@item.Header</Header>
        <HeaderExtra>
            <div>
                @item.CreatedAt.ToUniversalTime().ToString("dd.MM.yyyy HH:mm:ss")
                · кому: <UserLink Model="item.Recipient" />
                @if (log.RecipientId is null)
                {
                    <text>(<a href="@NotificationLogUrl.For(item.RecipientId, log.Channel)">все уведомления</a>)</text>
                }
                · от: <UserLink Model="item.Initiator" />
                · #@item.Id.Value
            </div>
            <div>
                @foreach (var delivery in item.Channels)
                {
                    <span style="margin-right: 10px; display: inline-block">
                        <NotificationChannelName Channel="delivery.Channel" />:
                        <NotificationStatusBadge Status="delivery.Status" />
                        @if (delivery.Address != "")
                        {
                            <code>@delivery.Address</code>
                        }
                        @if (delivery.Attempts > 0)
                        {
                            <span class="text-muted">попыток: @delivery.Attempts</span>
                        }
                        @if (delivery.Status == NotificationMessageStatus.Queued && delivery.Attempts > 0)
                        {
                            <span class="text-muted">следующая после @delivery.SendAfter.ToUniversalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                        }
                    </span>
                }
            </div>
        </HeaderExtra>
        <ChildContent>@((MarkupString)item.BodyHtml)</ChildContent>
    </JoinCollapsePanel>
}

@code {
    [Parameter]
    public UserIdentification? Recipient { get; set; }

    [Parameter]
    public NotificationChannel? Channel { get; set; }

    private bool isError;
    private NotificationLogViewModel? log;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            log = await Client.GetLog(Recipient, Channel);
        }
        catch (Exception ex)
        {
            isError = true;
            logger.LogError(ex, "Ошибка при загрузке лога уведомлений");
        }
    }
}
