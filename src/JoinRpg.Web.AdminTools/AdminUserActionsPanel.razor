@using System.ComponentModel.DataAnnotations
@using JoinRpg.Common.WebComponents.Dialog
@using JoinRpg.Web.AdminTools.Notifications
@inject IUserAdminClient UserAdminClient
@inject NavigationManager NavigationManager
@inject ILogger<AdminUserActionsPanel> Logger

@if (isError)
{
    <JoinErrorMessage />
    return;
}

@if (panel is null)
{
    <JoinLoadingMessage />
    return;
}

@if (actionError is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@actionError</JoinAlert>
}

<JoinButtonGroup Vertical="true">
    <a href="#" class="disabled btn btn-default">Функции администратора:</a>

    <JoinButton Label="Изменить email" OnClick="OpenChangeEmailDialogAsync" />

    <JoinButton
        Label="@(panel.IsAdmin ? "Убрать из администраторов" : "Сделать администратором")"
        AutoConfirm="true"
        AutoConfirmMessage="@(panel.IsAdmin ? "Действительно убрать права администратора на сайте?" : "Действительно выдать права администратора на сайте?")"
        OnClick="ToggleAdminAsync" />

    <JoinButton
        Label="@(panel.IsVerifiedUser ? "Отменить подтверждение профиля" : "Подтвердить профиль")"
        AutoConfirm="true"
        AutoConfirmMessage="@(panel.IsVerifiedUser ? "Убрать подтверждение действительности ФИО?" : "Вы действительно проверили ФИО и телефон пользователя?")"
        OnClick="ToggleVerificationAsync" />

    @if (panel.HasVkLink)
    {
        <JoinButton
            Label="Отвязать ВК"
            AutoConfirm="true"
            AutoConfirmMessage="Действительно отвязать ВК у этого пользователя?"
            Disabled="@panel.IsVkOnlyLoginMethod"
            DisabledTitle="Невозможно удалить единственный способ входа"
            OnClick="RemoveVkLinkAsync" />
    }

    <a href="#" class="disabled btn btn-default">
        Дата рождения: @(panel.BirthDate is null ? "не указана" : panel.BirthDate.Value.ToString("dd.MM.yyyy"))
    </a>

    <JoinButton Label="@(panel.BirthDate is null ? "Указать дату рождения" : "Изменить дату рождения")" OnClick="OpenBirthDateDialogAsync" />

    @if (panel.BirthDate is not null)
    {
        <JoinButton
            Label="Очистить дату рождения"
            AutoConfirm="true"
            AutoConfirmMessage="Действительно очистить дату рождения этого пользователя?"
            OnClick="ClearBirthDateAsync" />
    }

    <JoinButton Label="Логи" Title="Посмотреть логи действий пользователя на сайте" Link="@LogLink.AbsoluteUri" />

    <JoinButton Label="Уведомления" Title="Последние уведомления, отправленные пользователю" Link="@NotificationLogUrl.For(recipient: UserId)" />
</JoinButtonGroup>

<JoinFormDialog
    Caption="Изменение email"
    SubmitButtonPreset="ButtonPreset.Save"
    Model="@emailModel"
    FormName="ChangeEmailForm"
    @ref="changeEmailDialog"
>
    <FormRowFor For="@(() => emailModel.NewEmail)">
        <JoinTextInput @bind-Value="emailModel.NewEmail" />
    </FormRowFor>
</JoinFormDialog>

<JoinFormDialog
    Caption="Дата рождения"
    SubmitButtonPreset="ButtonPreset.Save"
    Model="@birthDateModel"
    FormName="BirthDateForm"
    @ref="birthDateDialog"
>
    <FormRowFor For="@(() => birthDateModel.Value)">
        <JoinRpgDatePicker Name="@nameof(birthDateModel.Value)" @bind-Value="birthDateModel.Value" Max="@DateOnly.FromDateTime(DateTime.Today)" />
    </FormRowFor>
</JoinFormDialog>

@code {
    [Parameter]
    [EditorRequired]
    public UserIdentification UserId { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public Uri LogLink { get; set; } = null!;

    private UserAdminPanelViewModel? panel;
    private bool isError;
    private string? actionError;

    private JoinFormDialog<ChangeEmailFormModel> changeEmailDialog = default!;
    private readonly ChangeEmailFormModel emailModel = new();

    private JoinFormDialog<BirthDateFormModel> birthDateDialog = default!;
    private readonly BirthDateFormModel birthDateModel = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            panel = await UserAdminClient.GetAdminPanel(UserId);
        }
        catch (Exception ex)
        {
            isError = true;
            Logger.LogError(ex, "Ошибка при загрузке панели администратора");
        }
    }

    private async Task OpenChangeEmailDialogAsync(ButtonClickEventArgs args)
    {
        try
        {
            var result = await changeEmailDialog.ShowModalAsync();
            if (result is not null)
            {
                await RunAsync(() => UserAdminClient.ChangeEmail(UserId, result.NewEmail), "Не удалось изменить email");
            }
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    private Task ToggleAdminAsync(ButtonClickEventArgs args)
        => RunAsync(() => UserAdminClient.SetAdminFlag(UserId, !panel!.IsAdmin), "Не удалось изменить права администратора", args);

    private Task ToggleVerificationAsync(ButtonClickEventArgs args)
        => RunAsync(() => UserAdminClient.SetVerificationFlag(UserId, !panel!.IsVerifiedUser), "Не удалось изменить подтверждение профиля", args);

    private Task RemoveVkLinkAsync(ButtonClickEventArgs args)
        => RunAsync(() => UserAdminClient.RemoveVkLink(UserId), "Не удалось отвязать ВК", args);

    private async Task OpenBirthDateDialogAsync(ButtonClickEventArgs args)
    {
        try
        {
            birthDateModel.Value = panel!.BirthDate;
            var result = await birthDateDialog.ShowModalAsync();
            if (result is not null)
            {
                await RunAsync(() => UserAdminClient.SetBirthDate(UserId, result.Value), "Не удалось изменить дату рождения");
            }
        }
        finally
        {
            args.ExitProgressState = true;
        }
    }

    private Task ClearBirthDateAsync(ButtonClickEventArgs args)
        => RunAsync(() => UserAdminClient.SetBirthDate(UserId, null), "Не удалось очистить дату рождения", args);

    /// <summary>
    /// Действие меняет данные на всей странице пользователя, поэтому после успеха перезагружаем её целиком.
    /// </summary>
    private async Task RunAsync(Func<Task> action, string failureText, ButtonClickEventArgs? args = null)
    {
        actionError = null;
        try
        {
            await action();
            NavigationManager.Refresh(forceReload: true);
        }
        catch (ServerProblemException ex)
        {
            // Например, нет прав или сессия истекла — причину показываем как есть
            actionError = $"{failureText}: {ex.Message}";
            ExitProgress(args);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка действия администратора над пользователем {UserId}", UserId.Value);
            actionError = failureText;
            ExitProgress(args);
        }
    }

    private static void ExitProgress(ButtonClickEventArgs? args)
    {
        if (args is not null)
        {
            args.ExitProgressState = true;
        }
    }

    public class ChangeEmailFormModel
    {
        [Required, EmailAddress, Display(Name = "Новый email")]
        public string NewEmail { get; set; } = "";
    }

    public class BirthDateFormModel
    {
        [Display(Name = "Дата рождения")]
        public DateOnly? Value { get; set; }
    }
}
