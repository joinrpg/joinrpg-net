<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Общий для всех DRP-инструментов (DrpConfiguration.UserSecretsId): строки подключения задаются один раз. -->
    <UserSecretsId>joinrpg-drp</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <!-- Прямой пин Pkcs — security-override транзитивной версии из SqlClient (изначально: 9.0.11, GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). Актуальность перепроверять при бампе SqlClient. -->
    <!-- В коде не используется, поэтому TreatAsUsed: иначе ReferenceTrimmer предлагает удалить (RT0003). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" TreatAsUsed="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Common\PrimitiveTypes\JoinRpg.Common.PrimitiveTypes\JoinRpg.Common.PrimitiveTypes.csproj" />
    <!-- GravatarHelper: аватарка по умолчанию та же, что при регистрации. -->
    <ProjectReference Include="..\JoinRpg.Domain\JoinRpg.Domain.csproj" />
    <ProjectReference Include="..\JoinRpg.Tools.Drp.Common\JoinRpg.Tools.Drp.Common.csproj" />
  </ItemGroup>
</Project>
