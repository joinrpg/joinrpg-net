<!DOCTYPE html>
@* TODO: not used yet, will be when we are start moving pages to Blazor.
   При переезде страниц сюда удалить скрипт старта Blazor (autostart/disableNoCacheFetch)
   из Views/Shared/_Layout.cshtml — иначе на одной странице будет два Blazor.start
   и второй бросит "Blazor has already started". *@
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["site.css"]" />
    <link rel="stylesheet" href="@Assets["JoinRpg.Portal.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/JoinRpg.Common.WebComponents/css/join-components.css"]" />


    <ImportMap />

    <script src="@Assets["jquery/jquery.min.js"]"></script>
    <script src="@Assets["twitter-bootstrap/js/bootstrap.min.js"]"></script>
</head>

<body>
    @* См. _Layout.cshtml: disableNoCacheFetch, #6234 *@
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            webAssembly: {
                configureRuntime: dotnet => dotnet.withConfig({ disableNoCacheFetch: true })
            }
        });
    </script>
</body>

</html>
