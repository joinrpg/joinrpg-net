@using JoinRpg.Blazor.Client.ApiClients
@using JoinRpg.DomainTypes.Finances
@using JoinRpg.Web.Finances.Expenses
@inject IExpensesClient Client
@inject NavigationManager NavigationManager
@inject ILogger<AddExpenseWidget> Logger

@* Кнопка «Новый расход» для страницы сводки: открывает диалог создания на месте.
   После сохранения — перезагрузка страницы (таблицы сводки статические);
   галочка «Продолжить добавлять расходы» открывает диалог заново с предзаполнением. *@
@if (loadError is not null)
{
    <JoinAlert Variation="VariationStyleEnum.Danger">@loadError</JoinAlert>
}
else
{
    @if (actionError is not null)
    {
        <JoinAlert Variation="VariationStyleEnum.Danger">@actionError</JoinAlert>
    }
    <JoinButton Preset="ButtonPreset.Add" Label="Новый расход" AutoProgress="false" OnClick="StartCreate" />
    <ExpenseEditDialog @ref="editDialog" ProjectId="ProjectId" CategorySuggestions="categorySuggestions" @bind-AddAnother="addAnother" />
}

@code {
    [Parameter, EditorRequired]
    public ProjectIdentification ProjectId { get; set; } = null!;

    private UserIdentification? currentUser;
    private IReadOnlyCollection<string>? categorySuggestions;
    private bool addAnother;
    private bool savedAny;
    private string? loadError;
    private string? actionError;
    private ExpenseEditDialog editDialog = null!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUserTask = Client.GetCurrentUser(ProjectId);
            var suggestionsTask = Client.GetCategoryPathSuggestions(ProjectId);
            await Task.WhenAll(currentUserTask, suggestionsTask);
            currentUser = currentUserTask.Result;
            categorySuggestions = suggestionsTask.Result;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка загрузки данных для создания расхода проекта {ProjectId}", ProjectId);
            loadError = "Не удалось загрузить данные для создания расхода. Обновите страницу и попробуйте ещё раз.";
        }
    }

    private async Task StartCreate()
    {
        actionError = null;
        savedAny = false;
        // Мастер по умолчанию — текущий пользователь; дата — сегодня
        var model = new ExpenseEditViewModel
        {
            MasterId = currentUser,
            SpentAt = DateOnly.FromDateTime(DateTime.Today),
        };
        while (true)
        {
            var result = await editDialog.ShowAsync(model, state: null);
            // Продолжение выполняется не из события виджета (диалог закрылся по onclose) —
            // публикуем результат сами: и actionError, и состояние виджета
            StateHasChanged();
            if (result is null)
            {
                if (savedAny)
                {
                    Reload();
                }
                return;
            }
            FillPlannedFromActual(result);
            var saved = await Save(result);
            StateHasChanged();
            if (saved)
            {
                savedAny = true;
                if (addAnother)
                {
                    // Предзаполнение следующего расхода: мастер, категория и дата повторяются,
                    // название/описание/суммы у каждой покупки свои (как на странице расходов)
                    model = new ExpenseEditViewModel
                    {
                        MasterId = result.MasterId,
                        CategoryPath = result.CategoryPath,
                        SpentAt = result.SpentAt,
                    };
                    continue;
                }
                Reload();
                return;
            }
            // Сохранение не удалось — открываем диалог заново с той же моделью:
            // введённые данные не должны пропадать
            model = result;
        }
    }

    // Факт ввели, а план пустой — подставляем план из факта. Страховка от потерянного
    // change-события; в живом диалоге то же делает ValueChanged полей факта.
    private static void FillPlannedFromActual(ExpenseEditViewModel model)
    {
        if (model.PlannedQuantity is null && model.ActualQuantity is > 0)
        {
            model.PlannedQuantity = model.ActualQuantity;
        }
        if (model.PlannedPrice is null && model.ActualPrice is > 0)
        {
            model.PlannedPrice = model.ActualPrice;
        }
    }

    private async Task<bool> Save(ExpenseEditViewModel model)
    {
        actionError = null;
        try
        {
            await Client.CreateExpense(ProjectId, model);
            return true;
        }
        catch (ServerProblemException exception)
        {
            // Ожидаемый отказ сервиса (нет прав) — текст предназначен мастеру
            actionError = $"Ошибка: {exception.Message}";
            return false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Ошибка сохранения расхода проекта {ProjectId}", ProjectId);
            actionError = "Не удалось сохранить расход. Обновите страницу и попробуйте ещё раз.";
            return false;
        }
    }

    private void Reload() => NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
}
