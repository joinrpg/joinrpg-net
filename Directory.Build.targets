<Project>
    <!--
    Импортируется после тела .csproj, поэтому здесь уже видно IsPackable, выставленный
    проектом. В Directory.Build.props так нельзя — там его ещё нет.
    -->
    <PropertyGroup Condition="'$(IsPackable)' != 'true'">
        <!--
        CS1573 («описан не каждый параметр») — правило «всё или ничего», навешенное на
        культуру «документируй то, что интересно» (CS1591 у нас уже в NoWarn). Описать один
        неочевидный параметр и промолчать про очевидные остальные оно запрещает, предлагая
        либо дописать шум, либо выкинуть полезный комментарий.

        Теряется только напоминание дописать <param> при добавлении параметра в полностью
        описанный метод; переименование параметра по-прежнему ловит CS1572.

        В пакетах правило остаётся: их <param> читают снаружи, из IntelliSense по пакету.
        -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
    </PropertyGroup>

    <!-- Общие метаданные NuGet-пакетов. Порядок публикации и документации — docs/nuget-packages.md. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true'">
        <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/joinrpg/joinrpg-net</PackageProjectUrl>
        <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/joinrpg/joinrpg-net</RepositoryUrl>
        <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
        <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
        <PackageReadmeFile Condition="'$(PackageReadmeFile)' == '' And Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Remove="README.md;CHANGELOG.md" />
        <None Include="README.md" Condition="Exists('$(MSBuildProjectDirectory)/README.md')" Pack="true" PackagePath="\" />
        <None Include="CHANGELOG.md" Condition="Exists('$(MSBuildProjectDirectory)/CHANGELOG.md')" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!--
    Учёт публичного API пакетов — docs/nuget-packages.md#публичный-api. RS0036/RS0037 — символ
    записан без nullable-аннотаций. RS0026/RS0027 (перегрузки с необязательными параметрами) —
    правила дизайна API, а не учёта; RS0041 даёт код без nullable-контекста: Razor-компоненты,
    миграции EF (`~` в Shipped). Генератор исключён: его типы никто не вызывает, компилятор только загружает.
    -->
    <!-- JoinPublicApiAsWarnings выставляет scripts/Update-PublicApi.ps1: иначе ошибка в одном пакете не даст собрать зависящие от него. -->
    <PropertyGroup Condition="'$(IsPackable)' == 'true' And '$(IsRoslynComponent)' != 'true' And '$(JoinPublicApiAsWarnings)' != 'true'">
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017;RS0036;RS0037</WarningsAsErrors>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IsPackable)' == 'true' And '$(IsRoslynComponent)' != 'true'">
        <NoWarn>$(NoWarn);RS0026;RS0027;RS0041</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="'$(IsPackable)' == 'true' And '$(IsRoslynComponent)' != 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
        <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    </ItemGroup>

    <!-- README пакета читают на nuget.org и агенты потребителя, пакет без него не собираем. -->
    <Target Name="JoinRequirePackageReadme" BeforeTargets="GenerateNuspec"
            Condition="'$(IsPackable)' == 'true' And !Exists('$(MSBuildProjectDirectory)/README.md')">
        <Error Text="У NuGet-пакета $(PackageId) нет README.md в каталоге проекта, см. docs/nuget-packages.md." />
    </Target>
</Project>
